{
  "name": "ArenaClash",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMinZoomDistance": 6,
        "CameraMaxZoomDistance": 12,
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 50,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    }
  }
}
