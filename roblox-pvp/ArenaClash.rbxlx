      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[-- Combat 100 % validé côté serveur : le client dit seulement « je frappe »,
-- le serveur vérifie le cooldown et calcule lui-même la hitbox.
local BadgeService = game:GetService("BadgeService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local DataService = require(script.Parent.DataService)

local CombatService = {}

local lastSwing = {} -- [Player] = os.clock()
local streaks = {} -- [Player] = number
local hitLog = setmetatable({}, { __mode = "k" }) -- [Humanoid] = { last, lastTime, weaponName, contributors }

local function awardBadge(player: Player, badgeId: number?)
	if not badgeId or badgeId == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, badgeId) then
				BadgeService:AwardBadge(player.UserId, badgeId)
			end
		end)
	end)
end

local function setStreak(player: Player, value: number)
	streaks[player] = value
	DataService.SetStat(player, "Série", value)
end

local function makeSound(id: string, parent: Instance, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.RollOffMaxDistance = 80
	sound.Parent = parent
	return sound
end

local function weldTo(base: BasePart, part: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
end

local function prepPart(part: BasePart)
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
end

-- Construit l'épée entièrement en code : aucun modèle à importer.
local function buildTool(weapon)
	local tool = Instance.new("Tool")
	tool.Name = weapon.Name
	tool.CanBeDropped = false
	tool.ToolTip = string.format("%d dégâts • %.2fs", weapon.Damage, weapon.Cooldown)
	tool.Grip = CFrame.new()
	tool:SetAttribute("WeaponId", weapon.Id)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 1, 0.3)
	handle.Color = Color3.fromRGB(40, 32, 28)
	handle.Material = Enum.Material.Fabric
	handle.CFrame = CFrame.new()
	prepPart(handle)
	handle.Parent = tool

	local guard = Instance.new("Part")
	guard.Name = "Guard"
	guard.Size = Vector3.new(0.4, 0.2, 1.3)
	guard.Color = if weapon.Glow then Color3.fromRGB(30, 30, 35) else Color3.fromRGB(90, 80, 60)
	guard.Material = Enum.Material.Metal
	guard.CFrame = CFrame.new(0, 0.6, 0)
	prepPart(guard)
	guard.Parent = tool
	weldTo(handle, guard)

	local blade = Instance.new("Part")
	blade.Name = "Blade"
	blade.Size = Vector3.new(0.15, weapon.Length, 0.5)
	blade.Color = weapon.Color
	blade.Material = weapon.Material
	blade.CFrame = CFrame.new(0, 0.7 + weapon.Length / 2, 0)
	prepPart(blade)
	blade.Parent = tool
	weldTo(handle, blade)

	if weapon.Glow then
		local light = Instance.new("PointLight")
		light.Color = weapon.Color
		light.Brightness = 2
		light.Range = 8
		light.Parent = blade
	end

	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -weapon.Length / 2, 0)
	bottom.Parent = blade
	local tip = Instance.new("Attachment")
	tip.Position = Vector3.new(0, weapon.Length / 2, 0)
	tip.Parent = blade

	local trail = Instance.new("Trail")
	trail.Attachment0 = bottom
	trail.Attachment1 = tip
	trail.Lifetime = 0.18
	trail.MinLength = 0.05
	trail.Color = ColorSequence.new(weapon.TrailColor or weapon.Color)
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail.LightEmission = if weapon.Glow then 1 else 0.3
	trail.Parent = blade

	makeSound(Config.Sounds.Slash, handle, 0.6).Name = "SlashSound"
	local unsheath = makeSound(Config.Sounds.Unsheath, handle, 0.5)
	tool.Equipped:Connect(function()
		unsheath:Play()
	end)

	return tool
end

function CombatService.GiveWeapon(player: Player)
	local data = DataService.Get(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not backpack then
		return
	end

	local weapon = Weapons.ById[data.Equipped]
	if not weapon or not data.Owned[weapon.Id] then
		weapon = Weapons.Default
	end

	local character = player.Character
	for _, container in { backpack, character } do
		if container then
			for _, item in container:GetChildren() do
				if item:IsA("Tool") and item:GetAttribute("WeaponId") then
					item:Destroy()
				end
			end
		end
	end

	local tool = buildTool(weapon)
	tool.Parent = backpack

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

local function damage(attacker: Player, victimHumanoid: Humanoid, weapon, fromPosition: Vector3)
	local victimCharacter = victimHumanoid.Parent
	if victimCharacter == attacker.Character or victimCharacter:FindFirstChildOfClass("ForceField") then
		return
	end

	local crit = math.random() < Config.CritChance
	local amount = math.floor(weapon.Damage * (if crit then Config.CritMultiplier else 1) + 0.5)

	-- On enregistre l'attaquant AVANT les dégâts : Died peut se déclencher immédiatement.
	local now = os.clock()
	local entry = hitLog[victimHumanoid]
	if not entry then
		entry = { contributors = {} }
		hitLog[victimHumanoid] = entry
	end
	entry.last = attacker
	entry.lastTime = now
	entry.weaponName = weapon.Name
	entry.contributors[attacker] = now

	victimHumanoid:TakeDamage(amount)

	local victimRoot = victimCharacter:FindFirstChild("HumanoidRootPart")
	if victimRoot then
		Remotes.HitConfirm:FireClient(attacker, victimRoot.Position + Vector3.new(0, 2.5, 0), amount, crit)
		local victimPlayer = Players:GetPlayerFromCharacter(victimCharacter)
		local direction = (victimRoot.Position - fromPosition) * Vector3.new(1, 0, 1)
		if victimPlayer and direction.Magnitude > 0.01 then
			Remotes.Knockback:FireClient(victimPlayer, direction.Unit)
		end
	end
end

local function onSwing(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end

	local tool = character:FindFirstChildOfClass("Tool")
	local weapon = tool and Weapons.ById[tool:GetAttribute("WeaponId")]
	if not weapon then
		return
	end

	-- Petite tolérance pour la latence réseau.
	local now = os.clock()
	if now - (lastSwing[player] or 0) < weapon.Cooldown * 0.85 then
		return
	end
	lastSwing[player] = now

	-- Attaquer retire la protection de spawn (anti-abus).
	local forceField = character:FindFirstChildOfClass("ForceField")
	if forceField then
		forceField:Destroy()
	end

	-- Animation de coup (gérée par le script Animate par défaut).
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local handle = tool:FindFirstChild("Handle")
	local slash = handle and handle:FindFirstChild("SlashSound")
	if slash then
		slash:Play()
	end

	local boxCFrame = root.CFrame * CFrame.new(0, 0, -weapon.Range / 2)
	local boxSize = Vector3.new(6, 7, weapon.Range + 1)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }

	local hit = {}
	local count = 0
	for _, part in workspace:GetPartBoundsInBox(boxCFrame, boxSize, params) do
		local model = part:FindFirstAncestorOfClass("Model")
		local victim = model and model:FindFirstChildOfClass("Humanoid")
		if victim and victim.Health > 0 and not hit[victim] then
			hit[victim] = true
			damage(player, victim, weapon, root.Position)
			count += 1
			if count >= Config.MaxTargetsPerSwing then
				break
			end
		end
	end
end

local function onDeath(victim: Player, humanoid: Humanoid)
	local entry = hitLog[humanoid]
	hitLog[humanoid] = nil

	local victimStreak = streaks[victim] or 0
	setStreak(victim, 0)
	DataService.Update(victim, function(data)
		data.Deaths += 1
	end)

	local now = os.clock()
	local killer = entry and entry.last
	if killer and (killer == victim or not killer.Parent or now - entry.lastTime > Config.KillCreditWindow) then
		killer = nil
	end

	if not killer then
		Remotes.KillFeed:FireAllClients(nil, victim.DisplayName, nil)
		return
	end

	local newStreak = (streaks[killer] or 0) + 1
	setStreak(killer, newStreak)

	local multiplier = if killer:GetAttribute("VIP") then Config.VipCoinMultiplier else 1
	local reward = (Config.CoinsPerKill + victimStreak * Config.StreakBountyPerKill) * multiplier
	local totalKills = 0
	DataService.Update(killer, function(data)
		data.Kills += 1
		data.Coins += reward
		data.BestStreak = math.max(data.BestStreak, newStreak)
		totalKills = data.Kills
	end)
	local levels = DataService.AddXp(killer, Config.XpPerKill)

	local killerHumanoid = killer.Character and killer.Character:FindFirstChildOfClass("Humanoid")
	if killerHumanoid and killerHumanoid.Health > 0 then
		killerHumanoid.Health = math.min(killerHumanoid.MaxHealth, killerHumanoid.Health + Config.HealOnKill)
	end

	Remotes.Toast:FireClient(killer, string.format("+%d 💰  Élimination de %s", reward, victim.DisplayName))
	Remotes.Announce:FireClient(victim, "💀 Éliminé par " .. killer.DisplayName, Config.Colors.Bad)
	Remotes.KillFeed:FireAllClients(killer.DisplayName, victim.DisplayName, entry.weaponName)

	if levels > 0 then
		local data = DataService.Get(killer)
		Remotes.Announce:FireClient(killer, "⭐ NIVEAU " .. data.Level .. " !", Config.Colors.Gold)
		if data.Level >= 10 then
			awardBadge(killer, Config.Badges.Level10)
		end
	end

	local message = Config.StreakMessages[newStreak]
	if message then
		Remotes.Announce:FireAllClients(string.format(message, killer.DisplayName), Config.Colors.Accent2)
	end
	if victimStreak >= 3 then
		Remotes.Announce:FireAllClients(
			string.format("%s a stoppé la série de %d de %s !", killer.DisplayName, victimStreak, victim.DisplayName),
			Config.Colors.Gold
		)
	end

	for helper, hitTime in entry.contributors do
		if helper ~= killer and helper ~= victim and helper.Parent and now - hitTime <= Config.AssistWindow then
			local helperReward = Config.AssistCoins * (if helper:GetAttribute("VIP") then Config.VipCoinMultiplier else 1)
			DataService.Update(helper, function(data)
				data.Coins += helperReward
			end)
			Remotes.Toast:FireClient(helper, string.format("+%d 💰  Assistance", helperReward))
		end
	end

	if totalKills == 1 then
		awardBadge(killer, Config.Badges.FirstKill)
	end
	if newStreak >= 10 then
		awardBadge(killer, Config.Badges.Streak10)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Once(function()
		onDeath(player, humanoid)
		task.delay(Config.RespawnTime, function()
			if player.Parent then
				player:LoadCharacter()
			end
		end)
	end)

	player:WaitForChild("Backpack", 5)
	CombatService.GiveWeapon(player)
end

function CombatService.SetupPlayer(player: Player)
	setStreak(player, 0)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player:LoadCharacter()
end

function CombatService.Init()
	Remotes.Swing.OnServerEvent:Connect(onSwing)
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		streaks[player] = nil
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Chargement / sauvegarde des données joueurs + leaderstats + VIP.
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = {}

local profiles = {} -- [Player] = data
local noSave = {} -- [Player] = true quand le chargement a échoué en Studio

local function getStore(name: string, ordered: boolean)
	local ok, store = pcall(function()
		if ordered then
			return DataStoreService:GetOrderedDataStore(name)
		end
		return DataStoreService:GetDataStore(name)
	end)
	if not ok then
		warn("[DataService] DataStore indisponible (" .. name .. ") : " .. tostring(store))
		return nil
	end
	return store
end

local store = getStore(Config.DataStoreName, false)
local killsStore = getStore(Config.LeaderboardStoreName, true)

local function defaultData()
	return {
		Coins = Config.StartingCoins,
		Kills = 0,
		Deaths = 0,
		Xp = 0,
		Level = 1,
		BestStreak = 0,
		Owned = { Wooden = true },
		Equipped = "Wooden",
		LastDaily = 0,
		DailyStreak = 0,
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

-- En Studio on n'insiste pas : une place non publiée n'a jamais accès aux DataStores.
local MAX_ATTEMPTS = if RunService:IsStudio() then 1 else 3

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < MAX_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function buildLeaderstats(player: Player, data)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local kills = Instance.new("IntValue")
	kills.Name = "Kills"
	kills.Value = data.Kills
	kills.Parent = leaderstats

	local streak = Instance.new("IntValue")
	streak.Name = "Série"
	streak.Value = 0
	streak.Parent = leaderstats

	local level = Instance.new("IntValue")
	level.Name = "Niveau"
	level.Value = data.Level
	level.Parent = leaderstats

	leaderstats.Parent = player
end

local function refreshVip(player: Player)
	if Config.VipGamepassId == 0 then
		player:SetAttribute("VIP", false)
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.VipGamepassId)
	end)
	player:SetAttribute("VIP", ok and owns == true)
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.SetStat(player: Player, name: string, value: number)
	local leaderstats = player:FindFirstChild("leaderstats")
	local stat = leaderstats and leaderstats:FindFirstChild(name)
	if stat then
		stat.Value = value
	end
end

function DataService.Snapshot(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local elapsed = os.time() - data.LastDaily
	return {
		Coins = data.Coins,
		Kills = data.Kills,
		Deaths = data.Deaths,
		Xp = data.Xp,
		XpNeeded = Config.XpForLevel(data.Level),
		Level = data.Level,
		BestStreak = data.BestStreak,
		Owned = table.clone(data.Owned),
		Equipped = data.Equipped,
		DailyIn = math.max(0, Config.DailyRewardCooldown - elapsed),
		DailyStreak = data.DailyStreak,
		Vip = player:GetAttribute("VIP") == true,
	}
end

function DataService.Sync(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	DataService.SetStat(player, "Kills", data.Kills)
	DataService.SetStat(player, "Niveau", data.Level)
	Remotes.DataChanged:FireClient(player, DataService.Snapshot(player))
end

-- Modifie les données via une fonction puis synchronise le client.
function DataService.Update(player: Player, mutator: (any) -> ()): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	mutator(data)
	DataService.Sync(player)
	return true
end

-- Ajoute de l'XP et gère les montées de niveau. Retourne le nombre de niveaux gagnés.
function DataService.AddXp(player: Player, amount: number): number
	local gained = 0
	DataService.Update(player, function(data)
		data.Xp += amount
		while data.Xp >= Config.XpForLevel(data.Level) do
			data.Xp -= Config.XpForLevel(data.Level)
			data.Level += 1
			data.Coins += Config.LevelUpCoins * data.Level
			gained += 1
		end
	end)
	return gained
end

function DataService.Load(player: Player)
	local raw
	if store then
		local ok, result = withRetries(function()
			return store:GetAsync(keyFor(player))
		end)
		if not ok then
			if RunService:IsStudio() then
				warn("[DataService] Pas de sauvegarde en Studio (place non publiée ou accès API désactivé) : progression temporaire.")
				noSave[player] = true
			else
				player:Kick("Impossible de charger tes données. Réessaie dans un instant !")
				return nil
			end
		else
			raw = result
		end
	end

	if not player:IsDescendantOf(Players) then
		return nil
	end

	local data = reconcile(if type(raw) == "table" then raw else defaultData())
	refreshVip(player)
	profiles[player] = data
	buildLeaderstats(player, data)
	DataService.Sync(player)
	return data
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not store or noSave[player] then
		return
	end
	local ok, err = withRetries(function()
		store:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Sauvegarde échouée pour " .. player.Name .. " : " .. tostring(err))
	end
	if killsStore then
		pcall(function()
			killsStore:SetAsync(tostring(player.UserId), data.Kills)
		end)
	end
end

function DataService.Init()
	Remotes.GetData.OnServerInvoke = function(player)
		return DataService.Snapshot(player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if purchased and gamePassId == Config.VipGamepassId then
			player:SetAttribute("VIP", true)
			DataService.Sync(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		noSave[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Tableau « Top Kills » global affiché dans l'arène (OrderedDataStore).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local LeaderboardService = {}

local ROWS = 10
local nameCache = {}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok then name else "???"
	nameCache[userId] = result
	return result
end

local function buildGui(board: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.5

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
	background.BackgroundTransparency = 0.1
	background.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.16)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Config.Colors.Gold
	title.Text = "🏆 TOP KILLS"
	title.Parent = background

	local list = Instance.new("Frame")
	list.Position = UDim2.fromScale(0.05, 0.18)
	list.Size = UDim2.fromScale(0.9, 0.8)
	list.BackgroundTransparency = 1
	list.Parent = background

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0.01, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local rows = {}
	for i = 1, ROWS do
		local row = Instance.new("TextLabel")
		row.LayoutOrder = i
		row.Size = UDim2.fromScale(1, 0.09)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(30, 34, 48) else Color3.fromRGB(24, 27, 38)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i == 1
			then Config.Colors.Gold
			elseif i == 2 then Color3.fromRGB(210, 215, 225)
			elseif i == 3 then Color3.fromRGB(215, 140, 80)
			else Color3.new(1, 1, 1)
		row.Text = string.format("  #%d  —", i)
		row.Parent = list
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.2, 0)
		corner.Parent = row
		rows[i] = row
	end

	gui.Parent = board
	return rows
end

function LeaderboardService.Init()
	local arena = workspace:FindFirstChild("Arena")
	local board = arena and arena:FindFirstChild("Leaderboard")
	if not board then
		return
	end

	local rows = buildGui(board)
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if not ok then
		return
	end

	task.spawn(function()
		while true do
			local success, page = pcall(function()
				return store:GetSortedAsync(false, ROWS):GetCurrentPage()
			end)
			if success then
				for i = 1, ROWS do
					local entry = page[i]
					if entry then
						local name = getName(tonumber(entry.key) or 0)
						rows[i].Text = string.format("  #%d  %s  •  %d kills", i, name, entry.value)
					else
						rows[i].Text = string.format("  #%d  —", i)
					end
				end
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Génère une arène prête à jouer + un éclairage soigné.
-- Si tu construis ta propre map, nomme son dossier "Arena" dans Workspace :
-- la génération est alors ignorée (pense à y mettre des SpawnLocation et une part "Leaderboard").
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local MapService = {}

local HALF = 100 -- l'arène fait 200 x 200 studs
local WALL_HEIGHT = 30

local arena: Folder

local function part(props): BasePart
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = p.Parent or arena
	return p
end

local function setupLighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(60, 62, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 110, 130)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true

	local function ensure(className: string, props)
		local effect = Lighting:FindFirstChildOfClass(className) or Instance.new(className)
		for key, value in props do
			effect[key] = value
		end
		effect.Parent = Lighting
	end

	ensure("Atmosphere", {
		Density = 0.3,
		Offset = 0.2,
		Color = Color3.fromRGB(200, 190, 230),
		Decay = Color3.fromRGB(90, 80, 130),
		Glare = 0.3,
		Haze = 1.2,
	})
	ensure("BloomEffect", { Intensity = 0.6, Size = 24, Threshold = 1.4 })
	ensure("ColorCorrectionEffect", { Saturation = 0.15, Contrast = 0.08, Brightness = 0.02 })
	ensure("SunRaysEffect", { Intensity = 0.06, Spread = 0.6 })
end

local function buildFloorAndWalls()
	part({
		Name = "Floor",
		Size = Vector3.new(HALF * 2, 2, HALF * 2),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(42, 46, 58),
		Material = Enum.Material.Slate,
	})

	-- Lignes néon au sol (style e-sport)
	for _, offset in { -50, 0, 50 } do
		part({
			Name = "FloorLine",
			Size = Vector3.new(HALF * 2, 0.1, 0.4),
			CFrame = CFrame.new(0, 0.05, offset),
			Color = Config.Colors.Accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.4,
		})
		part({
			Name = "FloorLine",
			Size = Vector3.new(0.4, 0.1, HALF * 2),
			CFrame = CFrame.new(offset, 0.05, 0),
			Color = Config.Colors.Accent2,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.4,
		})
	end

	local walls = {
		{ CFrame.new(0, WALL_HEIGHT / 2, HALF + 1), Vector3.new(HALF * 2 + 4, WALL_HEIGHT, 2), Config.Colors.Accent },
		{ CFrame.new(0, WALL_HEIGHT / 2, -HALF - 1), Vector3.new(HALF * 2 + 4, WALL_HEIGHT, 2), Config.Colors.Accent2 },
		{ CFrame.new(HALF + 1, WALL_HEIGHT / 2, 0), Vector3.new(2, WALL_HEIGHT, HALF * 2 + 4), Config.Colors.Accent },
		{ CFrame.new(-HALF - 1, WALL_HEIGHT / 2, 0), Vector3.new(2, WALL_HEIGHT, HALF * 2 + 4), Config.Colors.Accent2 },
	}
	for _, wall in walls do
		local cf, size, color = wall[1], wall[2], wall[3]
		part({
			Name = "Wall",
			Size = size,
			CFrame = cf,
			Color = Color3.fromRGB(28, 30, 40),
			Material = Enum.Material.Concrete,
		})
		-- Bandeau lumineux en bas du mur
		part({
			Name = "WallTrim",
			Size = Vector3.new(size.X + 0.2, 0.6, size.Z + 0.2),
			CFrame = CFrame.new(cf.Position.X, 1.2, cf.Position.Z),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end

	-- Plafond invisible pour éviter de sortir de l'arène
	part({
		Name = "Ceiling",
		Size = Vector3.new(HALF * 2, 1, HALF * 2),
		CFrame = CFrame.new(0, WALL_HEIGHT + 0.5, 0),
		Transparency = 1,
		CastShadow = false,
	})
end

local function buildCovers()
	local layout = {
		-- position (quadrant +,+), taille
		{ Vector3.new(50, 0, 50), Vector3.new(14, 7, 3) },
		{ Vector3.new(55, 0, 20), Vector3.new(3, 7, 12) },
		{ Vector3.new(22, 0, 65), Vector3.new(12, 7, 3) },
		{ Vector3.new(72, 0, 72), Vector3.new(6, 14, 6) },
		{ Vector3.new(35, 0, 35), Vector3.new(4, 4, 4) },
	}
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			for _, entry in layout do
				local pos, size = entry[1], entry[2]
				local block = part({
					Name = "Cover",
					Size = size,
					CFrame = CFrame.new(pos.X * sx, size.Y / 2, pos.Z * sz),
					Color = Color3.fromRGB(70, 76, 96),
					Material = Enum.Material.Concrete,
				})
				part({
					Name = "CoverTrim",
					Size = Vector3.new(size.X + 0.2, 0.3, size.Z + 0.2),
					CFrame = block.CFrame * CFrame.new(0, size.Y / 2, 0),
					Color = if sx == sz then Config.Colors.Accent else Config.Colors.Accent2,
					Material = Enum.Material.Neon,
					CanCollide = false,
				})
			end
		end
	end
end

local function buildCenter()
	local height = 6
	local platform = part({
		Name = "CenterPlatform",
		Size = Vector3.new(36, height, 36),
		CFrame = CFrame.new(0, height / 2, 0),
		Color = Color3.fromRGB(55, 60, 78),
		Material = Enum.Material.DiamondPlate,
	})
	part({
		Name = "CenterRing",
		Size = Vector3.new(37, 0.4, 37),
		CFrame = platform.CFrame * CFrame.new(0, height / 2 - 0.1, 0),
		Color = Config.Colors.Gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.2,
	})

	-- Rampes : la face haute d'un WedgePart est côté +Z, on l'oriente vers la plateforme.
	for _, dir in { Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis } do
		local pos = Vector3.new(0, height / 2, 0) + dir * (18 + 7)
		part({
			ClassName = "WedgePart",
			Name = "Ramp",
			Size = Vector3.new(10, height, 14),
			CFrame = CFrame.lookAt(pos, pos + dir),
			Color = Color3.fromRGB(55, 60, 78),
			Material = Enum.Material.DiamondPlate,
		})
	end
end

local function buildSpawns()
	local count = 8
	local radius = 85
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
		local spawn = part({
			ClassName = "SpawnLocation",
			Name = "Spawn",
			Size = Vector3.new(8, 1, 8),
			CFrame = CFrame.lookAt(pos, Vector3.new(0, 0.5, 0)),
			Color = Config.Colors.Accent,
			Material = Enum.Material.Neon,
			Transparency = 0.3,
		}) :: SpawnLocation
		spawn.Neutral = true
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = Config.SpawnProtection
	end
end

local function buildSigns()
	part({
		Name = "Leaderboard",
		Size = Vector3.new(34, 20, 1),
		CFrame = CFrame.new(0, 14, HALF - 0.6), -- face avant (-Z) tournée vers le centre
		Color = Color3.fromRGB(14, 16, 24),
		Material = Enum.Material.SmoothPlastic,
	})

	local banner = part({
		Name = "Banner",
		Size = Vector3.new(60, 10, 1),
		CFrame = CFrame.new(0, 18, -HALF + 0.6),
		Color = Color3.fromRGB(14, 16, 24),
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- face +Z, tournée vers le centre
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = Config.GameName
	label.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Config.Colors.Accent, Config.Colors.Accent2)
	gradient.Parent = label
	gui.Parent = banner
end

function MapService.Build()
	setupLighting()

	if workspace:FindFirstChild("Arena") then
		return
	end

	-- Nettoie le template par défaut de Roblox Studio
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	arena = Instance.new("Folder")
	arena.Name = "Arena"
	buildFloorAndWalls()
	buildCovers()
	buildCenter()
	buildSpawns()
	buildSigns()
	arena.Parent = workspace
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Boutique d'armes + récompense quotidienne (tout est vérifié côté serveur).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local DataService = require(script.Parent.DataService)
local CombatService = require(script.Parent.CombatService)

local ShopService = {}

local function buy(player: Player, weaponId: any)
	local weapon = type(weaponId) == "string" and Weapons.ById[weaponId]
	if not weapon then
		return false, "Arme inconnue"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "Données pas encore chargées"
	end
	if data.Owned[weapon.Id] then
		return false, "Tu possèdes déjà cette arme"
	end
	if data.Coins < weapon.Price then
		return false, string.format("Il te manque %d 💰", weapon.Price - data.Coins)
	end

	DataService.Update(player, function(d)
		d.Coins -= weapon.Price
		d.Owned[weapon.Id] = true
		d.Equipped = weapon.Id
	end)
	CombatService.GiveWeapon(player)
	return true, weapon.Name .. " achetée !"
end

local function equip(player: Player, weaponId: any)
	local weapon = type(weaponId) == "string" and Weapons.ById[weaponId]
	local data = DataService.Get(player)
	if not weapon or not data or not data.Owned[weapon.Id] then
		return false, "Impossible d'équiper cette arme"
	end
	DataService.Update(player, function(d)
		d.Equipped = weapon.Id
	end)
	CombatService.GiveWeapon(player)
	return true, weapon.Name .. " équipée"
end

local function claimDaily(player: Player)
	local data = DataService.Get(player)
	if not data then
		return false, 0
	end
	local now = os.time()
	local elapsed = now - data.LastDaily
	if elapsed < Config.DailyRewardCooldown then
		return false, Config.DailyRewardCooldown - elapsed
	end

	local streak = if elapsed > Config.DailyStreakReset then 0 else data.DailyStreak
	local reward = Config.DailyRewards[(streak % #Config.DailyRewards) + 1]
	if player:GetAttribute("VIP") then
		reward *= Config.VipCoinMultiplier
	end

	DataService.Update(player, function(d)
		d.LastDaily = now
		d.DailyStreak = streak + 1
		d.Coins += reward
	end)
	return true, reward, streak + 1
end

function ShopService.Init()
	Remotes.BuyWeapon.OnServerInvoke = buy
	Remotes.EquipWeapon.OnServerInvoke = equip
	Remotes.ClaimDaily.OnServerInvoke = claimDaily
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="17">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[-- Côté client : envoi des coups, dash, recul, chiffres de dégâts, effets.
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Combat = {}

local hud
local lastSwing = 0
local lastDash = -math.huge
local hooked = setmetatable({}, { __mode = "k" })
local hitSound: Sound

local function getCharacterParts()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return humanoid, root
	end
	return nil, nil
end

-- Pousse brièvement le personnage (dash / recul).
local function push(root: BasePart, velocity: Vector3, duration: number)
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local mover = Instance.new("LinearVelocity")
	mover.Attachment0 = attachment
	mover.MaxForce = 1e5
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VectorVelocity = velocity
	mover.Parent = root
	Debris:AddItem(mover, duration)
	Debris:AddItem(attachment, duration)
end

local function hookTool(tool: Tool)
	if hooked[tool] or not tool:GetAttribute("WeaponId") then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		local weapon = Weapons.ById[tool:GetAttribute("WeaponId")]
		local now = os.clock()
		if not weapon or now - lastSwing < weapon.Cooldown then
			return
		end
		lastSwing = now
		Remotes.Swing:FireServer()
	end)
end

local function onDash(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	local humanoid, root = getCharacterParts()
	local now = os.clock()
	if not humanoid or now - lastDash < Config.DashCooldown then
		return Enum.ContextActionResult.Sink
	end
	lastDash = now

	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	end
	push(root, direction.Unit * Config.DashPower, Config.DashDuration)

	local baseFov = 70
	camera.FieldOfView = baseFov + 12
	Ui.tween(camera, 0.35, { FieldOfView = baseFov })
	hud.DashCooldown(Config.DashCooldown)
	return Enum.ContextActionResult.Sink
end

local function showDamageNumber(position: Vector3, amount: number, crit: boolean)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.Position = position + Vector3.new(math.random(-10, 10) / 10, 0, math.random(-10, 10) / 10)
	anchor.Parent = workspace

	local billboard = Ui.new("BillboardGui", {
		Size = UDim2.fromOffset(120, 50),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Parent = anchor,
	})
	local label = Ui.label({
		Size = UDim2.fromScale(1, 1),
		Font = Ui.FontBlack,
		Text = if crit then amount .. "!" else tostring(amount),
		TextColor3 = if crit then Config.Colors.Gold else Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.3,
		Parent = billboard,
	})
	local scale = Ui.new("UIScale", { Scale = if crit then 1.6 else 1.2, Parent = label })
	Ui.tween(scale, 0.25, { Scale = if crit then 1.2 else 0.9 }, Enum.EasingStyle.Back)
	Ui.tween(anchor, 0.8, { Position = anchor.Position + Vector3.new(0, 3, 0) })
	task.delay(0.45, function()
		Ui.tween(label, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(anchor, 0.9)
end

local function onCharacter(character: Model)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			hookTool(child)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			hookTool(child)
		end
	end

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local lastHealth = humanoid.Health
	humanoid.HealthChanged:Connect(function(health)
		if health < lastHealth then
			hud.DamageFlash()
		end
		lastHealth = health
	end)
end

function Combat.Init(hudController)
	hud = hudController

	hitSound = Ui.new("Sound", { SoundId = Config.Sounds.Hit, Volume = 0.5, Parent = SoundService })

	ContextActionService:BindAction("Dash", onDash, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("Dash", "Dash")
	ContextActionService:SetPosition("Dash", UDim2.new(1, -170, 1, -150))

	Remotes.HitConfirm.OnClientEvent:Connect(function(position: Vector3, amount: number, crit: boolean)
		showDamageNumber(position, amount, crit)
		SoundService:PlayLocalSound(hitSound)
	end)

	Remotes.Knockback.OnClientEvent:Connect(function(direction: Vector3)
		local _, root = getCharacterParts()
		if root then
			push(root, direction * Config.KnockbackPower + Vector3.new(0, 12, 0), 0.12)
		end
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[-- HUD : pièces, niveau/XP, série, kill feed, annonces, notifications, récompense quotidienne.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local Hud = {}

local gui: ScreenGui
local coinsLabel, levelLabel, xpFill, xpText, streakLabel
local killFeed, announceLabel, toastHolder, damageFlash
local dailyButton, dashBar
local dailyReadyAt = math.huge
local lastCoins
local uiSound

local function playUi()
	if uiSound then
		SoundService:PlayLocalSound(uiSound)
	end
end

local function buildTopBar()
	local bar = Ui.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(380, 54),
		BackgroundColor3 = Ui.Colors.Background,
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { Ui.corner(14), Ui.stroke(Config.Colors.Accent, 1.5, 0.6) })

	local badge = Ui.new("Frame", {
		Position = UDim2.fromOffset(7, 7),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Config.Colors.Accent,
		Parent = bar,
	}, {
		Ui.corner(20),
		Ui.new("UIGradient", { Color = ColorSequence.new(Config.Colors.Accent, Config.Colors.Accent2), Rotation = 45 }),
	})
	levelLabel = Ui.label({
		Size = UDim2.fromScale(1, 1),
		Font = Ui.FontBlack,
		Text = "1",
		Parent = badge,
	})
	Ui.padding(6).Parent = levelLabel

	local xpBack = Ui.new("Frame", {
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(1, -176, 0, 12),
		BackgroundColor3 = Ui.Colors.PanelLight,
		Parent = bar,
	}, { Ui.corner(6) })
	xpFill = Ui.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Config.Colors.Accent,
		Parent = xpBack,
	}, {
		Ui.corner(6),
		Ui.new("UIGradient", { Color = ColorSequence.new(Config.Colors.Accent, Config.Colors.Accent2) }),
	})
	xpText = Ui.label({
		Position = UDim2.fromOffset(56, 8),
		Size = UDim2.new(1, -176, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.Colors.Muted,
		Text = "Niveau 1 • 0 / 100 XP",
		Parent = bar,
	})

	local coinsBox = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(106, 38),
		BackgroundColor3 = Ui.Colors.Panel,
		Parent = bar,
	}, { Ui.corner(10), Ui.stroke(Config.Colors.Gold, 1.5, 0.5), Ui.padding(6) })
	coinsLabel = Ui.label({
		Size = UDim2.fromScale(1, 1),
		TextColor3 = Config.Colors.Gold,
		Text = "💰 0",
		Parent = coinsBox,
	})

	streakLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(240, 26),
		Font = Ui.FontBlack,
		TextColor3 = Color3.fromRGB(255, 140, 50),
		TextStrokeTransparency = 0.6,
		Text = "",
		Parent = gui,
	})
end

local function buildSideButtons(onShop: () -> ())
	local holder = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(150, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 10) }) })

	local shop = Ui.button({
		Size = UDim2.fromOffset(150, 52),
		Text = "🛒 Boutique",
		Parent = holder,
	}, Config.Colors.Accent2)
	shop.Activated:Connect(function()
		playUi()
		onShop()
	end)

	dailyButton = Ui.button({
		Size = UDim2.fromOffset(150, 52),
		Text = "🎁 Récompense",
		Parent = holder,
	}, Ui.Colors.PanelLight)
	dailyButton.Activated:Connect(function()
		playUi()
		local ok, value, streak = Remotes.ClaimDaily:InvokeServer()
		if ok then
			Hud.Announce(string.format("🎁 Jour %d : +%d 💰", streak, value), Config.Colors.Gold)
		elseif type(value) == "number" and value > 0 then
			Hud.Toast("Prochaine récompense dans " .. Ui.formatTime(value))
		end
	end)
end

local function buildFeedAndMessages()
	killFeed = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 60),
		Size = UDim2.fromOffset(320, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	announceLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.27),
		Size = UDim2.new(0.8, 0, 0, 48),
		Font = Ui.FontBlack,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Text = "",
		Parent = gui,
	})

	toastHolder = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(360, 160),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	damageFlash = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Config.Colors.Bad,
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = gui,
	})

	local dashBack = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -80),
		Size = UDim2.fromOffset(120, 6),
		BackgroundColor3 = Ui.Colors.PanelLight,
		BackgroundTransparency = 0.3,
		Parent = gui,
	}, { Ui.corner(3) })
	dashBar = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Config.Colors.Accent,
		Parent = dashBack,
	}, { Ui.corner(3) })
	Ui.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -2),
		Size = UDim2.fromOffset(160, 14),
		TextColor3 = Ui.Colors.Muted,
		Text = "[Q] Dash",
		Parent = dashBack,
	})
end

local feedOrder = 0
function Hud.KillFeed(killerName: string?, victimName: string, weaponName: string?)
	feedOrder += 1
	local involved = killerName == player.DisplayName or victimName == player.DisplayName
	local text = if killerName
		then string.format("<b>%s</b>  ⚔  %s", killerName, victimName)
		else string.format("💀 %s", victimName)

	local entry = Ui.new("Frame", {
		LayoutOrder = -feedOrder,
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = if involved then Config.Colors.Accent2 else Ui.Colors.Background,
		BackgroundTransparency = if involved then 0.3 else 0.25,
		Parent = killFeed,
	}, { Ui.corner(8), Ui.padding(6) })
	local label = Ui.label({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		TextScaled = false,
		TextSize = 16,
		RichText = true,
		Text = text,
		Parent = entry,
	})
	if weaponName then
		label.Text ..= string.format("  <font color=\"#9AA0B5\">[%s]</font>", weaponName)
	end

	local entries = {}
	for _, child in killFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	table.sort(entries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 7, #entries do
		entries[i]:Destroy()
	end

	task.delay(6, function()
		if entry.Parent then
			Ui.tween(entry, 0.4, { BackgroundTransparency = 1 })
			Ui.tween(label, 0.4, { TextTransparency = 1 }).Completed:Wait()
			entry:Destroy()
		end
	end)
end

local announceToken = 0
function Hud.Announce(text: string, color: Color3?)
	announceToken += 1
	local token = announceToken
	announceLabel.Text = text
	announceLabel.TextColor3 = color or Ui.Colors.Text
	announceLabel.TextTransparency = 0
	announceLabel.TextStrokeTransparency = 0.4
	announceLabel.Size = UDim2.new(0.8, 0, 0, 70)
	Ui.tween(announceLabel, 0.35, { Size = UDim2.new(0.8, 0, 0, 48) }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if token == announceToken then
			Ui.tween(announceLabel, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local toastOrder = 0
function Hud.Toast(text: string)
	toastOrder += 1
	local toast = Ui.new("Frame", {
		LayoutOrder = toastOrder,
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Ui.Colors.Background,
		BackgroundTransparency = 0.2,
		Parent = toastHolder,
	}, { Ui.corner(10), Ui.padding(7), Ui.stroke(Config.Colors.Gold, 1.2, 0.5) })
	local label = Ui.label({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		TextScaled = false,
		TextSize = 17,
		TextColor3 = Config.Colors.Gold,
		Text = text,
		Parent = toast,
	})
	task.delay(2.5, function()
		Ui.tween(toast, 0.4, { BackgroundTransparency = 1 })
		Ui.tween(label, 0.4, { TextTransparency = 1 }).Completed:Wait()
		toast:Destroy()
	end)
end

function Hud.DamageFlash()
	damageFlash.BackgroundTransparency = 0.75
	Ui.tween(damageFlash, 0.4, { BackgroundTransparency = 1 })
end

function Hud.DashCooldown(duration: number)
	dashBar.Size = UDim2.fromScale(0, 1)
	dashBar.BackgroundColor3 = Ui.Colors.Muted
	local tween = Ui.tween(dashBar, duration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			dashBar.BackgroundColor3 = Config.Colors.Accent
		end
	end)
end

function Hud.OnData(data)
	if not data then
		return
	end
	if lastCoins and data.Coins ~= lastCoins then
		local scale = coinsLabel.Parent:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = coinsLabel.Parent })
		scale.Scale = 1.15
		Ui.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	lastCoins = data.Coins
	coinsLabel.Text = "💰 " .. Ui.formatNumber(data.Coins)
	levelLabel.Text = tostring(data.Level)
	xpText.Text = string.format("Niveau %d • %d / %d XP%s", data.Level, data.Xp, data.XpNeeded, if data.Vip then "  👑 VIP" else "")
	Ui.tween(xpFill, 0.4, { Size = UDim2.fromScale(math.clamp(data.Xp / data.XpNeeded, 0, 1), 1) })
	dailyReadyAt = os.clock() + data.DailyIn
end

function Hud.Init(callbacks)
	gui = Ui.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	uiSound = Ui.new("Sound", { SoundId = Config.Sounds.Ui, Volume = 0.4, Parent = SoundService })

	buildTopBar()
	buildSideButtons(callbacks.OnShop)
	buildFeedAndMessages()

	Remotes.KillFeed.OnClientEvent:Connect(Hud.KillFeed)
	Remotes.Announce.OnClientEvent:Connect(Hud.Announce)
	Remotes.Toast.OnClientEvent:Connect(Hud.Toast)

	-- Série affichée depuis les leaderstats
	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats")
		local streak = leaderstats:WaitForChild("Série") :: IntValue
		local function update()
			streakLabel.Text = if streak.Value > 0 then "🔥 Série : " .. streak.Value else ""
		end
		streak.Changed:Connect(update)
		update()
	end)

	-- Compte à rebours de la récompense quotidienne
	task.spawn(function()
		while true do
			local remaining = dailyReadyAt - os.clock()
			if remaining <= 0 then
				dailyButton.Text = "🎁 Récupérer !"
				dailyButton.BackgroundColor3 = Config.Colors.Good
			elseif remaining == math.huge then
				dailyButton.Text = "🎁 Récompense"
			else
				dailyButton.Text = "🎁 " .. Ui.formatTime(remaining)
				dailyButton.BackgroundColor3 = Ui.Colors.PanelLight
			end
			task.wait(1)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[-- Fenêtre de boutique : acheter / équiper les armes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local Shop = {}

local window: Frame
local cards = {} -- [weaponId] = { button, price }
local currentData
local onMessage: (string, Color3?) -> ()

local function refresh()
	if not currentData then
		return
	end
	for id, card in cards do
		local weapon = Weapons.ById[id]
		local button = card.Button
		if currentData.Equipped == id then
			button.Text = "✔ Équipée"
			button.BackgroundColor3 = Ui.Colors.PanelLight
		elseif currentData.Owned[id] then
			button.Text = "Équiper"
			button.BackgroundColor3 = Config.Colors.Accent
		else
			button.Text = "💰 " .. Ui.formatNumber(weapon.Price)
			button.BackgroundColor3 = if currentData.Coins >= weapon.Price then Config.Colors.Good else Color3.fromRGB(90, 70, 75)
		end
	end
end

local function buildCard(weapon, parent: Instance)
	local card = Ui.new("Frame", {
		LayoutOrder = weapon.Order,
		BackgroundColor3 = Ui.Colors.Panel,
		Parent = parent,
	}, { Ui.corner(12), Ui.stroke(weapon.Color, 2, 0.4), Ui.padding(10) })

	local preview = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Ui.Colors.Background,
		Parent = card,
	}, { Ui.corner(10) })
	Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.75, 0, 0, 8),
		Rotation = -12,
		BackgroundColor3 = weapon.Color,
		Parent = preview,
	}, { Ui.corner(4) })

	Ui.label({
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Ui.FontBlack,
		Text = weapon.Name,
		Parent = card,
	})
	Ui.label({
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 0, 50),
		TextScaled = false,
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = Ui.Colors.Muted,
		Text = string.format(
			"⚔ %d dégâts\n⏱ %.2fs  •  📏 %.1f\n🔥 %.0f DPS",
			weapon.Damage,
			weapon.Cooldown,
			weapon.Range,
			weapon.Damage / weapon.Cooldown
		),
		Parent = card,
	})

	local button = Ui.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 36),
		Text = "...",
		Parent = card,
	}, Config.Colors.Good)

	button.Activated:Connect(function()
		if not currentData or currentData.Equipped == weapon.Id then
			return
		end
		local remote = if currentData.Owned[weapon.Id] then Remotes.EquipWeapon else Remotes.BuyWeapon
		local ok, message = remote:InvokeServer(weapon.Id)
		onMessage(message, if ok then Config.Colors.Good else Config.Colors.Bad)
	end)

	cards[weapon.Id] = { Button = button }
end

function Shop.Toggle()
	window.Visible = not window.Visible
	if window.Visible then
		local scale = window:FindFirstChildOfClass("UIScale")
		scale.Scale = 0.85
		Ui.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

function Shop.OnData(data)
	currentData = data
	refresh()
end

function Shop.Init(messageCallback: (string, Color3?) -> ())
	onMessage = messageCallback

	local gui = Ui.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})

	window = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.8),
		BackgroundColor3 = Ui.Colors.Background,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = gui,
	}, {
		Ui.corner(18),
		Ui.stroke(Config.Colors.Accent, 2, 0.4),
		Ui.padding(16),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(720, 470) }),
		Ui.new("UIScale"),
	})

	Ui.label({
		Size = UDim2.new(1, -50, 0, 34),
		Font = Ui.FontBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "🛒 ARSENAL",
		Parent = window,
	})

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		Parent = window,
	}, Config.Colors.Bad)
	close.Activated:Connect(Shop.Toggle)

	local scroller = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window,
	}, {
		Ui.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(200, 230),
			CellPadding = UDim2.fromOffset(12, 12),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for _, weapon in Weapons.List do
		buildCard(weapon, scroller)
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[-- Petits helpers pour construire une interface propre et homogène en code.
local TweenService = game:GetService("TweenService")

local Ui = {}

Ui.Colors = {
	Background = Color3.fromRGB(16, 18, 26),
	Panel = Color3.fromRGB(26, 29, 40),
	PanelLight = Color3.fromRGB(38, 42, 58),
	Text = Color3.fromRGB(245, 246, 250),
	Muted = Color3.fromRGB(150, 155, 175),
}

Ui.Font = Enum.Font.GothamBold
Ui.FontBlack = Enum.Font.GothamBlack

function Ui.new(className: string, props, children)
	local instance = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number?)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Ui.stroke(color: Color3?, thickness: number?, transparency: number?)
	return Ui.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.padding(px: number)
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.Font,
		TextColor3 = Ui.Colors.Text,
		TextScaled = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Ui.new("TextLabel", defaults)
end

function Ui.tween(instance: Instance, time: number, goal, style: Enum.EasingStyle?)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

-- Bouton avec effet de survol / clic.
function Ui.button(props, color: Color3)
	local button = Ui.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Font = Ui.Font,
		TextColor3 = Ui.Colors.Text,
		TextScaled = true,
	}, { Ui.corner(10), Ui.padding(6) })
	for key, value in props do
		if key == "Parent" then
			continue
		end
		button[key] = value
	end
	local scale = Ui.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		Ui.tween(scale, 0.15, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Ui.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Ui.tween(scale, 0.08, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		Ui.tween(scale, 0.12, { Scale = 1.05 })
	end)
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function Ui.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (formatted:gsub("^ ", ""))
end

function Ui.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Point d'entrée client.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local Controllers = script.Parent:WaitForChild("Controllers")
local Hud = require(Controllers.HudController)
local Shop = require(Controllers.ShopController)
local Combat = require(Controllers.CombatController)

Shop.Init(function(message, color)
	Hud.Announce(message, color)
end)
Hud.Init({ OnShop = Shop.Toggle })
Combat.Init(Hud)

local function onData(data)
	Hud.OnData(data)
	Shop.OnData(data)
end

Remotes.DataChanged.OnClientEvent:Connect(onData)
task.spawn(function()
	onData(Remotes.GetData:InvokeServer())
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>