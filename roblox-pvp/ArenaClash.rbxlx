          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Tous les réglages du jeu au même endroit : modifie ici pour équilibrer.
local Config = {}

Config.GameName = "ARENA CLASH"

-- Économie / progression
Config.StartingCoins = 0
Config.CoinsPerKill = 10
Config.StreakBountyPerKill = 5 -- bonus par kill de série de la victime (prime)
Config.AssistCoins = 4
Config.XpPerKill = 25
Config.LevelUpCoins = 10 -- x niveau atteint
function Config.XpForLevel(level: number): number
	return 100 + (level - 1) * 50
end

-- Combat
Config.CritChance = 0.1
Config.CritMultiplier = 1.5
Config.HealOnKill = 30
Config.KillCreditWindow = 10 -- secondes pendant lesquelles le dernier attaquant reçoit le kill
Config.AssistWindow = 8
Config.MaxTargetsPerSwing = 3
Config.KnockbackPower = 35
Config.RespawnTime = 3
Config.SpawnProtection = 3 -- ForceField au spawn (retiré si le joueur attaque)

-- Dash (touche Q / bouton mobile)
Config.DashCooldown = 2.5
Config.DashPower = 75
Config.DashDuration = 0.18

-- Séries annoncées à tout le serveur
Config.StreakMessages = {
	[3] = "%s est en série de 3 ! 🔥",
	[5] = "%s est INARRÊTABLE ! (5) ⚡",
	[10] = "%s est LÉGENDAIRE ! (10) 👑",
	[15] = "%s domine l'arène ! (15) 💀",
	[25] = "%s est un DIEU ! (25) 🌌",
}

-- Récompense quotidienne (augmente chaque jour consécutif)
Config.DailyRewardCooldown = 20 * 3600
Config.DailyStreakReset = 48 * 3600
Config.DailyRewards = { 50, 75, 100, 150, 200, 300, 500 }

-- Monétisation / badges (mets tes IDs, 0 = désactivé)
Config.VipGamepassId = 0
Config.VipCoinMultiplier = 2
Config.Badges = {
	FirstKill = 0,
	Streak10 = 0,
	Level10 = 0,
}

-- Sauvegarde
Config.DataStoreName = "ArenaClash_PlayerData_v1"
Config.LeaderboardStoreName = "ArenaClash_Kills_v1"
Config.AutosaveInterval = 120
Config.LeaderboardRefresh = 60

-- Sons intégrés au client Roblox (remplace par tes propres rbxassetid:// si tu veux)
Config.Sounds = {
	Slash = "rbxasset://sounds/swordslash.wav",
	Unsheath = "rbxasset://sounds/unsheath.wav",
	Hit = "rbxasset://sounds/swordlunge.wav",
	Ui = "rbxasset://sounds/electronicpingshort.wav",
}

-- Couleurs de l'interface
Config.Colors = {
	Accent = Color3.fromRGB(0, 200, 255),
	Accent2 = Color3.fromRGB(255, 60, 140),
	Gold = Color3.fromRGB(255, 196, 60),
	Good = Color3.fromRGB(80, 220, 120),
	Bad = Color3.fromRGB(255, 80, 80),
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crée (serveur) ou récupère (client) tous les RemoteEvents / RemoteFunctions.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Swing", -- client -> serveur : coup d'épée
	"HitConfirm", -- serveur -> attaquant : position, dégâts, critique
	"Knockback", -- serveur -> victime : direction du recul
	"KillFeed", -- serveur -> tous
	"Announce", -- serveur -> client(s) : gros message central
	"Toast", -- serveur -> client : petit message (+pièces…)
	"DataChanged", -- serveur -> client : snapshot des données
}

local FUNCTIONS = {
	"GetData",
	"BuyWeapon",
	"EquipWeapon",
	"ClaimDaily",
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[-- Catalogue des armes. Le premier élément est l'arme gratuite de départ.
-- DPS volontairement proche entre armes : on achète du style et du confort, pas une victoire garantie.
local Weapons = {}

Weapons.List = {
	{
		Id = "Wooden",
		Name = "Épée en bois",
		Price = 0,
		Damage = 20,
		Cooldown = 0.55,
		Range = 6,
		Length = 3.2,
		Color = Color3.fromRGB(160, 115, 70),
		Material = Enum.Material.Wood,
	},
	{
		Id = "Iron",
		Name = "Lame de fer",
		Price = 300,
		Damage = 22,
		Cooldown = 0.52,
		Range = 6.5,
		Length = 3.6,
		Color = Color3.fromRGB(200, 205, 215),
		Material = Enum.Material.Metal,
	},
	{
		Id = "Katana",
		Name = "Katana",
		Price = 900,
		Damage = 18,
		Cooldown = 0.4,
		Range = 7,
		Length = 4,
		Color = Color3.fromRGB(235, 235, 245),
		Material = Enum.Material.Glass,
		TrailColor = Color3.fromRGB(255, 255, 255),
	},
	{
		Id = "Crystal",
		Name = "Épée de cristal",
		Price = 2500,
		Damage = 27,
		Cooldown = 0.58,
		Range = 7.5,
		Length = 4.2,
		Color = Color3.fromRGB(90, 200, 255),
		Material = Enum.Material.Neon,
		Glow = true,
	},
	{
		Id = "Inferno",
		Name = "Lame Inferno",
		Price = 6000,
		Damage = 24,
		Cooldown = 0.46,
		Range = 7.5,
		Length = 4.4,
		Color = Color3.fromRGB(255, 90, 30),
		Material = Enum.Material.Neon,
		Glow = true,
		TrailColor = Color3.fromRGB(255, 200, 60),
	},
	{
		Id = "Void",
		Name = "Faux du Néant",
		Price = 15000,
		Damage = 25,
		Cooldown = 0.45,
		Range = 8,
		Length = 4.8,
		Color = Color3.fromRGB(150, 60, 255),
		Material = Enum.Material.Neon,
		Glow = true,
		TrailColor = Color3.fromRGB(255, 60, 200),
	},
}

Weapons.ById = {}
for index, weapon in Weapons.List do
	weapon.Order = index
	Weapons.ById[weapon.Id] = weapon
end

Weapons.Default = Weapons.List[1]

return Weapons
]]></string>
