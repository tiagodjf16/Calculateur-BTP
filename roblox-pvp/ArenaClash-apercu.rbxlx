      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Ballistics</string>
          <string name="Source"><![CDATA[-- Calculs de tir partagés client / serveur : dispersion, dégâts, raycasts, détection tête.
-- Le client s'en sert pour prédire ses tirs, le serveur pour les valider avec EXACTEMENT les mêmes règles.
local Players = game:GetService("Players")

local Ballistics = {}

-- Dossiers dont le contenu ne doit jamais arrêter une balle.
local IGNORED_FOLDERS = { "ClientFX", "FX" }

-- Liste d'exclusion de base : murs invisibles de la map, effets visuels, + extra.
function Ballistics.GetIgnoreList(extra: { Instance }?): { Instance }
	local list = {}
	local arena = workspace:FindFirstChild("Arena")
	local passthrough = arena and arena:FindFirstChild("BulletPassthrough")
	if passthrough then
		table.insert(list, passthrough)
	end
	for _, name in IGNORED_FOLDERS do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	if extra then
		for _, instance in extra do
			table.insert(list, instance)
		end
	end
	return list
end

function Ballistics.GetRaycastParams(extra: { Instance }?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Ballistics.GetIgnoreList(extra)
	params.IgnoreWater = true
	return params
end

-- Tous les personnages des joueurs (pour des raycasts « décor seulement »).
function Ballistics.GetCharacters(): { Instance }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	return list
end

-- Retourne (Humanoid, Model) si la pièce appartient à un personnage, sinon nil.
function Ballistics.GetHumanoid(part: Instance?): (Humanoid?, Model?)
	if not part then
		return nil, nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid, model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

-- Tête, ou accessoire porté sur la tête (chapeau, cheveux).
function Ballistics.IsHeadshot(part: Instance?): boolean
	if not part then
		return false
	end
	if part.Name == "Head" then
		return true
	end
	local accessory = part.Parent
	if accessory and accessory:IsA("Accessory") then
		local weld = part:FindFirstChild("AccessoryWeld")
		return weld ~= nil and weld:IsA("JointInstance") and weld.Part1 ~= nil and weld.Part1.Name == "Head"
	end
	return false
end

-- Dégâts selon la distance (atténuation linéaire) et la zone touchée.
function Ballistics.DamageAt(weapon, distance: number, headshot: boolean): number
	local scale = 1
	if distance > weapon.FalloffStart then
		local span = math.max(1, weapon.FalloffEnd - weapon.FalloffStart)
		local t = math.clamp((distance - weapon.FalloffStart) / span, 0, 1)
		scale = 1 + (weapon.MinDamageScale - 1) * t
	end
	local damage = weapon.Damage * scale
	if headshot then
		damage *= weapon.HeadshotMultiplier
	end
	return math.floor(damage + 0.5)
end

-- Dévie une direction aléatoirement dans un cône (demi-angle en degrés), répartition uniforme.
function Ballistics.ApplySpread(direction: Vector3, degrees: number, rng: Random?): Vector3
	local unit = direction.Unit
	if degrees <= 0 then
		return unit
	end
	local random = rng or Random.new()
	local angle = math.rad(degrees) * math.sqrt(random:NextNumber())
	local spin = random:NextNumber() * math.pi * 2
	local frame = CFrame.lookAt(Vector3.zero, unit)
	return (frame * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

return Ballistics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Camos</string>
          <string name="Source"><![CDATA[-- Camouflages d'armes : chaque camouflage se débloque avec un nombre de kills réalisés AVEC cette arme.
-- GunBuilder applique le camouflage aux pièces marquées de l'attribut Camo = true (le « corps » de l'arme).
-- Animated = true : les pièces reçoivent le tag CollectionService "AnimatedCamo" et le client fait défiler les couleurs.
local Camos = {}

Camos.List = {
	{ Id = "Default", Name = "Standard", Kills = 0 },
	{
		Id = "Carbon",
		Name = "Carbone",
		Kills = 15,
		Color = Color3.fromRGB(32, 33, 38),
		Material = Enum.Material.Fabric,
	},
	{
		Id = "Arctic",
		Name = "Arctique",
		Kills = 40,
		Color = Color3.fromRGB(226, 236, 246),
		Material = Enum.Material.SmoothPlastic,
	},
	{
		Id = "Crimson",
		Name = "Cramoisi",
		Kills = 75,
		Color = Color3.fromRGB(150, 18, 36),
		Material = Enum.Material.Metal,
	},
	{
		Id = "Gold",
		Name = "Or",
		Kills = 120,
		Color = Color3.fromRGB(255, 196, 64),
		Material = Enum.Material.Foil,
		Reflectance = 0.2,
	},
	{
		Id = "Diamond",
		Name = "Diamant",
		Kills = 250,
		Color = Color3.fromRGB(160, 235, 255),
		Material = Enum.Material.Glass,
		Reflectance = 0.25,
	},
	{
		Id = "Nebula",
		Name = "Nébuleuse",
		Kills = 500,
		Color = Color3.fromRGB(150, 60, 255),
		Material = Enum.Material.Neon,
		Animated = true,
	},
}

Camos.ById = {}
for index, camo in Camos.List do
	camo.Order = index
	Camos.ById[camo.Id] = camo
end

function Camos.IsUnlocked(camoId: string, weaponKills: number): boolean
	local camo = Camos.ById[camoId]
	return camo ~= nil and (weaponKills or 0) >= camo.Kills
end

return Camos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Tous les réglages du jeu au même endroit : modifie ici pour équilibrer.
local Config = {}

Config.GameName = "ARENA CLASH"

--------------------------------------------------------------------------
-- Économie / progression
--------------------------------------------------------------------------
-- Chaque action rapporte de l'XP (affichée en « +100 ÉLIMINATION ») et des pièces.
Config.ScoreEvents = {
	Kill = { Label = "ÉLIMINATION", Xp = 100, Coins = 15 },
	Headshot = { Label = "TIR À LA TÊTE", Xp = 50, Coins = 5 },
	Assist = { Label = "ASSISTANCE", Xp = 40, Coins = 5 },
	Longshot = { Label = "LONGUE DISTANCE", Xp = 50, Coins = 5 },
	Revenge = { Label = "VENGEANCE", Xp = 50, Coins = 5 },
	FirstBlood = { Label = "PREMIER SANG", Xp = 100, Coins = 20 },
	MultiKill = { Label = "MULTI-KILL", Xp = 75, Coins = 10 },
	BountyKill = { Label = "CIBLE ABATTUE", Xp = 150, Coins = 50 },
	StreakEnded = { Label = "SÉRIE STOPPÉE", Xp = 75, Coins = 10 },
}
Config.StreakBountyPerKill = 5 -- pièces bonus par kill de série de la victime
Config.LevelUpCoins = 25 -- x niveau atteint
function Config.XpForLevel(level: number): number
	return 500 + (level - 1) * 150
end

--------------------------------------------------------------------------
-- Combat
--------------------------------------------------------------------------
Config.MaxHealth = 100
Config.RegenDelay = 5 -- secondes sans dégâts avant la régénération
Config.RegenPerSecond = 25
Config.HealOnKill = 25
Config.KillCreditWindow = 10 -- le dernier attaquant reçoit le kill pendant X s
Config.AssistWindow = 8
Config.RespawnTime = 4 -- inclut la killcam
Config.SpawnProtection = 2.5 -- ForceField au spawn (retiré dès que le joueur tire)
Config.LongshotDistance = 120
Config.MultiKillWindow = 4 -- secondes entre deux kills pour un double / triple kill
Config.MultiKillNames = { [2] = "DOUBLE KILL", [3] = "TRIPLE KILL", [4] = "QUADRA KILL", [5] = "CARNAGE" }

-- Validation anti-triche des tirs (côté serveur)
Config.Validation = {
	MaxOriginOffset = 10, -- distance max entre l'origine annoncée et la tête côté serveur
	HitTolerance = 9, -- marge (studs) entre la position touchée annoncée et la pièce côté serveur
	MinDirectionDot = 0.97, -- l'impact doit être dans l'axe du tir annoncé
	FireDelayTolerance = 0.75, -- accepte un tir si l'intervalle >= FireDelay * 0.75 (latence)
}

--------------------------------------------------------------------------
-- Déplacements
--------------------------------------------------------------------------
Config.Movement = {
	WalkSpeed = 16,
	SprintSpeed = 23,
	AdsSpeedScale = 0.6, -- multiplicateur de vitesse en visée
	DashCooldown = 2.5,
	DashPower = 70,
	DashDuration = 0.18,
}

--------------------------------------------------------------------------
-- Caméra (client)
--------------------------------------------------------------------------
Config.Camera = {
	BaseFov = 70,
	SprintFovBonus = 8,
	ShoulderOffset = Vector3.new(1.9, 0.45, 0),
	AdsShoulderOffset = Vector3.new(1.3, 0.35, 0),
	AimPitchSendRate = 10, -- envois par seconde de l'inclinaison de visée
}

--------------------------------------------------------------------------
-- Séries d'éliminations (récompenses activables)
--------------------------------------------------------------------------
Config.Killstreaks = {
	{
		Id = "Radar",
		Name = "RADAR",
		Kills = 4,
		Key = Enum.KeyCode.Three,
		Duration = 10, -- les ennemis sont visibles à travers les murs
		Description = "Révèle tous les ennemis à travers les murs",
	},
	{
		Id = "Orbital",
		Name = "FRAPPE ORBITALE",
		Kills = 8,
		Key = Enum.KeyCode.Four,
		Delay = 2.5, -- délai entre le marquage et l'impact
		Radius = 22,
		Damage = 250,
		MaxDistance = 600, -- distance max de la cible depuis le joueur
		Description = "Un rayon venu du ciel pulvérise la zone ciblée",
	},
}

-- Le joueur avec une grosse série devient une « cible » visible de tous.
Config.Bounty = {
	MinStreak = 5,
}

Config.StreakMessages = {
	[3] = "%s est en série de 3 ! 🔥",
	[5] = "%s est INARRÊTABLE ! (5) ⚡ — prime sur sa tête",
	[10] = "%s est LÉGENDAIRE ! (10) 👑",
	[15] = "%s domine l'arène ! (15) 💀",
	[25] = "%s est un DIEU ! (25) 🌌",
}

--------------------------------------------------------------------------
-- Récompense quotidienne (augmente chaque jour consécutif)
--------------------------------------------------------------------------
Config.DailyRewardCooldown = 20 * 3600
Config.DailyStreakReset = 48 * 3600
Config.DailyRewards = { 100, 150, 200, 300, 400, 600, 1000 }

--------------------------------------------------------------------------
-- Monétisation / badges (mets tes IDs, 0 = désactivé)
--------------------------------------------------------------------------
Config.VipGamepassId = 0
Config.VipCoinMultiplier = 2
Config.Badges = {
	FirstKill = 0,
	Streak10 = 0,
	Level10 = 0,
	Orbital = 0,
}

--------------------------------------------------------------------------
-- Sauvegarde
--------------------------------------------------------------------------
Config.DataStoreName = "ArenaClash_PlayerData_v2"
Config.LeaderboardStoreName = "ArenaClash_Kills_v2"
Config.AutosaveInterval = 120
Config.LeaderboardRefresh = 60

-- Paramètres joueur par défaut (sauvegardés)
Config.DefaultSettings = {
	Sensitivity = 1, -- 0.2 .. 3
	AdsSensitivity = 0.6, -- 0.2 .. 1.5 (multiplicateur en visée)
	Fov = 70, -- 60 .. 100
	DamageNumbers = true,
	CameraShake = true,
}

--------------------------------------------------------------------------
-- Sons. Une chaîne vide = son désactivé (le code doit l'ignorer proprement).
-- Mets des rbxassetid:// publics (Creator Store, audio créé par Roblox).
--------------------------------------------------------------------------
Config.Sounds = {
	Weapons = {
		Pistol = "",
		Magnum = "",
		SMG = "",
		Shotgun = "",
		Rifle = "",
		Sniper = "",
		LMG = "",
	},
	Reload = "",
	Empty = "",
	Equip = "rbxasset://sounds/unsheath.wav",
	Hitmarker = "",
	Headshot = "",
	Kill = "",
	LevelUp = "",
	Orbital = "",
	OrbitalCharge = "",
	Radar = "",
	Ui = "rbxasset://sounds/electronicpingshort.wav",
}

--------------------------------------------------------------------------
-- Couleurs de l'interface
--------------------------------------------------------------------------
Config.Colors = {
	Accent = Color3.fromRGB(0, 200, 255),
	Accent2 = Color3.fromRGB(255, 60, 140),
	Gold = Color3.fromRGB(255, 196, 60),
	Good = Color3.fromRGB(80, 220, 120),
	Bad = Color3.fromRGB(255, 70, 70),
	Headshot = Color3.fromRGB(255, 70, 70),
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GunBuilder</string>
          <string name="Source"><![CDATA[-- GunBuilder : modèles 3D procéduraux des 8 armes à feu (aucun mesh, aucun asset id).
-- Utilisé par le serveur (Tools donnés dans le Backpack) ET par le client (aperçus 3D en ViewportFrame).
--
-- Repère commun à toutes les armes (= repère de la main droite, Tool.Grip = CFrame.new()) :
--   origine = centre de la poignée pistolet (là où se referme la main droite)
--   -Z = vers l'avant (canon)   +Y = haut   +X = côté droit (fenêtre d'éjection)
-- Échelle « réaliste » par rapport à un personnage R15 (~5,5 studs) :
--   pistolet ~1,1 stud, UZI ~1,6, fusil d'assaut ~3,2, pompe ~3,4, M249 ~3,8, sniper ~4,6.
--
-- Chaque arme est décrite par une TABLE DE PIÈCES (nom, taille, position relative à la poignée,
-- style = couleur + matériau, camo oui/non) : pour retoucher un modèle, il suffit de modifier
-- les chiffres dans `Definitions` plus bas.
--
-- API publique :
--   GunBuilder.BuildModel(weaponId, camoId?)  -> Model (PrimaryPart = Handle)
--   GunBuilder.BuildTool(weaponId, camoId?)   -> Tool prêt à mettre dans le Backpack
--   GunBuilder.ApplyCamo(container, camoId?)  -> recolore les pièces Camo = true
--   GunBuilder.GetModelLength(weaponId)       -> longueur approximative (studs), pour cadrer un aperçu

local CollectionService = game:GetService("CollectionService")

local Weapons = require(script.Parent.Weapons)
local Camos = require(script.Parent.Camos)

local GunBuilder = {}

local ANIMATED_TAG = "AnimatedCamo"
local FALLBACK_WEAPON = "M1911"

local V3 = Vector3.new
local CF = CFrame.new
local rad = math.rad
local PI = math.pi

-- Un cylindre Roblox a son axe sur X local : ces rotations l'alignent sur un autre axe.
local ALONG_Z = CFrame.Angles(0, rad(90), 0) -- canons, tubes, lunette
local ALONG_Y = CFrame.Angles(0, 0, rad(90)) -- tourelles, poignée avant verticale

--------------------------------------------------------------------------
-- Styles (couleur + matériau). Les pièces « corps » prennent le camo par-dessus.
--------------------------------------------------------------------------
local Styles = {
	Hidden = { Color = Color3.fromRGB(40, 40, 44), Material = Enum.Material.SmoothPlastic, Transparency = 1 },
	Blued = { Color = Color3.fromRGB(38, 40, 46), Material = Enum.Material.Metal, Reflectance = 0.05 },
	Gunmetal = { Color = Color3.fromRGB(54, 56, 62), Material = Enum.Material.Metal, Reflectance = 0.03 },
	Anodized = { Color = Color3.fromRGB(46, 47, 52), Material = Enum.Material.Metal, Reflectance = 0.02 },
	DarkSteel = { Color = Color3.fromRGB(64, 66, 72), Material = Enum.Material.Metal, Reflectance = 0.04 },
	Steel = { Color = Color3.fromRGB(140, 143, 150), Material = Enum.Material.Metal, Reflectance = 0.1 },
	Stainless = { Color = Color3.fromRGB(184, 188, 196), Material = Enum.Material.Metal, Reflectance = 0.15 },
	Polymer = { Color = Color3.fromRGB(31, 32, 36), Material = Enum.Material.SmoothPlastic },
	Rubber = { Color = Color3.fromRGB(21, 21, 23), Material = Enum.Material.SmoothPlastic },
	Knurl = { Color = Color3.fromRGB(42, 43, 47), Material = Enum.Material.DiamondPlate },
	Rail = { Color = Color3.fromRGB(35, 36, 41), Material = Enum.Material.DiamondPlate },
	Optic = { Color = Color3.fromRGB(27, 28, 32), Material = Enum.Material.Metal, Reflectance = 0.02 },
	Wood = { Color = Color3.fromRGB(136, 74, 38), Material = Enum.Material.Wood },
	DarkWood = { Color = Color3.fromRGB(86, 45, 24), Material = Enum.Material.Wood },
	Walnut = { Color = Color3.fromRGB(112, 60, 32), Material = Enum.Material.WoodPlanks },
	Tan = { Color = Color3.fromRGB(158, 134, 98), Material = Enum.Material.SmoothPlastic },
	Coyote = { Color = Color3.fromRGB(120, 104, 78), Material = Enum.Material.SmoothPlastic },
	OliveDrab = { Color = Color3.fromRGB(82, 88, 56), Material = Enum.Material.Fabric },
	OliveDark = { Color = Color3.fromRGB(62, 68, 42), Material = Enum.Material.Fabric },
	Brass = { Color = Color3.fromRGB(214, 168, 74), Material = Enum.Material.Metal, Reflectance = 0.2 },
	ShellRed = { Color = Color3.fromRGB(172, 30, 34), Material = Enum.Material.SmoothPlastic },
	Hole = { Color = Color3.fromRGB(9, 9, 11), Material = Enum.Material.SmoothPlastic },
	Lens = { Color = Color3.fromRGB(70, 150, 255), Material = Enum.Material.Glass, Reflectance = 0.4, Transparency = 0.25 },
	GlassClear = { Color = Color3.fromRGB(180, 225, 255), Material = Enum.Material.Glass, Reflectance = 0.1, Transparency = 0.65 },
	NeonGreen = { Color = Color3.fromRGB(80, 255, 120), Material = Enum.Material.Neon },
	NeonRed = { Color = Color3.fromRGB(255, 45, 60), Material = Enum.Material.Neon },
	NeonOrange = { Color = Color3.fromRGB(255, 150, 40), Material = Enum.Material.Neon },
}

--------------------------------------------------------------------------
-- Constructeurs de pièces (renvoient une « spec », pas encore d'Instance)
--------------------------------------------------------------------------
type Spec = {
	Name: string,
	Kind: string, -- "Block" | "Cylinder" | "Ball" | "Wedge"
	Size: Vector3,
	CFrame: CFrame, -- relatif à la poignée (Handle = CFrame.new())
	Style: string,
	Camo: boolean,
}

local function toCFrame(where: any): CFrame
	if typeof(where) == "Vector3" then
		return CFrame.new(where)
	end
	return where
end

-- Bloc
local function Box(name: string, size: Vector3, where: any, style: string, camo: boolean?): Spec
	return { Name = name, Kind = "Block", Size = size, CFrame = toCFrame(where), Style = style, Camo = camo == true }
end

-- Cylindre couché le long du canon (axe Z)
local function Tube(name: string, length: number, diameter: number, where: any, style: string, camo: boolean?): Spec
	return {
		Name = name,
		Kind = "Cylinder",
		Size = V3(length, diameter, diameter),
		CFrame = toCFrame(where) * ALONG_Z,
		Style = style,
		Camo = camo == true,
	}
end

-- Cylindre vertical (axe Y)
local function Post(name: string, length: number, diameter: number, where: any, style: string, camo: boolean?): Spec
	return {
		Name = name,
		Kind = "Cylinder",
		Size = V3(length, diameter, diameter),
		CFrame = toCFrame(where) * ALONG_Y,
		Style = style,
		Camo = camo == true,
	}
end

-- Cylindre transversal (axe X : goupilles, molettes latérales)
local function Pin(name: string, length: number, diameter: number, where: any, style: string, camo: boolean?): Spec
	return {
		Name = name,
		Kind = "Cylinder",
		Size = V3(length, diameter, diameter),
		CFrame = toCFrame(where),
		Style = style,
		Camo = camo == true,
	}
end

-- Sphère
local function Ball(name: string, diameter: number, where: any, style: string, camo: boolean?): Spec
	return {
		Name = name,
		Kind = "Ball",
		Size = V3(diameter, diameter, diameter),
		CFrame = toCFrame(where),
		Style = style,
		Camo = camo == true,
	}
end

-- Biseau (WedgePart) : par défaut, face haute à l'arrière (+Z) et pente qui descend vers l'avant (-Z).
--   * CFrame.Angles(0, PI, 0) : rampe qui monte vers l'avant (guidon)
--   * CFrame.Angles(0, 0, PI) : dessus plat, pente vers le bas-avant (dessous de crosse)
--   * CFrame.Angles(PI, 0, 0) : dessus plat, haut à l'avant, pente vers le bas-arrière
local function Wedge(name: string, size: Vector3, where: any, style: string, camo: boolean?): Spec
	return { Name = name, Kind = "Wedge", Size = size, CFrame = toCFrame(where), Style = style, Camo = camo == true }
end

-- Barre rectangulaire tendue entre deux points (montants, entretoises)
local function Strut(name: string, p0: Vector3, p1: Vector3, width: number, height: number, style: string, camo: boolean?): Spec
	local offset = p1 - p0
	local up = if math.abs(offset.Unit.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis
	local cframe = CFrame.lookAt((p0 + p1) / 2, p1, up)
	return Box(name, V3(width, height, offset.Magnitude), cframe, style, camo)
end

-- Repère incliné d'une poignée pistolet : le haut part vers l'avant, le bas recule.
local function GripFrame(angleDeg: number, offset: Vector3): CFrame
	return CF(offset) * CFrame.Angles(rad(-angleDeg), 0, 0)
end

-- Chargeur (droit ou courbe « banane ») : segments empilés, chacun incliné de `stepDeg` vers l'avant.
-- Pièces : "Magazine", "Magazine2", ... + "MagazineBase".
local function Magazine(
	top: Vector3,
	width: number,
	depth: number,
	segment: number,
	count: number,
	stepDeg: number,
	style: string,
	baseStyle: string,
	camo: boolean?
): { Spec }
	local list = {}
	local frame = CF(top)
	for index = 1, count do
		if index > 1 then
			frame = frame * CFrame.Angles(rad(stepDeg), 0, 0)
		end
		local name = if index == 1 then "Magazine" else "Magazine" .. index
		-- +0.03 de hauteur : les segments se chevauchent pour masquer les jointures dans les courbes
		table.insert(list, Box(name, V3(width, segment + 0.03, depth), frame * CF(0, -segment / 2, 0), style, camo))
		frame = frame * CF(0, -segment, 0)
	end
	table.insert(list, Box("MagazineBase", V3(width + 0.015, 0.03, depth + 0.015), frame * CF(0, -0.01, 0), baseStyle, false))
	return list
end

--------------------------------------------------------------------------
-- Repères de la main gauche (Attachment "LeftGrip" = cible d'un IKControl de type Transform :
-- la LeftHand R15 vient se caler sur ce repère, position ET orientation).
-- Au repos, la main R15 a : paume vers +X, poignet vers +Y, pouce vers -Z.
--------------------------------------------------------------------------
local PALM_UP = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, Vector3.zAxis, Vector3.xAxis)

-- Main sous le garde-main : paume vers le haut, doigts vers l'avant, avant-bras vers l'arrière-bas-gauche.
local function SupportHand(position: Vector3): CFrame
	return CF(position) * CFrame.Angles(0, rad(-25), 0) * CFrame.Angles(rad(20), 0, 0) * PALM_UP
end

-- Main sur une poignée avant verticale : paume vers la poignée (+X), pouce en haut.
local function ForegripHand(position: Vector3): CFrame
	return CF(position) * CFrame.Angles(0, rad(-20), 0) * CFrame.Angles(rad(105), 0, 0)
end

-- Main d'appui au pistolet (prise à deux mains) : doigts vers l'avant, paume vers la main droite.
local function PistolHand(position: Vector3): CFrame
	return CF(position) * CFrame.Angles(0, rad(-20), 0) * CFrame.Angles(0, 0, rad(20)) * CFrame.Angles(rad(90), 0, 0)
end

--------------------------------------------------------------------------
-- Définitions des armes
-- HandleSize : la poignée invisible (pièce "Handle" au repère identité, tenue par la main droite).
-- Parts : la liste des pièces visibles (les sous-listes sont aplaties automatiquement).
-- Muzzle / Eject : { Part, Position } (orientation = celle de l'arme : -Z avant, +X droite, +Y haut).
-- LeftGrip : { Part, CFrame } (repère complet de la main gauche).
--------------------------------------------------------------------------
local Definitions = {}

