		Scope = false,
		SpeedScale = 0.86,
		Sound = "LMG",
		TracerColor = Color3.fromRGB(255, 120, 80),
	},
}

Weapons.ById = {}
for index, weapon in Weapons.List do
	weapon.Order = index
	Weapons.ById[weapon.Id] = weapon
end

-- Équipement de départ (gratuit)
Weapons.DefaultPrimary = "UZI"
Weapons.DefaultSecondary = "M1911"

return Weapons
]]></string>
