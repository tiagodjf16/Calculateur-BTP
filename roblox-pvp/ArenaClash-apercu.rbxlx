  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Point d'entrée serveur : génère la map puis démarre les services dans l'ordre.
local Players = game:GetService("Players")

-- On contrôle nous-mêmes l'apparition : le joueur apparaît après « JOUER » dans le menu (remote Deploy).
Players.CharacterAutoLoads = false

local Services = script.Parent:WaitForChild("Services")
local MapService = require(Services.MapService)
local DataService = require(Services.DataService)
local SpawnService = require(Services.SpawnService)
local WeaponService = require(Services.WeaponService)
local CombatService = require(Services.CombatService)
local ShopService = require(Services.ShopService)
local LeaderboardService = require(Services.LeaderboardService)

-- Aperçu visible seulement dans l'éditeur Studio (map pré-générée + panneau « Clique sur Play ») :
-- on le retire, la vraie map est générée juste après.
local editorPreview = workspace:FindFirstChild("ApercuEditeur")
if editorPreview then
	editorPreview:Destroy()
end

local ok, err = pcall(MapService.Build)
if not ok then
	warn("[Main] Génération de la map échouée : " .. tostring(err))
end

DataService.Init()
SpawnService.Init()
WeaponService.Init()
CombatService.Init()
ShopService.Init()
LeaderboardService.Init()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[-- Dégâts, morts, crédit des kills, assistances, score/XP/pièces, médailles, séries, primes,
-- récompenses de série (Radar, Frappe orbitale), régénération, killcam, kill feed et badges.
local BadgeService = game:GetService("BadgeService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Camos = require(Shared.Camos)
local Ballistics = require(Shared.Ballistics)
local DataService = require(script.Parent.DataService)
local SpawnService = require(script.Parent.SpawnService)

local CombatService = {}

local ORBITAL_ID = "Orbital"
local RADAR_ID = "Radar"
local REGEN_TICK = 0.1
local MAX_DAMAGE = 10000
local MAX_COORD = 1e5
local USE_REWARD_COOLDOWN = 0.5
local STREAK_ENDED_MIN = 3 -- série minimale de la victime pour « SÉRIE STOPPÉE »

local streaks = {} -- [Player] = série actuelle
local rewards = {} -- [Player] = { [rewardId] = true }
local multiKills = {} -- [Player] = { Time: number, Count: number }
local lastKillerOf = {} -- [Player] = Player : dernier joueur à l'avoir tué (vengeance)
local lastRewardUse = {} -- [Player] = os.clock()
local hitLogs = setmetatable({}, { __mode = "k" }) -- [Humanoid] = journal des attaquants
local lastDamage = setmetatable({}, { __mode = "k" }) -- [Humanoid] = os.clock() du dernier dégât
local firstBloodDone = false -- premier kill depuis le démarrage du serveur

local killstreaksById = {}
for _, definition in Config.Killstreaks do
	killstreaksById[definition.Id] = definition
end

-- Nom de multi-kill le plus élevé défini (utilisé au-delà de la liste).
local maxMultiKill = 0
for count in Config.MultiKillNames do
	if count > maxMultiKill then
		maxMultiKill = count
	end
end

--------------------------------------------------------------------------
-- Utilitaires
--------------------------------------------------------------------------
local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isValidVector(value: any): boolean
	return typeof(value) == "Vector3"
		and isFiniteNumber(value.X)
		and isFiniteNumber(value.Y)
		and isFiniteNumber(value.Z)
		and math.abs(value.X) < MAX_COORD
		and math.abs(value.Y) < MAX_COORD
		and math.abs(value.Z) < MAX_COORD
end

local function inGame(player: Player?): boolean
	return player ~= nil and player.Parent == Players
end

local function getFxFolder(): Folder
	local folder = workspace:FindFirstChild("FX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FX"
		folder.Parent = workspace
	end
	return folder
end

local function removeForceFields(character: Model)
	local forceField = character:FindFirstChildOfClass("ForceField")
	while forceField do
		forceField:Destroy()
		forceField = character:FindFirstChildOfClass("ForceField")
	end
end

local function awardBadge(player: Player, badgeId: number?)
	if not badgeId or badgeId == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, badgeId) then
				BadgeService:AwardBadge(player.UserId, badgeId)
			end
		end)
	end)
end

local function multiKillName(count: number): string
	return Config.MultiKillNames[count] or Config.MultiKillNames[maxMultiKill] or "MULTI-KILL"
end

local function setStreak(player: Player, value: number)
	streaks[player] = value
	if not inGame(player) then
		return
	end
	player:SetAttribute("Streak", value)
	player:SetAttribute("Bounty", value >= Config.Bounty.MinStreak)
	DataService.SetStat(player, "Série", value)
end

local function sendRewards(player: Player)
	if not inGame(player) then
		return
	end
	Remotes.RewardsChanged:FireClient(player, table.clone(rewards[player] or {}), streaks[player] or 0)
end

local function announceLevel(player: Player, level: number, bonus: number)
	Remotes.Announce:FireClient(player, string.format("⭐ NIVEAU %d !", level), Config.Colors.Gold)
	if bonus > 0 then
		Remotes.Toast:FireClient(player, string.format("+%d 💰  bonus de niveau", bonus))
	end
	if level >= 10 then
		awardBadge(player, Config.Badges.Level10)
	end
end

--------------------------------------------------------------------------
-- Dégâts
--------------------------------------------------------------------------
-- Inflige des dégâts validés. info = { WeaponId, Headshot, Distance, Position (point d'impact), Origin (provenance) }.
-- Retourne (dégâts infligés, tué ?). Ignoré si la cible a un ForceField.
function CombatService.ApplyDamage(attacker: Player?, humanoid: Humanoid, damage: number, info: any?): (number, boolean)
	if typeof(humanoid) ~= "Instance" or not humanoid:IsA("Humanoid") or humanoid.Health <= 0 then
		return 0, false
	end
	if not isFiniteNumber(damage) or damage <= 0 then
		return 0, false
	end
	damage = math.min(damage, MAX_DAMAGE)

	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return 0, false
	end
	if attacker and attacker.Character == character then
		return 0, false
	end
	if character:FindFirstChildOfClass("ForceField") then
		return 0, false
	end

	local details = if type(info) == "table" then info else {}
	local weaponId = if type(details.WeaponId) == "string" then details.WeaponId else nil
	local headshot = details.Headshot == true
	local distance = if isFiniteNumber(details.Distance) then details.Distance else 0

	-- On enregistre l'attaquant AVANT les dégâts : Died peut se déclencher tout de suite.
	local now = os.clock()
	if attacker then
		local log = hitLogs[humanoid]
		if not log then
			log = { Contributors = {} }
			hitLogs[humanoid] = log
		end
		log.Attacker = attacker
		log.Time = now
		log.WeaponId = weaponId
		log.Headshot = headshot
		log.Distance = distance
		log.Contributors[attacker] = now
	end
	lastDamage[humanoid] = now

	humanoid:TakeDamage(damage)
	local killed = humanoid.Health <= 0
	local shown = math.floor(damage + 0.5)

	local root = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	local hitPosition = if typeof(details.Position) == "Vector3"
		then details.Position
		elseif head and head:IsA("BasePart") then head.Position
		elseif root and root:IsA("BasePart") then root.Position
		else nil

	if attacker and inGame(attacker) and hitPosition then
		Remotes.HitConfirm:FireClient(attacker, hitPosition, shown, headshot, killed)
	end

	local victim = Players:GetPlayerFromCharacter(character)
	if victim then
		local from = if typeof(details.Origin) == "Vector3" then details.Origin else nil
		if not from and attacker then
			local attackerCharacter = attacker.Character
			local attackerRoot = attackerCharacter and attackerCharacter:FindFirstChild("HumanoidRootPart")
			if attackerRoot and attackerRoot:IsA("BasePart") then
				from = attackerRoot.Position
			end
		end
		Remotes.DamageTaken:FireClient(victim, from or hitPosition or Vector3.zero, shown)
	end

	return damage, killed
end

--------------------------------------------------------------------------
-- Récompenses d'un kill
--------------------------------------------------------------------------
local function rewardAssist(helper: Player)
	local event = Config.ScoreEvents.Assist
	if not event or not DataService.Get(helper) then
		return
	end
	local coins = math.floor(event.Coins * DataService.GetCoinMultiplier(helper) + 0.5)
	Remotes.Score:FireClient(helper, event.Label, event.Xp)
	DataService.Update(helper, function(data)
		data.Coins += coins
	end)
	local levels, level, bonus = DataService.AddXp(helper, event.Xp)
	if coins > 0 then
		Remotes.Toast:FireClient(helper, string.format("+%d 💰", coins))
	end
	if levels > 0 then
		announceLevel(helper, level, bonus)
	end
end

local function rewardKiller(killer: Player, victim: Player, victimStreak: number, weaponId: string?, headshot: boolean, distance: number, now: number)
	local newStreak = (streaks[killer] or 0) + 1
	setStreak(killer, newStreak)

	-- Événements de score, dans l'ordre d'affichage.
	local events = {}
	local medals = {}
	local function addEvent(key: string)
		local event = Config.ScoreEvents[key]
		if event then
			table.insert(events, event)
		end
	end
	local function addMedal(title: string, subtitle: string?)
		table.insert(medals, { Title = title, Subtitle = subtitle })
	end

	addEvent("Kill")
	if headshot then
		addEvent("Headshot")
	end

	local firstBlood = false
	if not firstBloodDone then
		firstBloodDone = true
		firstBlood = true
		addEvent("FirstBlood")
		addMedal("PREMIER SANG", "Première élimination de la partie")
	end

	if lastKillerOf[killer] == victim then
		lastKillerOf[killer] = nil
		addEvent("Revenge")
		addMedal("VENGEANCE", victim.DisplayName)
	end

	if weaponId ~= ORBITAL_ID and distance >= Config.LongshotDistance then
		addEvent("Longshot")
		addMedal("LONGUE DISTANCE", string.format("%d studs", math.floor(distance + 0.5)))
	end

	local chain = multiKills[killer]
	if chain and now - chain.Time <= Config.MultiKillWindow then
		chain.Count += 1
		chain.Time = now
	else
		chain = { Time = now, Count = 1 }
		multiKills[killer] = chain
	end
	if chain.Count >= 2 then
		addEvent("MultiKill")
		addMedal(multiKillName(chain.Count), nil)
	end

	local bountyKill = victimStreak >= Config.Bounty.MinStreak
	if bountyKill then
		addEvent("BountyKill")
		addMedal("CIBLE ABATTUE", string.format("%s (série de %d)", victim.DisplayName, victimStreak))
	elseif victimStreak >= STREAK_ENDED_MIN then
		addEvent("StreakEnded")
		addMedal("SÉRIE STOPPÉE", string.format("Série de %d de %s", victimStreak, victim.DisplayName))
	end

	lastKillerOf[victim] = killer

	-- Score + total XP / pièces
	local xp, coins = 0, 0
	for _, event in events do
		Remotes.Score:FireClient(killer, event.Label, event.Xp)
		xp += event.Xp
		coins += event.Coins
	end
	coins += victimStreak * Config.StreakBountyPerKill
	coins = math.floor(coins * DataService.GetCoinMultiplier(killer) + 0.5)

	for _, medal in medals do
		Remotes.Medal:FireClient(killer, medal.Title, medal.Subtitle)
	end

	-- Données : kills, pièces, série record, stats d'arme
	local totalKills = 0
	local unlockedCamo = nil
	DataService.Update(killer, function(data)
		data.Kills += 1
		data.Coins += coins
		data.BestStreak = math.max(data.BestStreak, newStreak)
		if headshot then
			data.Headshots += 1
		end
		if weaponId and weaponId ~= ORBITAL_ID and Weapons.ById[weaponId] then
			local kills = (data.WeaponKills[weaponId] or 0) + 1
			data.WeaponKills[weaponId] = kills
			for _, camo in Camos.List do
				if camo.Kills > 0 and camo.Kills == kills then
					unlockedCamo = camo
				end
			end
		end
		totalKills = data.Kills
	end)
	local levels, level, bonus = DataService.AddXp(killer, xp)

	if coins > 0 then
		Remotes.Toast:FireClient(killer, string.format("+%d 💰", coins))
	end
	if unlockedCamo and weaponId then
		local weapon = Weapons.ById[weaponId]
		Remotes.Medal:FireClient(killer, "CAMO DÉBLOQUÉ", string.format("%s • %s", unlockedCamo.Name, weapon.Name))
	end
	if levels > 0 then
		announceLevel(killer, level, bonus)
	end

	-- Soin au kill
	local killerHumanoid = SpawnService.GetAliveHumanoid(killer)
	if killerHumanoid then
		killerHumanoid.Health = math.min(killerHumanoid.MaxHealth, killerHumanoid.Health + Config.HealOnKill)
	end

	-- Annonces globales
	if firstBlood then
		Remotes.Announce:FireAllClients(string.format("🩸 %s signe le PREMIER SANG !", killer.DisplayName), Config.Colors.Bad)
	end
	if bountyKill then
		Remotes.Announce:FireAllClients(
			string.format("🎯 %s a abattu la cible %s !", killer.DisplayName, victim.DisplayName),
			Config.Colors.Gold
		)
	end
	local message = Config.StreakMessages[newStreak]
	if message then
		Remotes.Announce:FireAllClients(string.format(message, killer.DisplayName), Config.Colors.Accent2)
	end

	-- Récompenses de série (gagnées en atteignant exactement le nombre de kills requis)
	for _, definition in Config.Killstreaks do
		if newStreak == definition.Kills then
			local available = rewards[killer]
			if not available then
				available = {}
				rewards[killer] = available
			end
			available[definition.Id] = true
			Remotes.Medal:FireClient(killer, definition.Name .. " PRÊT", definition.Description)
		end
	end
	sendRewards(killer)

	-- Badges
	if totalKills == 1 then
		awardBadge(killer, Config.Badges.FirstKill)
	end
	if newStreak >= 10 then
		awardBadge(killer, Config.Badges.Streak10)
	end
end

--------------------------------------------------------------------------
-- Mort
--------------------------------------------------------------------------
local function processDeath(victim: Player, humanoid: Humanoid)
	local log = hitLogs[humanoid]
	hitLogs[humanoid] = nil
	lastDamage[humanoid] = nil
	if not inGame(victim) then
		-- personnage détruit parce que le joueur quitte : pas une vraie mort
		return
	end
	local now = os.clock()

	local victimStreak = streaks[victim] or 0
	setStreak(victim, 0)
	multiKills[victim] = nil
	sendRewards(victim)
	DataService.Update(victim, function(data)
		data.Deaths += 1
	end)

	local killer = log and log.Attacker
	if killer and (killer == victim or not inGame(killer) or now - log.Time > Config.KillCreditWindow) then
		killer = nil
	end
	local weaponId = if killer and log then log.WeaponId else nil
	local headshot = killer ~= nil and log ~= nil and log.Headshot == true
	local distance = if killer and log then log.Distance or 0 else 0

	Remotes.KillFeed:FireAllClients(if killer then killer.DisplayName else nil, victim.DisplayName, weaponId, headshot)

	-- Killcam : santé du tueur au moment du kill (avant le soin)
	local killerHealth = nil
	if killer then
		local killerHumanoid = SpawnService.GetAliveHumanoid(killer)
		killerHealth = if killerHumanoid then math.ceil(killerHumanoid.Health) else 0
	end
	if inGame(victim) then
		Remotes.Killcam:FireClient(victim, killer, weaponId, killerHealth, Config.RespawnTime)
	end

	if killer then
		rewardKiller(killer, victim, victimStreak, weaponId, headshot, distance, now)
	end

	-- Assistances
	if log then
		for helper, hitTime in log.Contributors do
			if helper ~= killer and helper ~= victim and inGame(helper) and now - hitTime <= Config.AssistWindow then
				rewardAssist(helper)
			end
		end
	end
end

--------------------------------------------------------------------------
-- Récompenses de série
--------------------------------------------------------------------------
local function strikeOrbital(owner: Player, definition, target: Vector3)
	local credit = if inGame(owner) then owner else nil

	local explosion = Instance.new("Explosion")
	explosion.Position = target
	explosion.BlastRadius = definition.Radius
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = getFxFolder()
	Debris:AddItem(explosion, 3)

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Ballistics.GetIgnoreList()

	local ownerCharacter = owner.Character
	local hit = {}
	for _, part in workspace:GetPartBoundsInRadius(target, definition.Radius, params) do
		local humanoid, model = Ballistics.GetHumanoid(part)
		if humanoid and model and not hit[humanoid] and model ~= ownerCharacter and humanoid.Health > 0 then
			hit[humanoid] = true
			local root = model:FindFirstChild("HumanoidRootPart")
			local position = if root and root:IsA("BasePart") then root.Position else part.Position
			CombatService.ApplyDamage(credit, humanoid, definition.Damage, {
				WeaponId = ORBITAL_ID,
				Headshot = false,
				Distance = 0,
				Position = position + Vector3.new(0, 2, 0),
				Origin = target,
			})
		end
	end
end

local function onUseReward(player: Player, rewardId: any, target: any)
	if type(rewardId) ~= "string" then
		return
	end
	local definition = killstreaksById[rewardId]
	local available = rewards[player]
	if not definition or not available or not available[rewardId] then
		return
	end
	local now = os.clock()
	if now - (lastRewardUse[player] or -math.huge) < USE_REWARD_COOLDOWN then
		return
	end
	local humanoid, character = SpawnService.GetAliveHumanoid(player)
	if not humanoid or not character then
		return
	end

	if rewardId == RADAR_ID then
		available[rewardId] = nil
		lastRewardUse[player] = now
		removeForceFields(character)
		Remotes.RewardFx:FireClient(player, RADAR_ID, player, nil, definition.Duration)
		sendRewards(player)
	elseif rewardId == ORBITAL_ID then
		if not isValidVector(target) then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		if (target - root.Position).Magnitude > definition.MaxDistance then
			return
		end
		available[rewardId] = nil
		lastRewardUse[player] = now
		removeForceFields(character)
		sendRewards(player)

		Remotes.RewardFx:FireAllClients(ORBITAL_ID, player, target, definition.Delay)
		Remotes.Announce:FireAllClients(
			string.format("☄️ %s a déclenché une FRAPPE ORBITALE !", player.DisplayName),
			Config.Colors.Bad
		)
		awardBadge(player, Config.Badges.Orbital)

		-- Si le propriétaire quitte pendant le délai, la frappe tombe quand même (sans crédit).
		task.delay(definition.Delay, strikeOrbital, player, definition, target)
	end
end

-- Récompenses de série disponibles d'un joueur (copie).
function CombatService.GetRewards(player: Player): { [string]: boolean }
	return table.clone(rewards[player] or {})
end

function CombatService.GetStreak(player: Player): number
	return streaks[player] or 0
end

--------------------------------------------------------------------------
-- Régénération
--------------------------------------------------------------------------
local function regenLoop()
	while true do
		local dt = task.wait(REGEN_TICK)
		local now = os.clock()
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
				local last = lastDamage[humanoid]
				if not last or now - last >= Config.RegenDelay then
					humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.RegenPerSecond * dt)
				end
			end
		end
	end
end

--------------------------------------------------------------------------
-- Initialisation
--------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	rewards[player] = rewards[player] or {}
	setStreak(player, streaks[player] or 0)
	player:SetAttribute("Bounty", false)
end

function CombatService.Init()
	getFxFolder()

	SpawnService.OnSpawned(function(player, _character, humanoid)
		lastDamage[humanoid] = nil
		hitLogs[humanoid] = nil
		humanoid.Died:Once(function()
			processDeath(player, humanoid)
		end)
	end)

	Remotes.UseReward.OnServerEvent:Connect(onUseReward)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		streaks[player] = nil
		rewards[player] = nil -- les récompenses non utilisées sont perdues en quittant
		multiKills[player] = nil
		lastRewardUse[player] = nil
		lastKillerOf[player] = nil
		for other, killer in lastKillerOf do
			if killer == player then
				lastKillerOf[other] = nil
			end
		end
	end)

	task.spawn(regenLoop)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Chargement / sauvegarde des données joueurs + leaderstats + VIP.
-- Toutes les données reçues (DataStore ou client) sont nettoyées avant usage.
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Camos = require(Shared.Camos)

local DataService = {}

local STARTING_COINS = 0
local SAVE_WAIT_LIMIT = 30 -- secondes max d'attente d'une sauvegarde déjà en cours
local SHUTDOWN_WAIT_LIMIT = 25

-- Bornes des paramètres numériques (voir Config.DefaultSettings).
local SETTING_RANGES = {
	Sensitivity = { 0.2, 3 },
	AdsSensitivity = { 0.2, 1.5 },
	Fov = { 60, 100 },
}

local COUNTER_KEYS = { "Coins", "Kills", "Deaths", "Headshots", "Xp", "BestStreak", "LastDaily", "DailyStreak" }
local SLOTS = { "Primary", "Secondary" }

local profiles = {} -- [Player] = données
local noSave = {} -- [Player] = true : progression temporaire (Studio sans accès API)
local loading = {} -- [Player] = true pendant le chargement
local syncQueued = {} -- [Player] = true : synchro différée en attente
local saving = {} -- [userId] = true pendant une écriture
local savedKills = {} -- [userId] = dernier total de kills écrit dans le classement
local pendingSaves = 0
local loadedCallbacks = {}

--------------------------------------------------------------------------
-- Utilitaires
--------------------------------------------------------------------------
local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function getStore(name: string, ordered: boolean)
	local ok, store = pcall(function()
		if ordered then
			return DataStoreService:GetOrderedDataStore(name)
		end
		return DataStoreService:GetDataStore(name)
	end)
	if not ok then
		warn("[DataService] DataStore indisponible (" .. name .. ") : " .. tostring(store))
		return nil
	end
	return store
end

local store = getStore(Config.DataStoreName, false)
local killsStore = getStore(Config.LeaderboardStoreName, true)

-- En Studio on n'insiste pas : une place non publiée n'a jamais accès aux DataStores.
local MAX_ATTEMPTS = if RunService:IsStudio() then 1 else 3

local function withRetries(callback)
	local lastError
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < MAX_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

local function keyFor(userId: number): string
	return "Player_" .. userId
end

--------------------------------------------------------------------------
-- Données par défaut + nettoyage
--------------------------------------------------------------------------
local function defaultData()
	return {
		Coins = STARTING_COINS,
		Kills = 0,
		Deaths = 0,
		Headshots = 0,
		Xp = 0,
		Level = 1,
		BestStreak = 0,
		Owned = { [Weapons.DefaultPrimary] = true, [Weapons.DefaultSecondary] = true },
		Loadout = { Primary = Weapons.DefaultPrimary, Secondary = Weapons.DefaultSecondary },
		WeaponKills = {},
		Camos = {},
		LastDaily = 0,
		DailyStreak = 0,
		Settings = table.clone(Config.DefaultSettings),
	}
end

-- Nettoie une table de paramètres (venant du client ou du DataStore) :
-- seules les clés de Config.DefaultSettings sont gardées, avec le bon type et bornées.
function DataService.SanitizeSettings(raw: any)
	local source = if type(raw) == "table" then raw else {}
	local clean = {}
	for key, default in Config.DefaultSettings do
		local value = source[key]
		if type(default) == "number" then
			if isFiniteNumber(value) then
				local range = SETTING_RANGES[key]
				if range then
					value = math.clamp(value, range[1], range[2])
				else
					value = math.clamp(value, -1e6, 1e6)
				end
				clean[key] = math.floor(value * 1000 + 0.5) / 1000
			else
				clean[key] = default
			end
		elseif type(value) == type(default) then
			if type(value) == "string" then
				clean[key] = string.sub(value, 1, 64)
			else
				clean[key] = value
			end
		else
			clean[key] = default
		end
	end
	return clean
end

local function sanitizeData(raw: any)
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end

	for _, key in COUNTER_KEYS do
		local value = raw[key]
		if isFiniteNumber(value) then
			data[key] = math.max(0, math.floor(value))
		end
	end
	if isFiniteNumber(raw.Level) then
		data.Level = math.max(1, math.floor(raw.Level))
	end

	if type(raw.Owned) == "table" then
		for weaponId, owned in raw.Owned do
			if owned == true and type(weaponId) == "string" and Weapons.ById[weaponId] then
				data.Owned[weaponId] = true
			end
		end
	end

	if type(raw.WeaponKills) == "table" then
		for weaponId, kills in raw.WeaponKills do
			if type(weaponId) == "string" and Weapons.ById[weaponId] and isFiniteNumber(kills) then
				data.WeaponKills[weaponId] = math.max(0, math.floor(kills))
			end
		end
	end

	if type(raw.Camos) == "table" then
		for weaponId, camoId in raw.Camos do
			if
				type(weaponId) == "string"
				and Weapons.ById[weaponId]
				and type(camoId) == "string"
				and Camos.IsUnlocked(camoId, data.WeaponKills[weaponId] or 0)
			then
				data.Camos[weaponId] = camoId
			end
		end
	end

	if type(raw.Loadout) == "table" then
		for _, slot in SLOTS do
			local weaponId = raw.Loadout[slot]
			local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
			if weapon and weapon.Slot == slot and data.Owned[weaponId] then
				data.Loadout[slot] = weaponId
			end
		end
	end

	data.Settings = DataService.SanitizeSettings(raw.Settings)
	return data
end

-- Temps restant avant la récompense quotidienne + série effective (remise à 0 si trop attendu).
function DataService.GetDailyState(data): (number, number)
	if data.LastDaily <= 0 then
		return 0, 0
	end
	local elapsed = os.time() - data.LastDaily
	local remaining = math.max(0, Config.DailyRewardCooldown - elapsed)
	local streak = if elapsed > Config.DailyStreakReset then 0 else data.DailyStreak
	return remaining, streak
end

--------------------------------------------------------------------------
-- Leaderstats / VIP
--------------------------------------------------------------------------
local function buildLeaderstats(player: Player, data)
	local old = player:FindFirstChild("leaderstats")
	if old then
		old:Destroy()
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local kills = Instance.new("IntValue")
	kills.Name = "Kills"
	kills.Value = data.Kills
	kills.Parent = leaderstats

	local streak = Instance.new("IntValue")
	streak.Name = "Série"
	streak.Value = player:GetAttribute("Streak") or 0
	streak.Parent = leaderstats

	local level = Instance.new("IntValue")
	level.Name = "Niveau"
	level.Value = data.Level
	level.Parent = leaderstats

	leaderstats.Parent = player
end

local function refreshVip(player: Player)
	local vip = false
	if Config.VipGamepassId ~= 0 then
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.VipGamepassId)
		end)
		vip = ok and owns == true
	end
	if player.Parent ~= Players then
		return
	end
	if player:GetAttribute("VIP") ~= vip then
		player:SetAttribute("VIP", vip)
		DataService.QueueSync(player)
	end
end

--------------------------------------------------------------------------
-- API publique
--------------------------------------------------------------------------
function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

-- callback(player) appelé quand les données d'un joueur sont prêtes.
function DataService.OnLoaded(callback: (Player) -> ())
	table.insert(loadedCallbacks, callback)
end

function DataService.SetStat(player: Player, name: string, value: number)
	local leaderstats = player:FindFirstChild("leaderstats")
	local stat = leaderstats and leaderstats:FindFirstChild(name)
	if stat and stat:IsA("IntValue") then
		stat.Value = value
	end
end

function DataService.GetCoinMultiplier(player: Player): number
	return if player:GetAttribute("VIP") == true then Config.VipCoinMultiplier else 1
end

function DataService.Snapshot(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local dailyIn, dailyStreak = DataService.GetDailyState(data)
	return {
		Coins = data.Coins,
		Kills = data.Kills,
		Deaths = data.Deaths,
		Headshots = data.Headshots,
		Xp = data.Xp,
		XpNeeded = Config.XpForLevel(data.Level),
		Level = data.Level,
		BestStreak = data.BestStreak,
		Owned = table.clone(data.Owned),
		Loadout = { Primary = data.Loadout.Primary, Secondary = data.Loadout.Secondary },
		WeaponKills = table.clone(data.WeaponKills),
		Camos = table.clone(data.Camos),
		DailyIn = dailyIn,
		DailyStreak = dailyStreak,
		Vip = player:GetAttribute("VIP") == true,
		Settings = table.clone(data.Settings),
	}
end

-- Envoie immédiatement le snapshot au client + met à jour les leaderstats.
function DataService.Sync(player: Player)
	syncQueued[player] = nil
	local data = profiles[player]
	if not data or player.Parent ~= Players then
		return
	end
	DataService.SetStat(player, "Kills", data.Kills)
	DataService.SetStat(player, "Niveau", data.Level)
	Remotes.DataChanged:FireClient(player, DataService.Snapshot(player))
end

-- Regroupe plusieurs modifications de la même frame en un seul DataChanged.
function DataService.QueueSync(player: Player)
	if syncQueued[player] then
		return
	end
	syncQueued[player] = true
	task.defer(function()
		if syncQueued[player] then
			DataService.Sync(player)
		end
	end)
end

-- Modifie les données via une fonction puis synchronise le client (différé, ou immédiat si demandé).
function DataService.Update(player: Player, mutator: (any) -> (), immediate: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	mutator(data)
	if immediate then
		DataService.Sync(player)
	else
		DataService.QueueSync(player)
	end
	return true
end

-- Ajoute de l'XP et gère les montées de niveau.
-- Retourne (niveaux gagnés, niveau actuel, pièces de bonus de niveau).
function DataService.AddXp(player: Player, amount: number): (number, number, number)
	local data = profiles[player]
	if not data then
		return 0, 1, 0
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return 0, data.Level, 0
	end
	data.Xp += math.floor(amount)
	local gained, bonus = 0, 0
	while data.Xp >= Config.XpForLevel(data.Level) and gained < 100 do
		data.Xp -= Config.XpForLevel(data.Level)
		data.Level += 1
		local coins = Config.LevelUpCoins * data.Level
		data.Coins += coins
		bonus += coins
		gained += 1
	end
	DataService.QueueSync(player)
	return gained, data.Level, bonus
end

--------------------------------------------------------------------------
-- Chargement / sauvegarde
--------------------------------------------------------------------------
function DataService.Load(player: Player)
	if profiles[player] then
		return profiles[player]
	end
	if loading[player] then
		return nil
	end
	loading[player] = true

	local raw = nil
	local temporary = false
	if store then
		local ok, result = withRetries(function()
			return store:GetAsync(keyFor(player.UserId))
		end)
		if ok then
			raw = result
		elseif RunService:IsStudio() then
			warn("[DataService] Pas de sauvegarde en Studio (place non publiée ou accès API désactivé) : progression temporaire.")
			temporary = true
		else
			loading[player] = nil
			if player.Parent == Players then
				player:Kick("Impossible de charger tes données. Réessaie dans un instant !")
			end
			return nil
		end
	else
		warn("[DataService] Aucun DataStore : progression temporaire pour " .. player.Name)
		temporary = true
	end

	loading[player] = nil
	if player.Parent ~= Players then
		return nil
	end

	local data = sanitizeData(raw)
	profiles[player] = data
	if temporary then
		noSave[player] = true
	end
	savedKills[player.UserId] = data.Kills

	if player:GetAttribute("VIP") == nil then
		player:SetAttribute("VIP", false)
	end
	buildLeaderstats(player, data)
	player:SetAttribute("Loaded", true)
	DataService.Sync(player)
	task.spawn(refreshVip, player)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player)
	end
	return data
end

-- Écrit les données (sérialisé par joueur : une seule écriture à la fois).
local function writeData(userId: number, name: string, data)
	if not store then
		return
	end
	pendingSaves += 1

	local waited = 0
	while saving[userId] and waited < SAVE_WAIT_LIMIT do
		waited += task.wait(0.25)
	end
	saving[userId] = true

	local ok, err = withRetries(function()
		store:UpdateAsync(keyFor(userId), function()
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Sauvegarde échouée pour " .. name .. " : " .. tostring(err))
	end

	if killsStore and savedKills[userId] ~= data.Kills then
		local okKills = pcall(function()
			killsStore:SetAsync(tostring(userId), data.Kills)
		end)
		if okKills then
			savedKills[userId] = data.Kills
		end
	end

	saving[userId] = nil
	pendingSaves -= 1
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or noSave[player] then
		return
	end
	writeData(player.UserId, player.Name, data)
end

function DataService.Init()
	Remotes.GetData.OnServerInvoke = function(player)
		return DataService.Snapshot(player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if purchased and Config.VipGamepassId ~= 0 and gamePassId == Config.VipGamepassId then
			player:SetAttribute("VIP", true)
			DataService.QueueSync(player)
		end
	end)

	local function onPlayerAdded(player: Player)
		player:SetAttribute("Loaded", false)
		DataService.Load(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local data = profiles[player]
		local skip = noSave[player]
		profiles[player] = nil
		noSave[player] = nil
		loading[player] = nil
		syncQueued[player] = nil
		if data and not skip then
			writeData(player.UserId, player.Name, data)
		end
		savedKills[player.UserId] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			task.spawn(DataService.Save, player)
		end
		-- laisse aux sauvegardes (y compris celles des joueurs déjà partis) le temps de finir
		task.wait()
		local started = os.clock()
		while pendingSaves > 0 and os.clock() - started < SHUTDOWN_WAIT_LIMIT do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Tableau « Top Kills » global affiché dans l'arène (OrderedDataStore).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local LeaderboardService = {}

local ROWS = 10
local nameCache = {}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok then name else "???"
	nameCache[userId] = result
	return result
end

local function buildGui(board: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.5

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
	background.BackgroundTransparency = 0.1
	background.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.16)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Config.Colors.Gold
	title.Text = "🏆 TOP KILLS"
	title.Parent = background

	local list = Instance.new("Frame")
	list.Position = UDim2.fromScale(0.05, 0.18)
	list.Size = UDim2.fromScale(0.9, 0.8)
	list.BackgroundTransparency = 1
	list.Parent = background

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0.01, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local rows = {}
	for i = 1, ROWS do
		local row = Instance.new("TextLabel")
		row.LayoutOrder = i
		row.Size = UDim2.fromScale(1, 0.09)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(30, 34, 48) else Color3.fromRGB(24, 27, 38)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i == 1
			then Config.Colors.Gold
			elseif i == 2 then Color3.fromRGB(210, 215, 225)
			elseif i == 3 then Color3.fromRGB(215, 140, 80)
			else Color3.new(1, 1, 1)
		row.Text = string.format("  #%d  —", i)
		row.Parent = list
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.2, 0)
		corner.Parent = row
		rows[i] = row
	end

	gui.Parent = board
	return rows
end

function LeaderboardService.Init()
	local arena = workspace:FindFirstChild("Arena")
	local board = arena and arena:FindFirstChild("Leaderboard")
	if not board then
		return
	end

	local rows = buildGui(board)
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if not ok then
		return
	end

	task.spawn(function()
		while true do
			local success, page = pcall(function()
				return store:GetSortedAsync(false, ROWS):GetCurrentPage()
			end)
			if success then
				for i = 1, ROWS do
					local entry = page[i]
					if entry then
						local name = getName(tonumber(entry.key) or 0)
						rows[i].Text = string.format("  #%d  %s  •  %d kills", i, name, entry.value)
					else
						rows[i].Text = string.format("  #%d  —", i)
					end
				end
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Génère une arène prête à jouer + un éclairage soigné.
-- Si tu construis ta propre map, nomme son dossier "Arena" dans Workspace :
-- la génération est alors ignorée (pense à y mettre des SpawnLocation et une part "Leaderboard").
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local MapService = {}

local HALF = 100 -- l'arène fait 200 x 200 studs
local WALL_HEIGHT = 30

local arena: Folder

local function part(props): BasePart
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = p.Parent or arena
	return p
end

local function setupLighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(60, 62, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 110, 130)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true

	local function ensure(className: string, props)
		local effect = Lighting:FindFirstChildOfClass(className) or Instance.new(className)
		for key, value in props do
			effect[key] = value
		end
		effect.Parent = Lighting
	end

	ensure("Atmosphere", {
		Density = 0.3,
		Offset = 0.2,
		Color = Color3.fromRGB(200, 190, 230),
		Decay = Color3.fromRGB(90, 80, 130),
		Glare = 0.3,
		Haze = 1.2,
	})
	ensure("BloomEffect", { Intensity = 0.6, Size = 24, Threshold = 1.4 })
	ensure("ColorCorrectionEffect", { Saturation = 0.15, Contrast = 0.08, Brightness = 0.02 })
	ensure("SunRaysEffect", { Intensity = 0.06, Spread = 0.6 })
end

local function buildFloorAndWalls()
	part({
		Name = "Floor",
		Size = Vector3.new(HALF * 2, 2, HALF * 2),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(42, 46, 58),
		Material = Enum.Material.Slate,
	})

	-- Lignes néon au sol (style e-sport)
	for _, offset in { -50, 0, 50 } do
		part({
			Name = "FloorLine",
			Size = Vector3.new(HALF * 2, 0.1, 0.4),
			CFrame = CFrame.new(0, 0.05, offset),
			Color = Config.Colors.Accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.4,
		})
		part({
			Name = "FloorLine",
			Size = Vector3.new(0.4, 0.1, HALF * 2),
			CFrame = CFrame.new(offset, 0.05, 0),
			Color = Config.Colors.Accent2,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.4,
		})
	end

	local walls = {
		{ CFrame.new(0, WALL_HEIGHT / 2, HALF + 1), Vector3.new(HALF * 2 + 4, WALL_HEIGHT, 2), Config.Colors.Accent },
		{ CFrame.new(0, WALL_HEIGHT / 2, -HALF - 1), Vector3.new(HALF * 2 + 4, WALL_HEIGHT, 2), Config.Colors.Accent2 },
		{ CFrame.new(HALF + 1, WALL_HEIGHT / 2, 0), Vector3.new(2, WALL_HEIGHT, HALF * 2 + 4), Config.Colors.Accent },
		{ CFrame.new(-HALF - 1, WALL_HEIGHT / 2, 0), Vector3.new(2, WALL_HEIGHT, HALF * 2 + 4), Config.Colors.Accent2 },
	}
	for _, wall in walls do
		local cf, size, color = wall[1], wall[2], wall[3]
		part({
			Name = "Wall",
			Size = size,
			CFrame = cf,
			Color = Color3.fromRGB(28, 30, 40),
			Material = Enum.Material.Concrete,
		})
		-- Bandeau lumineux en bas du mur
		part({
			Name = "WallTrim",
			Size = Vector3.new(size.X + 0.2, 0.6, size.Z + 0.2),
			CFrame = CFrame.new(cf.Position.X, 1.2, cf.Position.Z),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end

	-- Plafond invisible pour éviter de sortir de l'arène
	part({
		Name = "Ceiling",
		Size = Vector3.new(HALF * 2, 1, HALF * 2),
		CFrame = CFrame.new(0, WALL_HEIGHT + 0.5, 0),
		Transparency = 1,
		CastShadow = false,
	})
end

local function buildCovers()
	local layout = {
		-- position (quadrant +,+), taille
		{ Vector3.new(50, 0, 50), Vector3.new(14, 7, 3) },
		{ Vector3.new(55, 0, 20), Vector3.new(3, 7, 12) },
		{ Vector3.new(22, 0, 65), Vector3.new(12, 7, 3) },
		{ Vector3.new(72, 0, 72), Vector3.new(6, 14, 6) },
		{ Vector3.new(35, 0, 35), Vector3.new(4, 4, 4) },
	}
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			for _, entry in layout do
				local pos, size = entry[1], entry[2]
				local block = part({
					Name = "Cover",
					Size = size,
					CFrame = CFrame.new(pos.X * sx, size.Y / 2, pos.Z * sz),
					Color = Color3.fromRGB(70, 76, 96),
					Material = Enum.Material.Concrete,
				})
				part({
					Name = "CoverTrim",
					Size = Vector3.new(size.X + 0.2, 0.3, size.Z + 0.2),
					CFrame = block.CFrame * CFrame.new(0, size.Y / 2, 0),
					Color = if sx == sz then Config.Colors.Accent else Config.Colors.Accent2,
					Material = Enum.Material.Neon,
					CanCollide = false,
				})
			end
		end
	end
end

local function buildCenter()
	local height = 6
	local platform = part({
		Name = "CenterPlatform",
		Size = Vector3.new(36, height, 36),
		CFrame = CFrame.new(0, height / 2, 0),
		Color = Color3.fromRGB(55, 60, 78),
		Material = Enum.Material.DiamondPlate,
	})
	part({
		Name = "CenterRing",
		Size = Vector3.new(37, 0.4, 37),
		CFrame = platform.CFrame * CFrame.new(0, height / 2 - 0.1, 0),
		Color = Config.Colors.Gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.2,
	})

	-- Rampes : la face haute d'un WedgePart est côté +Z, on l'oriente vers la plateforme.
	for _, dir in { Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis } do
		local pos = Vector3.new(0, height / 2, 0) + dir * (18 + 7)
		part({
			ClassName = "WedgePart",
			Name = "Ramp",
			Size = Vector3.new(10, height, 14),
			CFrame = CFrame.lookAt(pos, pos + dir),
			Color = Color3.fromRGB(55, 60, 78),
			Material = Enum.Material.DiamondPlate,
		})
	end
end

local function buildSpawns()
	local count = 8
	local radius = 85
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
		local spawn = part({
			ClassName = "SpawnLocation",
			Name = "Spawn",
			Size = Vector3.new(8, 1, 8),
			CFrame = CFrame.lookAt(pos, Vector3.new(0, 0.5, 0)),
			Color = Config.Colors.Accent,
			Material = Enum.Material.Neon,
			Transparency = 0.3,
		}) :: SpawnLocation
		spawn.Neutral = true
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = Config.SpawnProtection
	end
end

local function buildSigns()
	part({
		Name = "Leaderboard",
		Size = Vector3.new(34, 20, 1),
		CFrame = CFrame.new(0, 14, HALF - 0.6), -- face avant (-Z) tournée vers le centre
		Color = Color3.fromRGB(14, 16, 24),
		Material = Enum.Material.SmoothPlastic,
	})

	local banner = part({
		Name = "Banner",
		Size = Vector3.new(60, 10, 1),
		CFrame = CFrame.new(0, 18, -HALF + 0.6),
		Color = Color3.fromRGB(14, 16, 24),
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- face +Z, tournée vers le centre
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = Config.GameName
	label.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Config.Colors.Accent, Config.Colors.Accent2)
	gradient.Parent = label
	gui.Parent = banner
end

function MapService.Build()
	setupLighting()

	if workspace:FindFirstChild("Arena") then
		return
	end

	-- Nettoie le template par défaut de Roblox Studio
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	arena = Instance.new("Folder")
	arena.Name = "Arena"
	buildFloorAndWalls()
	buildCovers()
	buildCenter()
	buildSpawns()
	buildSigns()
	arena.Parent = workspace
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Arsenal (achat d'armes, loadout, camouflages), récompense quotidienne et paramètres joueur.
-- Tout est vérifié côté serveur : le client ne fait que demander.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Camos = require(Shared.Camos)
local DataService = require(script.Parent.DataService)
local WeaponService = require(script.Parent.WeaponService)

local ShopService = {}

local THROTTLE = 0.2 -- secondes minimum entre deux demandes du même type
local NOT_LOADED = "Données en cours de chargement…"

local lastCalls = {} -- [Player] = { [nom] = os.clock() }

local function throttled(player: Player, name: string): boolean
	local calls = lastCalls[player]
	if not calls then
		calls = {}
		lastCalls[player] = calls
	end
	local now = os.clock()
	if now - (calls[name] or -math.huge) < THROTTLE then
		return true
	end
	calls[name] = now
	return false
end

local function getWeapon(weaponId: any)
	if type(weaponId) ~= "string" then
		return nil
	end
	return Weapons.ById[weaponId]
end

-- Sauvegarde en arrière-plan après un achat / une récompense (évite de perdre des pièces dépensées).
local function saveSoon(player: Player)
	task.spawn(DataService.Save, player)
end

--------------------------------------------------------------------------
-- Remotes
--------------------------------------------------------------------------
local function buyWeapon(player: Player, weaponId: any): (boolean, string)
	if throttled(player, "Buy") then
		return false, "Doucement !"
	end
	local weapon = getWeapon(weaponId)
	if not weapon then
		return false, "Arme inconnue"
	end
	local data = DataService.Get(player)
	if not data then
		return false, NOT_LOADED
	end
	if data.Owned[weapon.Id] then
		return false, "Tu possèdes déjà cette arme"
	end
	if data.Coins < weapon.Price then
		return false, string.format("Il te manque %d 💰", weapon.Price - data.Coins)
	end

	DataService.Update(player, function(d)
		d.Coins -= weapon.Price
		d.Owned[weapon.Id] = true
		d.Loadout[weapon.Slot] = weapon.Id
	end, true)
	WeaponService.RefreshSlot(player, weapon.Slot)
	saveSoon(player)
	return true, weapon.Name .. " achetée et équipée !"
end

local function setLoadout(player: Player, weaponId: any): (boolean, string)
	if throttled(player, "Loadout") then
		return false, "Doucement !"
	end
	local weapon = getWeapon(weaponId)
	if not weapon then
		return false, "Arme inconnue"
	end
	local data = DataService.Get(player)
	if not data then
		return false, NOT_LOADED
	end
	if not data.Owned[weapon.Id] then
		return false, "Tu ne possèdes pas cette arme"
	end
	if data.Loadout[weapon.Slot] == weapon.Id then
		return true, weapon.Name .. " déjà équipée"
	end

	DataService.Update(player, function(d)
		d.Loadout[weapon.Slot] = weapon.Id
	end, true)
	WeaponService.RefreshSlot(player, weapon.Slot)
	return true, weapon.Name .. " équipée"
end

local function equipCamo(player: Player, weaponId: any, camoId: any): (boolean, string)
	if throttled(player, "Camo") then
		return false, "Doucement !"
	end
	local weapon = getWeapon(weaponId)
	local camo = if type(camoId) == "string" then Camos.ById[camoId] else nil
	if not weapon or not camo then
		return false, "Camouflage inconnu"
	end
	local data = DataService.Get(player)
	if not data then
		return false, NOT_LOADED
	end
	if not data.Owned[weapon.Id] then
		return false, "Achète d'abord cette arme"
	end
	local kills = data.WeaponKills[weapon.Id] or 0
	if kills < camo.Kills then
		return false, string.format("Encore %d éliminations avec %s", camo.Kills - kills, weapon.Name)
	end
	if (data.Camos[weapon.Id] or "Default") == camo.Id then
		return true, "Camouflage déjà équipé"
	end

	DataService.Update(player, function(d)
		d.Camos[weapon.Id] = camo.Id
	end, true)
	WeaponService.ApplyCamo(player, weapon.Id, camo.Id)
	return true, string.format("Camouflage %s équipé sur %s", camo.Name, weapon.Name)
end

-- Retourne (true, récompense, série) ou (false, secondes restantes).
local function claimDaily(player: Player): (boolean, number, number?)
	local data = DataService.Get(player)
	if not data then
		return false, 0
	end
	if throttled(player, "Daily") then
		local remaining = DataService.GetDailyState(data)
		return false, remaining
	end

	local remaining, streak = DataService.GetDailyState(data)
	if remaining > 0 then
		return false, remaining
	end

	local reward = Config.DailyRewards[(streak % #Config.DailyRewards) + 1]
	reward = math.floor(reward * DataService.GetCoinMultiplier(player) + 0.5)
	local newStreak = streak + 1

	DataService.Update(player, function(d)
		d.LastDaily = os.time()
		d.DailyStreak = newStreak
		d.Coins += reward
	end, true)
	saveSoon(player)
	return true, reward, newStreak
end

-- Nettoie et enregistre les paramètres (sauvegardés avec les données). Pas de DataChanged :
-- le client a déjà les valeurs et une synchro pourrait écraser un réglage en cours.
local function saveSettings(player: Player, settings: any): boolean
	if type(settings) ~= "table" then
		return false
	end
	local data = DataService.Get(player)
	if not data then
		return false
	end
	data.Settings = DataService.SanitizeSettings(settings)
	return true
end

function ShopService.Init()
	Remotes.BuyWeapon.OnServerInvoke = buyWeapon
	Remotes.SetLoadout.OnServerInvoke = setLoadout
	Remotes.EquipCamo.OnServerInvoke = equipCamo
	Remotes.ClaimDaily.OnServerInvoke = claimDaily
	Remotes.SaveSettings.OnServerInvoke = saveSettings

	Players.PlayerRemoving:Connect(function(player)
		lastCalls[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[-- Apparition des joueurs : déploiement depuis le menu (remote Deploy), choix du spawn le plus sûr,
-- réapparition automatique après la mort, protection de spawn. Ne fait jamais apparaître deux fois.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local SpawnService = {}

local BEST_CHOICES = 3 -- on tire au hasard parmi les 3 spawns les plus éloignés des ennemis
local RECENT_SPAWN_TIME = 2 -- un spawn utilisé il y a moins de 2 s compte comme « occupé »
local SPAWN_CACHE_TIME = 10
local DEPLOY_COOLDOWN = 1
local RETRY_DELAY = 1.5

local spawning = {} -- [Player] = true pendant LoadCharacter
local respawnTokens = {} -- [Player] = number : invalide une réapparition programmée
local respawnPending = {} -- [Player] = true : réapparition automatique programmée
local pendingDeploy = {} -- [Player] = true : Deploy reçu avant la fin du chargement des données
local lastDeploy = {} -- [Player] = os.clock()
local handledCharacters = setmetatable({}, { __mode = "k" }) -- [Model] = true : mort/retrait déjà traité
local recentSpawns = {} -- { { Position: Vector3, Time: number } }
local spawnedCallbacks = {}

local spawnCache = {}
local spawnCacheTime = -math.huge

--------------------------------------------------------------------------
-- Utilitaires
--------------------------------------------------------------------------
-- Retourne (Humanoid, personnage) si le joueur a un personnage vivant dans le monde.
function SpawnService.GetAliveHumanoid(player: Player): (Humanoid?, Model?)
	local character = player.Character
	if not character or not character.Parent then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid, character
	end
	return nil, nil
end

function SpawnService.IsAlive(player: Player): boolean
	return (SpawnService.GetAliveHumanoid(player)) ~= nil
end

function SpawnService.IsSpawning(player: Player): boolean
	return spawning[player] == true
end

-- callback(player, character, humanoid) appelé à chaque apparition (après configuration du Humanoid).
function SpawnService.OnSpawned(callback: (Player, Model, Humanoid) -> ())
	table.insert(spawnedCallbacks, callback)
end

-- Toutes les SpawnLocation actives de l'arène (mises en cache).
function SpawnService.GetSpawns(): { SpawnLocation }
	local now = os.clock()
	local valid = #spawnCache > 0 and now - spawnCacheTime < SPAWN_CACHE_TIME
	if valid then
		for _, location in spawnCache do
			if not location.Parent or not location.Enabled then
				valid = false
				break
			end
		end
	end
	if valid then
		return spawnCache
	end

	local list = {}
	local arena = workspace:FindFirstChild("Arena")
	if arena then
		for _, descendant in arena:GetDescendants() do
			if descendant:IsA("SpawnLocation") and descendant.Enabled then
				table.insert(list, descendant)
			end
		end
	end
	spawnCache = list
	spawnCacheTime = now
	return list
end

-- Choisit le spawn qui maximise la distance à l'ennemi vivant le plus proche.
local function chooseSpawn(player: Player): SpawnLocation?
	local spawns = SpawnService.GetSpawns()
	if #spawns == 0 then
		return nil
	end

	local threats = {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local humanoid, character = SpawnService.GetAliveHumanoid(other)
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and root:IsA("BasePart") then
				table.insert(threats, root.Position)
			end
		end
	end
	local now = os.clock()
	for index = #recentSpawns, 1, -1 do
		local entry = recentSpawns[index]
		if now - entry.Time > RECENT_SPAWN_TIME then
			table.remove(recentSpawns, index)
		else
			table.insert(threats, entry.Position)
		end
	end

	if #threats == 0 then
		return spawns[math.random(1, #spawns)]
	end

	local scored = table.create(#spawns)
	for _, location in spawns do
		local nearest = math.huge
		local position = location.Position
		for _, threat in threats do
			local distance = (threat - position).Magnitude
			if distance < nearest then
				nearest = distance
			end
		end
		table.insert(scored, { Spawn = location, Score = nearest })
	end
	table.sort(scored, function(a, b)
		return a.Score > b.Score
	end)
	return scored[math.random(1, math.min(BEST_CHOICES, #scored))].Spawn
end

-- Supprime le script de régénération par défaut de Roblox (CombatService gère la régénération).
local function removeDefaultHealthScript(character: Model)
	local health = character:FindFirstChild("Health")
	if health and health.ClassName == "Script" then
		health:Destroy()
	end
	local connection = character.ChildAdded:Connect(function(child)
		if child.Name == "Health" and child.ClassName == "Script" then
			task.defer(function()
				if child.Parent then
					child:Destroy()
				end
			end)
		end
	end)
	task.delay(3, function()
		connection:Disconnect()
	end)
end

-- Vérifie la position (repli si RespawnLocation a été ignoré) et la protection de spawn.
local function placeAndProtect(character: Model, location: SpawnLocation?)
	local root = character:FindFirstChild("HumanoidRootPart")
	if location and location.Parent and root and root:IsA("BasePart") then
		local top = location.Position + Vector3.new(0, location.Size.Y / 2, 0)
		local flat = (root.Position - top) * Vector3.new(1, 0, 1)
		local limit = math.max(location.Size.X, location.Size.Z) / 2 + 6
		if flat.Magnitude > limit or math.abs(root.Position.Y - top.Y) > 12 then
			local look = location.CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude < 0.01 then
				look = Vector3.new(0, 0, -1)
			end
			local position = top + Vector3.new(0, 3.5, 0)
			character:PivotTo(CFrame.lookAt(position, position + look.Unit))
		end
	end

	-- Le moteur crée normalement le ForceField (SpawnLocation.Duration) ; sinon on le crée nous-mêmes.
	if not character:FindFirstChildOfClass("ForceField") then
		local duration = if location then location.Duration else Config.SpawnProtection
		if duration > 0 then
			local forceField = Instance.new("ForceField")
			forceField.Name = "SpawnProtection"
			forceField.Visible = true
			forceField.Parent = character
			Debris:AddItem(forceField, duration)
		end
	end
end

local function scheduleRespawn(player: Player, delay: number)
	local token = (respawnTokens[player] or 0) + 1
	respawnTokens[player] = token
	respawnPending[player] = true
	task.delay(delay, function()
		if respawnTokens[player] ~= token then
			return
		end
		respawnPending[player] = nil
		if player.Parent == Players then
			SpawnService.Spawn(player)
		end
	end)
end

--------------------------------------------------------------------------
-- Apparition
--------------------------------------------------------------------------
-- Fait apparaître le joueur. Retourne true si un personnage a été créé.
function SpawnService.Spawn(player: Player): boolean
	if spawning[player] or player.Parent ~= Players then
		return false
	end
	if not DataService.Get(player) then
		return false
	end
	if SpawnService.IsAlive(player) then
		return false
	end

	spawning[player] = true
	pendingDeploy[player] = nil
	-- annule toute réapparition automatique déjà programmée
	respawnTokens[player] = (respawnTokens[player] or 0) + 1
	respawnPending[player] = nil

	local location = chooseSpawn(player)
	if location then
		table.insert(recentSpawns, { Position = location.Position, Time = os.clock() })
	end
	player.RespawnLocation = location

	-- l'ancien personnage (mort) ne doit pas déclencher de nouvelle réapparition
	local oldCharacter = player.Character
	if oldCharacter then
		handledCharacters[oldCharacter] = true
	end

	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	spawning[player] = nil

	if player.Parent ~= Players then
		return false
	end
	if not ok then
		warn("[SpawnService] LoadCharacter a échoué pour " .. player.Name .. " : " .. tostring(err))
		scheduleRespawn(player, RETRY_DELAY)
		return false
	end

	local character = player.Character
	if character then
		placeAndProtect(character, location)
	end
	return true
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	if player.Character ~= character or player.Parent ~= Players then
		return
	end

	humanoid.MaxHealth = Config.MaxHealth
	humanoid.Health = Config.MaxHealth
	humanoid.WalkSpeed = Config.Movement.WalkSpeed
	removeDefaultHealthScript(character)

	humanoid.Died:Once(function()
		if handledCharacters[character] then
			return
		end
		handledCharacters[character] = true
		if player.Parent == Players then
			scheduleRespawn(player, Config.RespawnTime)
		end
	end)

	for _, callback in spawnedCallbacks do
		task.spawn(callback, player, character, humanoid)
	end
end

-- Personnage retiré sans mourir (chute hors de la map, script tiers…) : on le fait réapparaître.
local function onCharacterRemoving(player: Player, character: Model)
	if handledCharacters[character] or spawning[player] then
		return
	end
	handledCharacters[character] = true
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and player.Parent == Players then
		scheduleRespawn(player, Config.RespawnTime)
	end
end

local function onDeploy(player: Player)
	if spawning[player] or respawnPending[player] then
		return
	end
	if SpawnService.IsAlive(player) then
		return
	end
	local now = os.clock()
	if now - (lastDeploy[player] or -math.huge) < DEPLOY_COOLDOWN then
		return
	end
	lastDeploy[player] = now

	if not DataService.Get(player) then
		-- données pas encore prêtes : on déploiera dès le chargement terminé
		pendingDeploy[player] = true
		return
	end
	SpawnService.Spawn(player)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player.CharacterRemoving:Connect(function(character)
		onCharacterRemoving(player, character)
	end)

	-- Personnage créé avant le démarrage des scripts (Studio) : le joueur doit passer par le menu.
	local existing = player.Character
	if existing then
		handledCharacters[existing] = true
		player.Character = nil
		existing:Destroy()
	end
end

function SpawnService.Init()
	Remotes.Deploy.OnServerEvent:Connect(onDeploy)

	DataService.OnLoaded(function(player)
		if pendingDeploy[player] then
			pendingDeploy[player] = nil
			SpawnService.Spawn(player)
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		spawning[player] = nil
		respawnTokens[player] = nil
		respawnPending[player] = nil
		pendingDeploy[player] = nil
		lastDeploy[player] = nil
	end)
end

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[-- Armes à feu côté serveur : distribution des Tools (GunBuilder), munitions / rechargement,
-- validation anti-triche de chaque tir, réplication des effets de tir et de l'inclinaison de visée.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local Ballistics = require(Shared.Ballistics)
local GunBuilder = require(Shared:WaitForChild("GunBuilder"))
local DataService = require(script.Parent.DataService)
local SpawnService = require(script.Parent.SpawnService)
local CombatService = require(script.Parent.CombatService)

local WeaponService = {}

local SLOTS = { "Primary", "Secondary" }
local DEFAULT_BY_SLOT = { Primary = Weapons.DefaultPrimary, Secondary = Weapons.DefaultSecondary }
local MAX_COORD = 1e5
local RANGE_MARGIN = 5 -- marge (studs) sur la portée annoncée
local LOS_MARGIN = 1.5 -- un obstacle à moins de 1,5 stud de la cible ne bloque pas
local LOS_PARAMS_LIFETIME = 0.1 -- les paramètres de raycast « décor seul » sont reconstruits au plus 10 fois/s
local AIM_PITCH_LIMIT = 1.3
local AIM_PITCH_MAX_PER_SECOND = 20
local WEAPON_CHECK_DELAY = 1

local fireStates = {} -- [Player] = { [weaponId] = { Last, Times, Index, Limit } }
local aimStates = {} -- [Player] = { WindowStart, Count }
local toolStates = setmetatable({}, { __mode = "k" }) -- [Tool] = { ReloadToken }

local losParams: RaycastParams? = nil
local losParamsTime = -math.huge

--------------------------------------------------------------------------
-- Utilitaires
--------------------------------------------------------------------------
local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isValidVector(value: any): boolean
	return typeof(value) == "Vector3"
		and isFiniteNumber(value.X)
		and isFiniteNumber(value.Y)
		and isFiniteNumber(value.Z)
		and math.abs(value.X) < MAX_COORD
		and math.abs(value.Y) < MAX_COORD
		and math.abs(value.Z) < MAX_COORD
end

local function getWeaponOf(tool: Instance?)
	if not tool or not tool:IsA("Tool") then
		return nil
	end
	local weaponId = tool:GetAttribute("WeaponId")
	if type(weaponId) ~= "string" then
		return nil
	end
	return Weapons.ById[weaponId]
end

-- Arme en main d'un joueur vivant : (tool, weapon, character, humanoid) ou nil.
local function getEquippedGun(player: Player)
	local humanoid, character = SpawnService.GetAliveHumanoid(player)
	if not humanoid or not character then
		return nil
	end
	local tool = character:FindFirstChildOfClass("Tool")
	local weapon = getWeaponOf(tool)
	if not tool or not weapon then
		return nil
	end
	return tool, weapon, character, humanoid
end

-- Tool d'un slot (en main ou dans le Backpack).
local function findGun(player: Player, slot: string): Tool?
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for index = 1, 2 do
		local container = containers[index]
		if container then
			for _, child in container:GetChildren() do
				local weapon = getWeaponOf(child)
				if weapon and weapon.Slot == slot then
					return child :: Tool
				end
			end
		end
	end
	return nil
end

local function removeGuns(player: Player)
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for index = 1, 2 do
		local container = containers[index]
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("WeaponId") ~= nil then
					child:Destroy()
				end
			end
		end
	end
end

local function removeForceFields(character: Model)
	local forceField = character:FindFirstChildOfClass("ForceField")
	while forceField do
		forceField:Destroy()
		forceField = character:FindFirstChildOfClass("ForceField")
	end
end

local function getLosParams(): RaycastParams
	local now = os.clock()
	if not losParams or now - losParamsTime > LOS_PARAMS_LIFETIME then
		losParams = Ballistics.GetRaycastParams(Ballistics.GetCharacters())
		losParamsTime = now
	end
	return losParams :: RaycastParams
end

--------------------------------------------------------------------------
-- Rechargement
--------------------------------------------------------------------------
local function cancelReload(tool: Tool)
	local state = toolStates[tool]
	if state then
		state.ReloadToken += 1
	end
	if tool:GetAttribute("Reloading") == true then
		tool:SetAttribute("Reloading", false)
	end
end

local function trackTool(tool: Tool)
	local state = { ReloadToken = 0 }
	toolStates[tool] = state

	-- Rangé dans le Backpack, lâché ou détruit : le rechargement est annulé.
	tool:GetPropertyChangedSignal("Parent"):Connect(function()
		local parent = tool.Parent
		if not parent or not parent:FindFirstChildOfClass("Humanoid") then
			cancelReload(tool)
		end
	end)
	tool.Destroying:Connect(function()
		state.ReloadToken += 1
		toolStates[tool] = nil
	end)
end

function WeaponService.StartReload(player: Player): boolean
	local tool, weapon, character, humanoid = getEquippedGun(player)
	if not tool then
		return false
	end
	local state = toolStates[tool]
	if not state or tool:GetAttribute("Reloading") == true then
		return false
	end
	local ammo = tool:GetAttribute("Ammo")
	if type(ammo) == "number" and ammo >= weapon.MagSize then
		return false
	end

	state.ReloadToken += 1
	local token = state.ReloadToken
	tool:SetAttribute("Reloading", true)

	task.delay(weapon.ReloadTime, function()
		if state.ReloadToken ~= token then
			return
		end
		local stillHeld = tool.Parent == character
			and player.Parent == Players
			and player.Character == character
			and humanoid.Health > 0
		if stillHeld then
			tool:SetAttribute("Ammo", weapon.MagSize)
		end
		if tool.Parent then
			tool:SetAttribute("Reloading", false)
		end
	end)
	return true
end

--------------------------------------------------------------------------
-- Distribution des armes
--------------------------------------------------------------------------
local function buildGun(data, slot: string): Tool?
	local weaponId = data.Loadout[slot]
	local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
	if not weapon or weapon.Slot ~= slot or not data.Owned[weaponId] then
		weaponId = DEFAULT_BY_SLOT[slot]
		weapon = Weapons.ById[weaponId]
	end
	if not weapon then
		return nil
	end
	local camoId = data.Camos[weaponId] or "Default"

	local ok, result = pcall(GunBuilder.BuildTool, weaponId, camoId)
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Tool") then
		warn("[WeaponService] GunBuilder.BuildTool a échoué (" .. tostring(weaponId) .. ") : " .. tostring(result))
		return nil
	end
	local tool = result :: Tool
	tool.CanBeDropped = false
	tool:SetAttribute("WeaponId", weaponId)
	tool:SetAttribute("CamoId", camoId)
	tool:SetAttribute("Ammo", weapon.MagSize)
	tool:SetAttribute("Reloading", false)
	trackTool(tool)
	return tool
end

-- Donne principale + secondaire (camos équipés) et garde en main le même slot qu'avant (principale par défaut).
function WeaponService.GiveWeapons(player: Player)
	local data = DataService.Get(player)
	local humanoid, character = SpawnService.GetAliveHumanoid(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not humanoid or not character or not backpack then
		return
	end

	local equippedSlot = "Primary"
	local current = getWeaponOf(character:FindFirstChildOfClass("Tool"))
	if current then
		equippedSlot = current.Slot
	end

	removeGuns(player)
	local tools = {}
	for _, slot in SLOTS do
		local tool = buildGun(data, slot)
		if tool then
			tool.Parent = backpack
			tools[slot] = tool
		end
	end

	local toEquip = tools[equippedSlot] or tools.Primary or tools.Secondary
	if toEquip and humanoid.Health > 0 then
		humanoid:EquipTool(toEquip)
	end
end

-- Remplace uniquement l'arme d'un slot (changement de loadout / achat) ; l'autre garde ses munitions.
function WeaponService.RefreshSlot(player: Player, slot: string)
	local data = DataService.Get(player)
	local humanoid, character = SpawnService.GetAliveHumanoid(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not humanoid or not character or not backpack then
		return
	end
	local old = findGun(player, slot)
	local wasEquipped = old ~= nil and old.Parent == character
	local tool = buildGun(data, slot)
	if not tool then
		return
	end
	if old then
		old:Destroy()
	end
	tool.Parent = backpack
	if wasEquipped or not character:FindFirstChildOfClass("Tool") then
		humanoid:EquipTool(tool)
	end
end

-- Applique un camo aux armes déjà en possession du joueur (sans les reconstruire).
function WeaponService.ApplyCamo(player: Player, weaponId: string, camoId: string)
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for index = 1, 2 do
		local container = containers[index]
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("WeaponId") == weaponId then
					local ok, err = pcall(GunBuilder.ApplyCamo, child, camoId)
					if not ok then
						warn("[WeaponService] GunBuilder.ApplyCamo a échoué : " .. tostring(err))
					end
					child:SetAttribute("CamoId", camoId)
				end
			end
		end
	end
end

-- Complète les slots manquants (si le Backpack a été recréé juste après l'apparition).
local function ensureWeapons(player: Player)
	local data = DataService.Get(player)
	local humanoid, character = SpawnService.GetAliveHumanoid(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not humanoid or not character or not backpack then
		return
	end
	for _, slot in SLOTS do
		if not findGun(player, slot) then
			local tool = buildGun(data, slot)
			if tool then
				tool.Parent = backpack
				if slot == "Primary" and not character:FindFirstChildOfClass("Tool") then
					humanoid:EquipTool(tool)
				end
			end
		end
	end
end

local function onSpawned(player: Player, character: Model, humanoid: Humanoid)
	-- le Backpack est recréé à chaque apparition : on laisse passer une frame
	task.wait()
	if player.Character ~= character or humanoid.Health <= 0 then
		return
	end
	player:WaitForChild("Backpack", 5)
	if player.Character ~= character or humanoid.Health <= 0 then
		return
	end
	WeaponService.GiveWeapons(player)

	task.delay(WEAPON_CHECK_DELAY, function()
		if player.Parent == Players and player.Character == character and humanoid.Health > 0 then
			ensureWeapons(player)
		end
	end)
end

--------------------------------------------------------------------------
-- Validation des tirs
--------------------------------------------------------------------------
local function getFireState(player: Player, weapon)
	local states = fireStates[player]
	if not states then
		states = {}
		fireStates[player] = states
	end
	local state = states[weapon.Id]
	if not state then
		local limit = math.ceil(1 / weapon.FireDelay) + 2
		state = { Last = -math.huge, Times = table.create(limit, -math.huge), Index = 1, Limit = limit }
		states[weapon.Id] = state
	end
	return state
end

-- Cadence minimale + seau : au plus `Limit` tirs sur une fenêtre glissante d'1 s.
local function canFire(state, weapon, now: number): boolean
	if now - state.Last < weapon.FireDelay * Config.Validation.FireDelayTolerance then
		return false
	end
	-- Times[Index] = le plus ancien des `Limit` derniers tirs
	return now - state.Times[state.Index] >= 1
end

local function commitShot(state, now: number)
	state.Last = now
	state.Times[state.Index] = now
	state.Index = state.Index % state.Limit + 1
end

-- Vérifie un impact sur un personnage (portée, cohérence de position, axe du tir, ligne de vue).
local function validateHit(weapon, hitPart: BasePart, origin: Vector3, direction: Vector3, position: Vector3, distance: number): boolean
	local validation = Config.Validation
	if distance > weapon.Range + RANGE_MARGIN then
		return false
	end
	if (hitPart.Position - position).Magnitude > hitPart.Size.Magnitude / 2 + validation.HitTolerance then
		return false
	end
	local offset = position - origin
	if distance > 0.05 and (offset / distance):Dot(direction) < validation.MinDirectionDot then
		return false
	end
	local result = workspace:Raycast(origin, offset, getLosParams())
	if result and (result.Position - origin).Magnitude < distance - LOS_MARGIN then
		return false
	end
	return true
end

local function onFire(player: Player, origin: any, pellets: any)
	-- 1. types / état
	if not isValidVector(origin) or type(pellets) ~= "table" then
		return
	end
	local tool, weapon, character = getEquippedGun(player)
	if not tool or not weapon or not character then
		return
	end
	local count = #pellets
	if count < 1 or count > weapon.Pellets then
		return
	end
	for index = 1, count do
		local pellet = pellets[index]
		if type(pellet) ~= "table" or not isValidVector(pellet.Direction) or not isValidVector(pellet.Position) then
			return
		end
		if pellet.Direction.Magnitude < 1e-3 then
			return
		end
	end
	if tool:GetAttribute("Reloading") == true then
		return
	end
	local ammo = tool:GetAttribute("Ammo")
	if type(ammo) ~= "number" or ammo <= 0 then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end

	-- 2. cadence
	local now = os.clock()
	local state = getFireState(player, weapon)
	if not canFire(state, weapon, now) then
		return
	end

	-- 3. origine plausible
	if (origin - head.Position).Magnitude > Config.Validation.MaxOriginOffset then
		return
	end

	-- 4. munitions + fin de la protection de spawn
	commitShot(state, now)
	tool:SetAttribute("Ammo", ammo - 1)
	removeForceFields(character)

	-- 5. plombs
	local hits = nil -- [Humanoid] = { Damage, Headshot, Distance, Position }
	local impacts = table.create(count)
	for index = 1, count do
		local pellet = pellets[index]
		local direction = pellet.Direction.Unit
		local position = pellet.Position
		local distance = (position - origin).Magnitude

		local normal = Vector3.zero
		if isValidVector(pellet.Normal) and pellet.Normal.Magnitude > 1e-3 then
			normal = pellet.Normal.Unit
		end

		local isCharacter = false
		local hitPart = pellet.Hit
		if typeof(hitPart) == "Instance" and hitPart:IsA("BasePart") and hitPart:IsDescendantOf(workspace) then
			local victim, model = Ballistics.GetHumanoid(hitPart)
			if victim and model and model ~= character then
				isCharacter = true
				if victim.Health > 0 and validateHit(weapon, hitPart, origin, direction, position, distance) then
					local headshot = Ballistics.IsHeadshot(hitPart)
					local damage = Ballistics.DamageAt(weapon, distance, headshot)
					hits = hits or {}
					local entry = hits[victim]
					if entry then
						entry.Damage += damage
						entry.Headshot = entry.Headshot or headshot
						entry.Distance = math.min(entry.Distance, distance)
					else
						hits[victim] = { Damage = damage, Headshot = headshot, Distance = distance, Position = position }
					end
				end
			end
		end

		-- impact affiché chez les autres, limité à la portée de l'arme
		local shown = position
		if distance > weapon.Range then
			shown = origin + direction * weapon.Range
			normal = Vector3.zero
			isCharacter = false
		end
		impacts[index] = { Position = shown, Normal = normal, Character = isCharacter }
	end

	-- dégâts (un seul appel par cible : les plombs d'un fusil à pompe sont additionnés)
	if hits then
		for victim, entry in hits do
			CombatService.ApplyDamage(player, victim, entry.Damage, {
				WeaponId = weapon.Id,
				Headshot = entry.Headshot,
				Distance = entry.Distance,
				Position = entry.Position,
				Origin = origin,
			})
		end
	end

	-- 6. effets chez tous les autres joueurs
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.ShotFx:FireClient(other, player, weapon.Id, origin, impacts)
		end
	end
end

--------------------------------------------------------------------------
-- Inclinaison de visée (UnreliableRemoteEvent)
--------------------------------------------------------------------------
local function onAimPitch(player: Player, pitch: any)
	if not isFiniteNumber(pitch) then
		return
	end
	local now = os.clock()
	local state = aimStates[player]
	if not state then
		state = { WindowStart = now, Count = 0 }
		aimStates[player] = state
	end
	if now - state.WindowStart >= 1 then
		state.WindowStart = now
		state.Count = 0
	end
	if state.Count >= AIM_PITCH_MAX_PER_SECOND then
		return
	end
	state.Count += 1

	local character = player.Character
	if not character or not character.Parent then
		return
	end
	local value = math.floor(math.clamp(pitch, -AIM_PITCH_LIMIT, AIM_PITCH_LIMIT) * 100 + 0.5) / 100
	if character:GetAttribute("AimPitch") ~= value then
		character:SetAttribute("AimPitch", value)
	end
end

--------------------------------------------------------------------------
-- Initialisation
--------------------------------------------------------------------------
function WeaponService.Init()
	SpawnService.OnSpawned(onSpawned)

	Remotes.Fire.OnServerEvent:Connect(onFire)
	Remotes.Reload.OnServerEvent:Connect(function(player)
		WeaponService.StartReload(player)
	end)
	Remotes.AimPitch.OnServerEvent:Connect(onAimPitch)

	Players.PlayerRemoving:Connect(function(player)
		fireStates[player] = nil
		aimStates[player] = nil
	end)
end

return WeaponService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="24">
