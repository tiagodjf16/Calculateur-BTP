		AdsTime = 0.16,
		Scope = false,
		SpeedScale = 1,
		Sound = "Magnum",
		TracerColor = Color3.fromRGB(255, 190, 90),
	},

	--------------------------------------------------------------------------
	-- Armes principales
	--------------------------------------------------------------------------
	{
		Id = "UZI",
