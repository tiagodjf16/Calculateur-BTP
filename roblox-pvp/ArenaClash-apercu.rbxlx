		AdsFov = 58,
		AdsTime = 0.12,
		Scope = false,
		SpeedScale = 1.05,
		Sound = "Pistol",
		TracerColor = Color3.fromRGB(255, 220, 140),
	},
	{
		Id = "Magnum",
		Name = "Magnum .357",
		Slot = "Secondary",
		Category = "Revolver",
		Description = "Lent mais dévastateur : une balle dans la tête = élimination.",
		Price = 900,
		Damage = 55,
		HeadshotMultiplier = 2,
		FireDelay = 0.55,
		Automatic = false,
		MagSize = 6,
		ReloadTime = 2.4,
		Pellets = 1,
		Range = 300,
		FalloffStart = 70,
		FalloffEnd = 200,
		MinDamageScale = 0.7,
		HipSpread = 1.8,
		AdsSpread = 0.15,
		SpreadPerShot = 1.5,
		MaxSpread = 5,
		SpreadRecovery = 6,
		Recoil = { Vertical = 4.5, Horizontal = 1, Recovery = 4 },
