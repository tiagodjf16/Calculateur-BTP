		SpreadPerShot = 0.25,
		MaxSpread = 4,
		SpreadRecovery = 10,
		Recoil = { Vertical = 0.7, Horizontal = 0.35, Recovery = 7 },
		AdsFov = 52,
		AdsTime = 0.18,
		Scope = false,
		SpeedScale = 1,
		Sound = "Rifle",
		TracerColor = Color3.fromRGB(150, 220, 255),
	},
	{
		Id = "Sniper",
		Name = "Sniper .50",
		Slot = "Primary",
		Category = "Fusil de précision",
		Description = "Lunette x6. Une balle suffit, à n'importe quelle distance.",
		Price = 6000,
		Damage = 105,
		HeadshotMultiplier = 2,
		FireDelay = 1.3,
		Automatic = false,
		MagSize = 5,
		ReloadTime = 3.2,
		Pellets = 1,
		Range = 1200,
		FalloffStart = 1200,
		FalloffEnd = 1200,
		MinDamageScale = 1,
		HipSpread = 8,
		AdsSpread = 0,
		SpreadPerShot = 0,
		MaxSpread = 8,
		SpreadRecovery = 10,
		Recoil = { Vertical = 6, Horizontal = 1, Recovery = 3 },
		AdsFov = 16,
		AdsTime = 0.32,
		Scope = true,
		SpeedScale = 0.88,
		Sound = "Sniper",
		TracerColor = Color3.fromRGB(120, 230, 255),
	},
	{
		Id = "M249",
		Name = "M249",
		Slot = "Primary",
		Category = "Mitrailleuse légère",
		Description = "100 balles de suppression. Lourde, mais terrifiante.",
		Price = 9000,
		Damage = 26,
		HeadshotMultiplier = 1.4,
		FireDelay = 0.075,
		Automatic = true,
		MagSize = 100,
		ReloadTime = 4.5,
		Pellets = 1,
		Range = 400,
		FalloffStart = 60,
		FalloffEnd = 220,
		MinDamageScale = 0.7,
		HipSpread = 3,
		AdsSpread = 0.9,
		SpreadPerShot = 0.2,
		MaxSpread = 5.5,
		SpreadRecovery = 6,
		Recoil = { Vertical = 0.75, Horizontal = 0.6, Recovery = 4 },
