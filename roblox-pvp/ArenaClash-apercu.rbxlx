		Lifetime = NumberRange.new(1.6, 3),
		Speed = NumberRange.new(12, 30),
		SpreadAngle = Vector2.new(80, 80),
		Size = ns({ { 0, 5 }, { 1, 16 } }),
		Transparency = ns({ { 0, 0.25 }, { 1, 1 } }),
		Acceleration = Vector3.new(0, 4, 0),
		Drag = 2.5,
		LightEmission = 0,
		LightInfluence = 0.6,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-20, 20),
	},
}
local OPTIONAL_EMITTER_PROPERTIES = { Squash = true, Brightness = true }

-- Couleurs d'étincelles (un émetteur par couleur : changer la couleur d'un émetteur
-- recolorerait aussi ses particules encore vivantes).
local SPARK_COLORS = {
	Metal = ColorSequence.new(Color3.fromRGB(255, 246, 210), Color3.fromRGB(255, 140, 40)),
	Pale = ColorSequence.new(Color3.fromRGB(255, 244, 220), Color3.fromRGB(255, 200, 140)),
	Glass = ColorSequence.new(WHITE, Color3.fromRGB(140, 215, 255)),
	White = ColorSequence.new(WHITE, Color3.fromRGB(255, 225, 170)),
	Ember = ColorSequence.new(Color3.fromRGB(255, 235, 170), Color3.fromRGB(255, 120, 30)),
}

-- Rendu des impacts selon la famille de matériau.
local IMPACT_STYLES: { [string]: any } = {
	Metal = { Spark = "Metal", SparkCount = 10, Dust = Color3.fromRGB(150, 150, 156), DustCount = 1, Hot = true },
	Stone = {
		Spark = "Pale",
		SparkCount = 3,
		Dust = Color3.fromRGB(176, 170, 160),
		DustCount = 3,
		Chips = Color3.fromRGB(112, 108, 102),
		ChipCount = 6,
	},
	Wood = { Dust = Color3.fromRGB(196, 168, 126), DustCount = 2, Chips = Color3.fromRGB(122, 82, 46), ChipCount = 7 },
	Grass = { Dust = Color3.fromRGB(128, 116, 84), DustCount = 4, Chips = Color3.fromRGB(78, 110, 56), ChipCount = 5 },
	Sand = { Dust = Color3.fromRGB(218, 198, 152), DustCount = 5, Chips = Color3.fromRGB(192, 168, 122), ChipCount = 5 },
	Snow = { Dust = Color3.fromRGB(240, 245, 250), DustCount = 5, Chips = Color3.fromRGB(228, 236, 245), ChipCount = 4 },
	Glass = {
		Spark = "Glass",
		SparkCount = 7,
		Chips = Color3.fromRGB(196, 232, 250),
		ChipCount = 6,
		HoleColor = Color3.fromRGB(226, 240, 250),
		HoleTransparency = 0.35,
	},
	Energy = { Spark = "White", SparkCount = 10, NoHole = true },
	Plastic = {
		Spark = "White",
		SparkCount = 3,
		Dust = Color3.fromRGB(205, 205, 210),
		DustCount = 2,
		Chips = Color3.fromRGB(92, 92, 98),
		ChipCount = 4,
	},
}
for kind, style in IMPACT_STYLES do
	if style.Spark then
		style.SparkKey = "Sparks:" .. style.Spark
	end
	if style.Dust then
		style.DustKey = "Dust:" .. kind
	end
	if style.Chips then
		style.ChipKey = "Chips:" .. kind
	end
end

-- Matériau -> famille d'impact (pcall : certains matériaux récents peuvent ne pas exister).
local MATERIAL_KIND: { [Enum.Material]: string } = {}
local function classify(kind: string, names: { string })
	for _, name in names do
		local ok, material = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and material then
			MATERIAL_KIND[material] = kind
		end
	end
end
classify("Metal", { "Metal", "DiamondPlate", "CorrodedMetal", "Foil" })
classify("Stone", {
	"Concrete",
	"Brick",
	"Slate",
	"Cobblestone",
	"Granite",
	"Marble",
	"Pebble",
	"Rock",
	"Basalt",
	"Asphalt",
	"Pavement",
	"Limestone",
	"Sandstone",
	"CrackedLava",
	"Salt",
	"Plaster",
	"CeramicTiles",
	"ClayRoofTiles",
	"RoofShingles",
})
classify("Wood", { "Wood", "WoodPlanks", "Cardboard" })
classify("Grass", { "Grass", "LeafyGrass", "Ground", "Mud" })
classify("Sand", { "Sand" })
classify("Snow", { "Snow" })
classify("Glass", { "Glass", "Ice", "Glacier" })
classify("Energy", { "Neon", "ForceField" })

local function makeEmitter(name: string, spec: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.LockedToPart = false
	emitter.LightInfluence = 0
	emitter.EmissionDirection = Enum.NormalId.Front
	for key, value in spec do
		if OPTIONAL_EMITTER_PROPERTIES[key] then
			trySet(emitter, key, value)
		else
			(emitter :: any)[key] = value
		end
	end
	return emitter
end

local function buildEmitters(parent: Attachment)
	local function add(key: string, base: string, color: ColorSequence)
		local emitter = makeEmitter(key, EMITTER_BASE[base])
		emitter.Color = color
		emitter.Parent = parent
		emitters[key] = emitter
	end
	for name, color in SPARK_COLORS do
		add("Sparks:" .. name, "Sparks", color)
	end
	for _, style in IMPACT_STYLES do
		if style.DustKey then
			add(style.DustKey, "Dust", ColorSequence.new(style.Dust))
		end
		if style.ChipKey then
			add(style.ChipKey, "Chips", ColorSequence.new(style.Chips))
		end
	end
	add(
		"HitSpark",
		"HitSpark",
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, WHITE),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 232, 120)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 100)),
		})
	)
	add("Smoke", "Smoke", ColorSequence.new(Color3.fromRGB(205, 205, 210)))
	add("Bits:Accent", "Bits", ColorSequence.new(WHITE, Config.Colors.Accent))
	add("Bits:Gold", "Bits", ColorSequence.new(WHITE, Config.Colors.Gold))
	add("BigSparks", "BigSparks", ColorSequence.new(WHITE, Color3.fromRGB(110, 190, 255)))
	add("BigSmoke", "BigSmoke", ColorSequence.new(Color3.fromRGB(176, 188, 206), Color3.fromRGB(88, 94, 110)))
end

local function destroyIfAlive(instance: Instance?)
	if instance and instance.Parent then
		instance:Destroy()
	end
end

-- Vide tous les pools (utilisé si le dossier / la pièce hôte a été détruit).
local function resetPools()
	for _, flash in activeFlashes do
		table.insert(flashPool, flash)
	end
	for _, flash in flashPool do
		destroyIfAlive(flash.Core)
		destroyIfAlive(flash.Jet)
		for _, blade in flash.Blades do
			destroyIfAlive(blade)
		end
	end
	for _, body in bodies do
		destroyIfAlive(body.Part)
	end
	for _, part in shellPool do
		destroyIfAlive(part)
	end
	for _, pop in activePops do
		table.insert(popPool, pop)
	end
	for _, pop in popPool do
		destroyIfAlive(pop.Part)
	end
	for _, hole in holes do
		destroyIfAlive(hole.Part)
	end
	tracerPool, activeTracers, litTracers = {}, {}, 0
	flashPool, activeFlashes = {}, {}
	bodies, shellPool, activeShells = {}, {}, 0
	popPool, activePops = {}, {}
	holes, holeIndex = {}, 0
	emitters = {}
end

-- Garantit l'existence de workspace.ClientFX + pièce hôte + émetteurs partagés.
local function ensureHost()
	local folder = getFolder()
	if host and host.Parent == folder and emitAttachment and emitAttachment.Parent == host then
		return
	end
	resetPools()
	destroyIfAlive(host)
	local part = newPart(Enum.PartType.Block, Vector3.one, Color3.new(), Enum.Material.SmoothPlastic, 1)
	part.Name = "FxHost"
	part.CFrame = CFrame.new() -- repère identité : Attachment.Position = position monde
	part.Parent = folder
	host = part
	local attachment = Instance.new("Attachment")
	attachment.Name = "Emitter"
	attachment.Parent = part
	emitAttachment = attachment
	buildEmitters(attachment)
end

-- Émet « count » particules depuis « frame » (l'avant du repère = direction d'émission).
local function emit(frame: CFrame, emitter: ParticleEmitter?, count: number)
	local attachment = emitAttachment
	if not emitter or not attachment or particleBudget <= 0 then
		return
	end
	local amount = math.min(math.floor(count + 0.5), particleBudget)
	if amount <= 0 then
		return
	end
	particleBudget -= amount
	attachment.CFrame = frame
	emitter:Emit(amount)
end

-- Séquences de couleurs dérivées d'une teinte (cache : les Color3 de Weapons sont réutilisés).
local colorCache = setmetatable({}, { __mode = "k" })
local function colorSet(color: Color3)
	local set = colorCache[color]
	if not set then
		local hot = color:Lerp(WHITE, 0.65)
		set = {
			Core = ColorSequence.new(color, hot),
			Glow = ColorSequence.new(color),
			Hot = hot,
		}
		colorCache[color] = set
	end
	return set
end

--------------------------------------------------------------------------
-- Traceurs : un Beam fin et brillant qui file du canon à l'impact
--------------------------------------------------------------------------
local TRACER_CORE_TRANSPARENCY = ns({ { 0, 1 }, { 0.45, 0.35 }, { 1, 0 } })
local TRACER_GLOW_TRANSPARENCY = ns({ { 0, 1 }, { 1, 0.62 } })

local function createTracer(): Tracer
	local parent = host :: BasePart
	local tail = Instance.new("Attachment")
	tail.Name = "TracerTail"
	tail.Parent = parent
	local head = Instance.new("Attachment")
	head.Name = "TracerHead"
	head.Parent = parent

	local function beam(width0: number, width1: number, transparency: NumberSequence): Beam
		local created = Instance.new("Beam")
		created.Attachment0 = tail
		created.Attachment1 = head
		created.FaceCamera = true
		created.Segments = 1
		created.LightEmission = 1
		created.LightInfluence = 0
		created.Width0 = width0
		created.Width1 = width1
		created.Transparency = transparency
		created.Enabled = false
		trySet(created, "Brightness", 3)
		created.Parent = parent
		return created
	end

	local light = Instance.new("PointLight")
	light.Range = 7
	light.Brightness = 1.4
	light.Shadows = false
	light.Enabled = false
	light.Parent = head

	return {
		Tail = tail,
		Head = head,
		Core = beam(0.03, 0.12, TRACER_CORE_TRANSPARENCY),
		Glow = beam(0.06, 0.34, TRACER_GLOW_TRANSPARENCY),
		Light = light,
		From = Vector3.zero,
		Dir = Vector3.zAxis,
		Length = 0,
		Traveled = 0,
		Streak = 0,
		Speed = TRACER_SPEED,
		Lit = false,
	}
end

local function releaseTracer(index: number)
	local tracer = table.remove(activeTracers, index)
	if not tracer then
		return
	end
	tracer.Core.Enabled = false
	tracer.Glow.Enabled = false
	if tracer.Lit then
		tracer.Lit = false
		tracer.Light.Enabled = false
		litTracers -= 1
	end
	table.insert(tracerPool, tracer)
end

local function placeTracer(tracer: Tracer)
	local head = math.min(tracer.Traveled, tracer.Length)
	local tail = math.max(0, tracer.Traveled - tracer.Streak)
	tracer.Head.Position = tracer.From + tracer.Dir * head
	tracer.Tail.Position = tracer.From + tracer.Dir * tail
end

local function stepTracers(dt: number)
	for index = #activeTracers, 1, -1 do
		local tracer = activeTracers[index]
		tracer.Traveled += tracer.Speed * dt
		if tracer.Traveled - tracer.Streak >= tracer.Length then
			releaseTracer(index)
		else
			placeTracer(tracer)
		end
	end
end

-- Traînée de vapeur persistante (sniper).
local function spawnTrail(from: Vector3, to: Vector3, color: Color3)
	local length = (to - from).Magnitude
	if length < 2 then
		return
	end
	local folder = getFolder()
	local frame = CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, math.pi / 2, 0) -- axe X du cylindre = trajectoire
	local core = newPart(Enum.PartType.Cylinder, Vector3.new(length, 0.1, 0.1), color, Enum.Material.Neon, 0.3)
	core.CFrame = frame
	core.Parent = folder
	tween(core, 0.8, { Transparency = 1, Size = Vector3.new(length, 0.02, 0.02) })
	Debris:AddItem(core, 0.9)
	local vapor = newPart(
		Enum.PartType.Cylinder,
		Vector3.new(length, 0.25, 0.25),
		Color3.fromRGB(220, 228, 240),
		Enum.Material.SmoothPlastic,
		0.75
	)
	vapor.CFrame = frame
	vapor.Parent = folder
	tween(vapor, 1.6, { Transparency = 1, Size = Vector3.new(length, 1.2, 1.2) }, Enum.EasingStyle.Sine)
	Debris:AddItem(vapor, 1.7)
end

function Effects.Tracer(from: Vector3, to: Vector3, color: Color3?, weaponId: string?)
	if not isFiniteVector(from) or not isFiniteVector(to) then
		return
	end
	local delta = to - from
	local length = delta.Magnitude
	if length < 1 then
		return
	end
	ensureHost()

	local tracer = table.remove(tracerPool)
	if not tracer then
		if #activeTracers < MAX_TRACERS then
			tracer = createTracer()
		else
			releaseTracer(1) -- recycle le plus ancien
			tracer = table.remove(tracerPool)
		end
	end
	if not tracer then
		return
	end

	local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
	if not weapon and type(ClientState.Weapon) == "table" then
		-- sans weaponId : tir local (GunController) -> arme en main
		weapon = ClientState.Weapon
	end
	local tint = if typeof(color) == "Color3" then color elseif weapon then weapon.TracerColor else DEFAULT_TRACER
	tint = tint or DEFAULT_TRACER
	local colors = colorSet(tint)

	tracer.From = from
	tracer.Dir = delta / length
	tracer.Length = length
	tracer.Speed = if weapon and weapon.Scope then TRACER_SPEED_SNIPER else TRACER_SPEED
	tracer.Streak = math.clamp(length * 0.4, 2.5, TRACER_STREAK)
	tracer.Traveled = math.min(length, 2 + tracer.Streak * 0.5)
	tracer.Core.Color = colors.Core
	tracer.Glow.Color = colors.Glow
	placeTracer(tracer)
	tracer.Core.Enabled = true
	tracer.Glow.Enabled = true
	if litTracers < MAX_TRACER_LIGHTS then
		tracer.Lit = true
		litTracers += 1
		tracer.Light.Color = tint
		tracer.Light.Enabled = true
	end
	table.insert(activeTracers, tracer)

	if weapon and weapon.Scope then
		spawnTrail(from, to, colors.Hot)
	end
end

--------------------------------------------------------------------------
-- Flash de bouche : étoile néon (3 lames + jet + cœur) + lumière, 2-3 frames
--------------------------------------------------------------------------
local function createFlash(): Flash
	local folder = getFolder()
	local core = newPart(Enum.PartType.Ball, Vector3.one * 0.3, WHITE, Enum.Material.Neon, 1)
	core.Name = "FlashCore"
	core.Parent = folder
	local jet = newPart(Enum.PartType.Cylinder, Vector3.new(0.6, 0.15, 0.15), WHITE, Enum.Material.Neon, 1)
	jet.Name = "FlashJet"
	jet.Parent = folder
	local blades = {}
	local offsets = {}
	for index = 1, 3 do
		local blade = newPart(Enum.PartType.Block, Vector3.new(0.03, 0.4, 0.5), WHITE, Enum.Material.Neon, 1)
		blade.Name = "FlashBlade"
		blade.Parent = folder
		blades[index] = blade
		offsets[index] = CFrame.new()
	end
	local light = Instance.new("PointLight")
	light.Shadows = false
	light.Enabled = false
	light.Parent = core
	return {
		Core = core,
		Jet = jet,
		Blades = blades,
		Offsets = offsets,
		CoreOffset = CFrame.new(),
		JetOffset = CFrame.new(),
		Roll = CFrame.new(),
		Light = light,
		Muzzle = nil,
		Frames = 0,
	}
end

local function hideFlash(flash: Flash)
	flash.Core.Transparency = 1
	flash.Jet.Transparency = 1
	for _, blade in flash.Blades do
		blade.Transparency = 1
	end
	flash.Light.Enabled = false
	flash.Muzzle = nil
end

-- Recale le flash sur le canon (l'arme bouge pendant les 2-3 frames).
local function placeFlash(flash: Flash): boolean
	local muzzle = flash.Muzzle
	if not muzzle or not muzzle.Parent then
		return false
	end
	local base = muzzle.WorldCFrame * flash.Roll
	flash.Core.CFrame = base * flash.CoreOffset
	flash.Jet.CFrame = base * flash.JetOffset
	for index, blade in flash.Blades do
		blade.CFrame = base * flash.Offsets[index]
	end
	return true
end

local function stepFlashes()
	for index = #activeFlashes, 1, -1 do
		local flash = activeFlashes[index]
		flash.Frames -= 1
		if flash.Frames <= 0 or not placeFlash(flash) then
			hideFlash(flash)
			table.remove(activeFlashes, index)
			table.insert(flashPool, flash)
		else
			-- frames suivantes : le flash s'éteint
			for _, blade in flash.Blades do
				blade.Transparency = 0.6
			end
			flash.Jet.Transparency = 0.55
			flash.Core.Transparency = 0.4
			flash.Light.Brightness *= 0.45
		end
	end
end

function Effects.MuzzleFlash(muzzle: Attachment?, color: Color3?)
	if typeof(muzzle) ~= "Instance" or not (muzzle :: Instance):IsA("Attachment") then
		return
	end
	local attachment = muzzle :: Attachment
	if not attachment:IsDescendantOf(workspace) then
		return
	end
	local distance = distanceToCamera(attachment.WorldPosition)
	if distance > 500 then
		return
	end
	ensureHost()

	local weapon = weaponFromInstance(attachment)
	local scale = if weapon then FLASH_SCALE[weapon.Sound] or 1 else 1
	local tint = if typeof(color) == "Color3" then color elseif weapon then weapon.TracerColor else DEFAULT_TRACER
	tint = tint or DEFAULT_TRACER
	local colors = colorSet(tint)

	local flash = table.remove(flashPool)
	if not flash then
		if #activeFlashes < MAX_FLASHES then
			flash = createFlash()
		else
			flash = table.remove(activeFlashes, 1)
			if flash then
				hideFlash(flash)
			end
		end
	end
	if not flash then
		return
	end

	local length = 0.5 * scale * random(0.8, 1.3)
	local width = 0.42 * scale * random(0.8, 1.2)
	flash.Roll = CFrame.Angles(0, 0, math.random() * math.pi * 2)
	flash.Core.Size = Vector3.one * (0.3 * scale * random(0.85, 1.15))
	flash.Core.Color = colors.Hot
	flash.Core.Transparency = 0.05
	flash.CoreOffset = CFrame.new(0, 0, -0.06 * scale)
	flash.Jet.Size = Vector3.new(length * 1.35, width * 0.3, width * 0.3)
	flash.Jet.Color = colors.Hot
	flash.Jet.Transparency = 0.2
	flash.JetOffset = CFrame.new(0, 0, -length * 0.65) * CFrame.Angles(0, math.pi / 2, 0)
	for index, blade in flash.Blades do
		blade.Size = Vector3.new(0.025, width, length)
		blade.Color = tint
		blade.Transparency = 0.15
		flash.Offsets[index] = CFrame.Angles(0, 0, (index - 1) * math.pi / 3) * CFrame.new(0, 0, -length * 0.5)
	end
	flash.Light.Color = tint
	flash.Light.Range = 8 + 5 * scale
	flash.Light.Brightness = 3.5
	flash.Light.Enabled = true
	flash.Muzzle = attachment
	flash.Frames = 3
	placeFlash(flash)
	table.insert(activeFlashes, flash)

	if distance < 160 then
		local frame = attachment.WorldCFrame
		emit(frame, emitters["Sparks:Ember"], 2)
		emit(frame, emitters.Smoke, 1)
	end
end

--------------------------------------------------------------------------
-- Corps balistiques (douilles, débris) : arc + rebond au sol + fondu
--------------------------------------------------------------------------
local function addBody(
	part: BasePart,
	position: Vector3,
	velocity: Vector3,
	rotation: CFrame,
	spin: Vector3,
	life: number,
	floorY: number,
	radius: number,
	bounce: number,
	pooled: boolean
)
	part.CFrame = rotation + position
	table.insert(bodies, {
		Part = part,
		Pos = position,
		Vel = velocity,
		Rot = rotation,
		Spin = spin,
		Age = 0,
		Life = life,
		FloorY = floorY,
		Radius = radius,
		Bounce = bounce,
		Pooled = pooled,
	})
end

local function finishBody(body: Body)
	if body.Pooled then
		activeShells -= 1
		body.Part.Transparency = 1
		if body.Part.Parent then
			table.insert(shellPool, body.Part)
		end
	else
		body.Part:Destroy()
	end
end

local function stepBodies(dt: number)
	local gravityStep = BODY_GRAVITY * dt
	for index = #bodies, 1, -1 do
		local body = bodies[index]
		body.Age += dt
		if body.Age >= body.Life or body.Part.Parent == nil then
			table.remove(bodies, index)
			finishBody(body)
		else
			local velocity = body.Vel + gravityStep
			local position = body.Pos + velocity * dt
			local floor = body.FloorY + body.Radius
			if position.Y < floor and velocity.Y < 0 then
				position = Vector3.new(position.X, floor, position.Z)
				local bounceY = -velocity.Y * body.Bounce
				if bounceY < 2 then
					bounceY = 0
				end
				velocity = Vector3.new(velocity.X * 0.45, bounceY, velocity.Z * 0.45)
				body.Spin *= 0.4
			end
			body.Vel = velocity
			body.Pos = position
			local spin = body.Spin
			body.Rot = body.Rot * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt)
			body.Part.CFrame = body.Rot + position
			local fadeStart = body.Life - 0.35
			if body.Age > fadeStart then
				body.Part.Transparency = math.min(1, (body.Age - fadeStart) / 0.35)
			end
		end
	end
end

local function spawnShell(eject: Attachment, spec)
	if not eject.Parent or not eject:IsDescendantOf(workspace) then
		return
	end
	if activeShells >= MAX_SHELLS then
		return
	end
	local frame = eject.WorldCFrame
	if distanceToCamera(frame.Position) > SHELL_MAX_DISTANCE then
		return
	end
	ensureHost()

	local part = table.remove(shellPool)
	if not part or not part.Parent then
		part = newPart(Enum.PartType.Cylinder, Vector3.new(0.2, 0.09, 0.09), BRASS, Enum.Material.Metal, 0)
		part.Name = "Shell"
		part.Parent = getFolder()
	end
	part.Size = Vector3.new(spec.Length, spec.Diameter, spec.Diameter)
	part.Color = spec.Color
	part.Material = spec.Material
	part.Reflectance = if spec.Material == Enum.Material.Metal then 0.25 else 0
	part.Transparency = 0

	-- vitesse héritée du porteur (douilles cohérentes en courant)
	local inherited = Vector3.zero
	local holder = eject.Parent
	if holder and holder:IsA("BasePart") then
		inherited = holder.AssemblyLinearVelocity * 0.9
	end
	local velocity = frame.RightVector * random(6, 9)
		+ frame.UpVector * random(4, 7)
		- frame.LookVector * random(0.5, 2)
		+ inherited
	local spin = Vector3.new(random(-25, 25), random(-30, 30), random(-25, 25))

	local floorY = -math.huge
	local ground = workspace:Raycast(frame.Position, Vector3.new(0, -14, 0), getWorldParams())
	if ground then
		floorY = ground.Position.Y
	end
	activeShells += 1
	-- axe X du cylindre aligné sur le canon
	addBody(
		part,
		frame.Position,
		velocity,
		frame.Rotation * CFrame.Angles(0, math.pi / 2, 0),
		spin,
		1.3,
		floorY,
		spec.Diameter * 0.5,
		0.35,
		true
	)
end

function Effects.Shell(eject: Attachment?, weaponId: string?)
	if typeof(eject) ~= "Instance" or not (eject :: Instance):IsA("Attachment") then
		return
	end
	local attachment = eject :: Attachment
	local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
	weapon = weapon or weaponFromInstance(attachment)
	local spec = weapon and SHELL_SPECS[weapon.Sound]
	if not spec then
		return
	end
	if spec.Delay then
		task.delay(spec.Delay, spawnShell, attachment, spec)
	else
		spawnShell(attachment, spec)
	end
end

--------------------------------------------------------------------------
-- « Pops » : petites sphères néon qui gonflent et s'éteignent (touche personnage, éclats)
--------------------------------------------------------------------------
local function spawnPop(position: Vector3, color: Color3, fromSize: number, toSize: number, life: number, alpha: number)
	local pop = table.remove(popPool)
	if pop and not pop.Part.Parent then
		pop = nil
	end
	if not pop then
		if #activePops >= MAX_POPS then
			return
		end
		local part = newPart(Enum.PartType.Ball, Vector3.one, color, Enum.Material.Neon, 1)
		part.Name = "Pop"
		part.Parent = getFolder()
		pop = { Part = part, Age = 0, Life = life, From = fromSize, To = toSize, Alpha = alpha }
	end
	local current = pop :: Pop
	current.Age = 0
	current.Life = math.max(life, 0.02)
	current.From = fromSize
	current.To = toSize
	current.Alpha = alpha
	current.Part.Color = color
	current.Part.Size = Vector3.one * fromSize
	current.Part.CFrame = CFrame.new(position)
	current.Part.Transparency = alpha
	table.insert(activePops, current)
end

local function stepPops(dt: number)
	for index = #activePops, 1, -1 do
		local pop = activePops[index]
		pop.Age += dt
		local k = pop.Age / pop.Life
		if k >= 1 or not pop.Part.Parent then
			pop.Part.Transparency = 1
			table.remove(activePops, index)
			if pop.Part.Parent then
				table.insert(popPool, pop)
			end
		else
			local eased = 1 - (1 - k) * (1 - k)
			pop.Part.Size = Vector3.one * (pop.From + (pop.To - pop.From) * eased)
			pop.Part.Transparency = pop.Alpha + (1 - pop.Alpha) * k
		end
	end
end

--------------------------------------------------------------------------
-- Trous de balle (pool circulaire, disparaissent après ~8 s)
--------------------------------------------------------------------------
local function spawnHole(position: Vector3, normal: Vector3, color: Color3, hot: boolean, baseTransparency: number)
	holeIndex = holeIndex % MAX_HOLES + 1
	local hole = holes[holeIndex]
	if hole and not hole.Part.Parent then
		hole = nil
	end
	if not hole then
		local part = newPart(Enum.PartType.Cylinder, Vector3.new(0.02, 0.2, 0.2), color, Enum.Material.SmoothPlastic, 1)
		part.Name = "BulletHole"
		part.Parent = getFolder()
		hole = { Part = part, Born = 0, Active = false, Hot = false, Base = 0, Color = color }
		holes[holeIndex] = hole
	end
	local current = hole :: Hole
	local part = current.Part
	local size = random(0.16, 0.24)
	part.Size = Vector3.new(0.02, size, size)
	-- axe X du cylindre (son épaisseur) aligné sur la normale
	part.CFrame = CFrame.lookAt(position + normal * 0.012, position + normal * 2, upFor(normal))
		* CFrame.Angles(0, math.pi / 2, 0)
	current.Hot = hot
	current.Color = color
	current.Base = baseTransparency
	current.Born = os.clock()
	current.Active = true
	if hot then
		-- métal : le trou rougeoie une fraction de seconde
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(255, 150, 60)
		part.Transparency = 0
	else
		part.Material = Enum.Material.SmoothPlastic
		part.Color = color
		part.Transparency = baseTransparency
	end
end

local function stepHoles(now: number)
	for _, hole in holes do
		if hole.Active then
			local part = hole.Part
			local age = now - hole.Born
			if hole.Hot and age > 0.15 then
				hole.Hot = false
				part.Material = Enum.Material.SmoothPlastic
				part.Color = hole.Color
				part.Transparency = hole.Base
			end
			if age >= HOLE_LIFE then
				hole.Active = false
				part.Transparency = 1
			elseif age > HOLE_LIFE - HOLE_FADE then
				local k = (age - (HOLE_LIFE - HOLE_FADE)) / HOLE_FADE
				part.Transparency = hole.Base + (1 - hole.Base) * k
			end
		end
	end
end

--------------------------------------------------------------------------
-- Impacts
--------------------------------------------------------------------------
local function impactAt(
	position: Vector3,
	normal: Vector3,
	part: Instance?,
	material: Enum.Material,
	surfaceColor: Color3,
	isCharacter: boolean
)
	local distance = distanceToCamera(position)
	if distance > FX_MAX_DISTANCE then
		return
	end
	ensureHost()
	local frame = frameFacing(position, normal)
	local near = distance < 160

	if isCharacter then
		-- pas de sang : une étincelle vive et un petit éclat lumineux
		emit(frame, emitters.HitSpark, if near then 10 else 5)
		spawnPop(position, HIT_POP_COLOR, 0.3, 1.4, 0.14, 0)
		return
	end

	local style = IMPACT_STYLES[MATERIAL_KIND[material] or "Plastic"] or IMPACT_STYLES.Plastic
	local scale = if near then 1 else 0.4
	if style.SparkKey then
		emit(frame, emitters[style.SparkKey], style.SparkCount * scale)
	end
	if style.DustKey then
		emit(frame, emitters[style.DustKey], style.DustCount * scale)
	end
	if style.ChipKey then
		emit(frame, emitters[style.ChipKey], style.ChipCount * scale)
	end

	-- trou de balle seulement sur le décor fixe (sinon il flotterait dans le vide)
	if style.NoHole or not part or distance > 300 then
		return
	end
	local fixed = false
	if part:IsA("Terrain") then
		fixed = true
	elseif part:IsA("BasePart") then
		fixed = part.Anchored and part.Transparency < 0.5
	end
	if fixed then
		local holeColor = style.HoleColor or surfaceColor:Lerp(Color3.new(0.04, 0.04, 0.045), 0.85)
		spawnHole(position, normal, holeColor, style.Hot == true, style.HoleTransparency or 0.05)
	end
end

function Effects.Impact(position: Vector3, normal: Vector3, hitPart: BasePart?, isCharacter: boolean?)
	if not isFiniteVector(position) then
		return
	end
	local surfaceNormal = Vector3.yAxis
	if isFiniteVector(normal) and normal.Magnitude > 0.01 then
		surfaceNormal = normal.Unit
	end
	if isCharacter == true then
		impactAt(position, surfaceNormal, hitPart, Enum.Material.Plastic, WHITE, true)
		return
	end

	local part: Instance? = if typeof(hitPart) == "Instance" then hitPart else nil
	local material = Enum.Material.Plastic
	local color = Color3.fromRGB(150, 150, 150)
	if part and part:IsA("BasePart") and not part:IsA("Terrain") then
		material = part.Material
		color = part.Color
	else
		-- Terrain (matériau par voxel) ou pièce inconnue : petit rayon pour lire la surface
		local result = probeSurface(position, surfaceNormal)
		if result then
			part = result.Instance
			material = result.Material
			color = surfaceColorOf(result)
		end
	end
	impactAt(position, surfaceNormal, part, material, color, false)
end

--------------------------------------------------------------------------
-- Sons d'armes
--------------------------------------------------------------------------
function Effects.PlayWeaponSound(weaponId: string, at: (Instance | Vector3)?): Sound?
	local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
	if not weapon then
		return nil
	end
	local soundId = Config.Sounds.Weapons[weapon.Sound]
	local profile = SOUND_PROFILES[weapon.Sound] or DEFAULT_SOUND_PROFILE
	if typeof(at) == "Vector3" then
		if not isFiniteVector(at) or distanceToCamera(at) > profile.Range then
			return nil
		end
		return Sfx.PlayAt(soundId, at, profile.Volume, 0.06, profile.Range)
	elseif typeof(at) == "Instance" then
		local instance = at :: Instance
		if not instance:IsDescendantOf(workspace) then
			return nil
		end
		local position: Vector3? = nil
		if instance:IsA("Attachment") then
			position = instance.WorldPosition
		elseif instance:IsA("BasePart") then
			position = instance.Position
		end
		if not position or distanceToCamera(position) > profile.Range then
			return nil -- trop loin pour être entendu : pas de Sound créé
		end
		return Sfx.PlayAt(soundId, instance, profile.Volume, 0.06, profile.Range)
	end
	-- pas de position : son « interface » (tir local sans repère)
	return Sfx.Play2D(soundId, profile.Volume, 1)
end

--------------------------------------------------------------------------
-- Tirs des autres joueurs (Remotes.ShotFx)
--------------------------------------------------------------------------
local function onShotFx(shooter: any, weaponId: any, origin: any, impacts: any)
	if typeof(shooter) ~= "Instance" or not shooter:IsA("Player") or shooter == LocalPlayer then
		return
	end
	local weapon = if type(weaponId) == "string" then Weapons.ById[weaponId] else nil
	if not weapon or not isFiniteVector(origin) then
		return
	end

	local character = shooter.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	local muzzle = getAttachment(tool, "Muzzle")
	local start: Vector3 = origin
	if muzzle and (muzzle.WorldPosition - origin).Magnitude < 12 then
		start = muzzle.WorldPosition
	else
		muzzle = nil
	end
	local distance = distanceToCamera(start)

	Effects.PlayWeaponSound(weapon.Id, if muzzle then muzzle else start)
	if muzzle then
		Effects.MuzzleFlash(muzzle, weapon.TracerColor)
	end
	if tool and distance < SHELL_MAX_DISTANCE then
		local eject = getAttachment(tool, "Eject")
		if eject then
			Effects.Shell(eject, weapon.Id)
		end
	end

	if type(impacts) ~= "table" then
		return
	end
	local maxImpacts = math.max(1, weapon.Pellets or 1) + 2
	local count = 0
	for _, impact in impacts do
		count += 1
		if count > maxImpacts then
			break
		end
		if type(impact) == "table" and isFiniteVector(impact.Position) then
			local position: Vector3 = impact.Position
			Effects.Tracer(start, position, weapon.TracerColor, weapon.Id)
			local normal = impact.Normal
			local hasNormal = isFiniteVector(normal) and normal.Magnitude > 0.01
			if impact.Character == true then
				Effects.Impact(position, if hasNormal then normal else (start - position), nil, true)
			elseif hasNormal then
				-- tir manqué (normale nulle) = rien à afficher au bout ; sinon on lit la surface
				local unit = normal.Unit
				local result = probeSurface(position, unit)
				if result then
					impactAt(position, unit, result.Instance, result.Material, surfaceColorOf(result), false)
				end
			end
		end
	end
end

--------------------------------------------------------------------------
-- Chiffres de dégâts (Remotes.HitConfirm)
--------------------------------------------------------------------------
type DamageNumber = {
	Attachment: Attachment,
	Gui: BillboardGui,
	Label: TextLabel,
	Stroke: UIStroke,
	Scale: UIScale,
	Anchor: Vector3,
	Total: number,
	Headshot: boolean,
	Killed: boolean,
	Updated: number,
	Token: number,
	Fading: boolean,
	PopTween: Tween?,
}
local damageNumbers: { DamageNumber } = {}

local function destroyNumber(entry: DamageNumber)
	local index = table.find(damageNumbers, entry)
	if index then
		table.remove(damageNumbers, index)
	end
	entry.Token += 1
	if entry.PopTween then
		entry.PopTween:Cancel()
	end
	entry.Attachment:Destroy()
end

local function refreshNumber(entry: DamageNumber, strong: boolean)
	local label = entry.Label
	local color = Ui.Colors.Text
	local size = 30
	if entry.Headshot then
		color = Config.Colors.Gold
		size = 36
	end
	if entry.Killed then
		size += 6
		if not entry.Headshot then
			color = Config.Colors.Accent2
		end
	end
	label.TextColor3 = color
	label.TextSize = size
	label.Text = tostring(math.floor(entry.Total + 0.5)) .. (if entry.Killed then " 💀" else "")
	label.TextTransparency = 0
	entry.Stroke.Transparency = 0

	if entry.PopTween then
		entry.PopTween:Cancel()
	end
	entry.Scale.Scale = if strong then 1.9 else 1.45
	entry.PopTween = tween(entry.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	entry.Updated = os.clock()
	entry.Token += 1
	local token = entry.Token
	task.delay(0.8, function()
		if entry.Token ~= token then
			return
		end
		if not entry.Attachment.Parent then
			destroyNumber(entry)
			return
		end
		entry.Fading = true
		tween(label, 0.35, { TextTransparency = 1 })
		tween(entry.Stroke, 0.35, { Transparency = 1 })
		task.delay(0.4, function()
			if entry.Token == token then
				destroyNumber(entry)
			end
		end)
	end)
end

local function showDamageNumber(position: Vector3, damage: number, headshot: boolean, killed: boolean)
	local now = os.clock()
	-- même cible touchée à l'instant : on cumule dans le même chiffre
	for _, entry in damageNumbers do
		if not entry.Fading and now - entry.Updated < 0.7 and (entry.Anchor - position).Magnitude < 6 then
			entry.Total += damage
			entry.Headshot = entry.Headshot or headshot
			entry.Killed = entry.Killed or killed
			entry.Anchor = position
			refreshNumber(entry, headshot or killed)
			return
		end
	end

	while #damageNumbers >= MAX_DAMAGE_NUMBERS do
		destroyNumber(damageNumbers[1])
	end
	ensureHost()

	local attachment = Instance.new("Attachment")
	attachment.Name = "DamageNumber"
	attachment.Position = position + Vector3.new(random(-0.8, 0.8), 1.2, random(-0.8, 0.8))
	attachment.Parent = host
	local gui = Ui.new("BillboardGui", {
		Name = "DamageNumberGui",
		Size = UDim2.fromOffset(220, 64),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 1200,
		StudsOffsetWorldSpace = Vector3.zero,
		ResetOnSpawn = false,
		Parent = attachment,
	})
	local label = Ui.label({
		Name = "Value",
		Size = UDim2.fromScale(1, 1),
		TextScaled = false,
		TextSize = 30,
		FontFace = Ui.Fonts.Title,
		Text = "",
		Parent = gui,
	})
	local stroke = Ui.new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = 2.2,
		Transparency = 0,
		Parent = label,
	})
	local scale = Ui.new("UIScale", { Parent = label })

	local entry: DamageNumber = {
		Attachment = attachment,
		Gui = gui,
		Label = label,
		Stroke = stroke,
		Scale = scale,
		Anchor = position,
		Total = damage,
		Headshot = headshot,
		Killed = killed,
		Updated = now,
		Token = 0,
		Fading = false,
		PopTween = nil,
	}
	table.insert(damageNumbers, entry)
	tween(gui, 1.1, { StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	refreshNumber(entry, headshot or killed)
end

local function onHitConfirm(position: any, damage: any, headshot: any, killed: any)
	if not isFiniteVector(position) or not isFiniteNumber(damage) then
		return
	end
	local isHeadshot = headshot == true
	local isKill = killed == true
	Sfx.Play2D(Config.Sounds.Hitmarker, 0.55, 1 + random(-0.04, 0.04))
	if isHeadshot then
		Sfx.Play2D(Config.Sounds.Headshot, 0.7)
	end
	if isKill then
		Sfx.Play2D(Config.Sounds.Kill, 0.8)
	end
	local settings = ClientState.Settings
	if type(settings) == "table" and settings.DamageNumbers == false then
		return
	end
	showDamageNumber(position, math.max(0, damage), isHeadshot, isKill)
end

--------------------------------------------------------------------------
-- Anneaux au sol (segments néon) : radar, frappe orbitale, ondes de choc
--------------------------------------------------------------------------
type Ring = { Parts: { BasePart }, Thickness: number, Height: number }

local function createRing(count: number, color: Color3, thickness: number, height: number, transparency: number): Ring
	local folder = getFolder()
	local parts = table.create(count)
	for index = 1, count do
		local part = newPart(Enum.PartType.Block, Vector3.new(thickness, height, 1), color, Enum.Material.Neon, transparency)
		part.Name = "RingSegment"
		part.Parent = folder
		parts[index] = part
	end
	return { Parts = parts, Thickness = thickness, Height = height }
end

local function setRing(ring: Ring, center: Vector3, radius: number, transparency: number?)
	local count = #ring.Parts
	local segment = math.max(0.05, (2 * math.pi * radius / count) * 1.06)
	local size = Vector3.new(ring.Thickness, ring.Height, segment)
	for index, part in ring.Parts do
		local angle = (index - 1) / count * 2 * math.pi
		part.Size = size
		-- X local = radial (épaisseur), Z local = tangente
		part.CFrame = CFrame.new(center.X + math.cos(angle) * radius, center.Y, center.Z + math.sin(angle) * radius)
			* CFrame.Angles(0, -angle, 0)
		if transparency then
			part.Transparency = transparency
		end
	end
end

local function setRingTransparency(ring: Ring, transparency: number)
	for _, part in ring.Parts do
		part.Transparency = transparency
	end
end

local function destroyRing(ring: Ring)
	for _, part in ring.Parts do
		part:Destroy()
	end
end

-- Anneau qui s'élargit en s'effaçant.
local function shockRing(center: Vector3, maxRadius: number, color: Color3, life: number, thickness: number)
	local ring = createRing(44, color, thickness, 0.45, 0)
	local start = os.clock()
	while true do
		local k = (os.clock() - start) / life
		if k >= 1 then
			break
		end
		local eased = 1 - (1 - k) ^ 3
		setRing(ring, center, 1 + eased * maxRadius, k)
		task.wait()
	end
	destroyRing(ring)
end

--------------------------------------------------------------------------
-- Highlights (radar, killcam)
--------------------------------------------------------------------------
local function makeHighlight(name: string, adornee: Instance, fill: Color3, outline: Color3, fillTransparency: number): Highlight
	local highlight = Instance.new("Highlight")
	highlight.Name = name
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = fill
	highlight.OutlineColor = outline
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 1
	highlight.Adornee = adornee
	highlight.Parent = getFolder()
	tween(highlight, 0.35, { FillTransparency = fillTransparency, OutlineTransparency = 0 })
	return highlight
end

local function fadeHighlight(highlight: Highlight)
	if not highlight.Parent then
		return
	end
	tween(highlight, 0.3, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(highlight, 0.35)
end

--------------------------------------------------------------------------
-- Radar : tous les autres joueurs visibles en rouge à travers les murs
--------------------------------------------------------------------------
local radar = {
	Until = 0,
	Running = false,
	Highlights = {} :: { [Player]: Highlight },
}

local function localRoot(): BasePart?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function refreshRadar()
	local root = localRoot()
	local origin = if root then root.Position else (cameraPosition() or Vector3.zero)
	local candidates = {}
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local theirRoot = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and humanoid.Health > 0 and theirRoot and theirRoot:IsA("BasePart") then
				table.insert(candidates, {
					Player = player,
					Character = character,
					Distance = (theirRoot.Position - origin).Magnitude,
				})
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)

	local keep = {}
	for index, candidate in candidates do
		if index > RADAR_MAX_HIGHLIGHTS then
			break
		end
		keep[candidate.Player] = true
		local highlight = radar.Highlights[candidate.Player]
		if highlight and (highlight.Parent == nil or highlight.Adornee ~= candidate.Character) then
			-- réapparition : nouveau personnage
			highlight:Destroy()
			highlight = nil
		end
		if not highlight then
			radar.Highlights[candidate.Player] = makeHighlight(
				"RadarHighlight",
				candidate.Character,
				Config.Colors.Bad,
				Color3.fromRGB(255, 170, 170),
				0.55
			)
		end
	end
	for player, highlight in radar.Highlights do
		if not keep[player] then
			radar.Highlights[player] = nil
			fadeHighlight(highlight)
		end
	end
end

local function clearRadar()
	for player, highlight in radar.Highlights do
		radar.Highlights[player] = nil
		fadeHighlight(highlight)
	end
end

-- Onde de balayage cyan autour du joueur à l'activation.
local function radarWave()
	local root = localRoot()
	if not root then
		return
	end
	local center = root.Position - Vector3.new(0, 2.6, 0)
	local ring = createRing(48, Config.Colors.Accent, 0.6, 0.35, 0.1)
	local start = os.clock()
	local life = 1.4
	while true do
		local k = (os.clock() - start) / life
		if k >= 1 then
			break
		end
		local eased = 1 - (1 - k) ^ 3
		setRing(ring, center, 2 + eased * 160, 0.1 + 0.9 * k)
		task.wait()
	end
	destroyRing(ring)
end

local function startRadar(duration: number)
	radar.Until = math.max(radar.Until, os.clock() + math.clamp(duration, 0, 120))
	Sfx.Play2D(Config.Sounds.Radar, 0.7)
	task.spawn(radarWave)
	if radar.Running then
		return
	end
	radar.Running = true
	task.spawn(function()
		while os.clock() < radar.Until do
			refreshRadar()
			task.wait(0.25)
		end
		clearRadar()
		radar.Running = false
	end)
end

--------------------------------------------------------------------------
-- Frappe orbitale
--------------------------------------------------------------------------
local ORBITAL = findKillstreak("Orbital")
local CYLINDER_UP = CFrame.Angles(0, 0, math.pi / 2) -- axe X du cylindre -> vertical

local function orbitalImpact(ground: Vector3, radius: number, groundColor: Color3)
	local folder = getFolder()
	ensureHost()
	Sfx.PlayAt(Config.Sounds.Orbital, ground, 1.2, 0.03, 1500)

	-- colonne géante blanc-bleu venue du ciel
	local columnFrame = CFrame.new(ground + Vector3.new(0, 400, 0)) * CYLINDER_UP
	local core = newPart(Enum.PartType.Cylinder, Vector3.new(800, 2, 2), Color3.fromRGB(240, 250, 255), Enum.Material.Neon, 0)
	core.Name = "OrbitalCore"
	core.CFrame = columnFrame
	core.Parent = folder
	local glow = newPart(Enum.PartType.Cylinder, Vector3.new(800, 5, 5), Color3.fromRGB(90, 170, 255), Enum.Material.Neon, 0.5)
	glow.Name = "OrbitalGlow"
	glow.CFrame = columnFrame
	glow.Parent = folder
	tween(core, 0.12, { Size = Vector3.new(800, radius * 0.75, radius * 0.75) })
	tween(glow, 0.15, { Size = Vector3.new(800, radius * 1.6, radius * 1.6) })
	-- 2e phase lancée après coup (un tween différé sur la même propriété annulerait le premier)
	task.delay(0.18, function()
		if core.Parent then
			tween(core, 0.9, { Size = Vector3.new(800, 0.2, 0.2), Transparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		end
		if glow.Parent then
			tween(glow, 1.1, { Size = Vector3.new(800, 0.5, 0.5), Transparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		end
	end)
	Debris:AddItem(core, 1.4)
	Debris:AddItem(glow, 1.5)

	-- sphère d'énergie + éclair central
	local sphere = newPart(Enum.PartType.Ball, Vector3.one * 4, Color3.fromRGB(160, 215, 255), Enum.Material.ForceField, 0)
	sphere.CFrame = CFrame.new(ground)
	sphere.Parent = folder
	tween(sphere, 0.7, { Size = Vector3.one * radius * 2.6, Transparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	Debris:AddItem(sphere, 0.8)
	spawnPop(ground + Vector3.new(0, 1, 0), WHITE, 3, radius * 1.4, 0.35, 0)

	-- lumière éblouissante
	local lightPart = newPart(Enum.PartType.Block, Vector3.one * 0.2, WHITE, Enum.Material.SmoothPlastic, 1)
	lightPart.CFrame = CFrame.new(ground + Vector3.new(0, 5, 0))
	lightPart.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 215, 255)
	light.Range = 60
	light.Brightness = 14
	light.Shadows = false
	light.Parent = lightPart
	tween(light, 0.9, { Brightness = 0 })
	Debris:AddItem(lightPart, 1)

	-- particules
	local upFrame = frameFacing(ground + Vector3.new(0, 0.5, 0), Vector3.yAxis)
	emit(upFrame, emitters.BigSparks, 70)
	emit(upFrame, emitters.BigSmoke, 18)

	-- débris projetés (non poolés, détruits en fin de vie)
	local rockColor = groundColor:Lerp(Color3.fromRGB(26, 26, 30), 0.45)
	for _ = 1, 16 do
		local size = random(0.4, 1.3)
		local rock = newPart(
			Enum.PartType.Block,
			Vector3.new(size, size * random(0.6, 1), size * random(0.6, 1.2)),
			rockColor,
			Enum.Material.Slate,
			0
		)
		rock.Name = "Debris"
		rock.Parent = folder
		local angle = math.random() * math.pi * 2
		local velocity = Vector3.new(math.cos(angle), 0, math.sin(angle)) * random(14, 38)
			+ Vector3.new(0, random(28, 60), 0)
		addBody(
			rock,
			ground + Vector3.new(0, 1, 0),
			velocity,
			CFrame.Angles(random(0, 6.28), random(0, 6.28), random(0, 6.28)),
			Vector3.new(random(-8, 8), random(-8, 8), random(-8, 8)),
			random(1.8, 2.6),
			ground.Y,
			size * 0.4,
			0.3,
			false
		)
	end

	-- ondes de choc au sol
	task.spawn(shockRing, ground + Vector3.new(0, 0.3, 0), radius * 2.2, Color3.fromRGB(205, 235, 255), 0.7, 1.2)
	task.delay(0.12, shockRing, ground + Vector3.new(0, 0.25, 0), radius * 1.6, Config.Colors.Accent, 0.9, 0.8)

	-- brûlure au sol + braises
	local scorch = newPart(
		Enum.PartType.Cylinder,
		Vector3.new(0.06, radius * 1.7, radius * 1.7),
		Color3.fromRGB(16, 16, 20),
		Enum.Material.SmoothPlastic,
		0.1
	)
	scorch.Name = "Scorch"
	scorch.CFrame = CFrame.new(ground + Vector3.new(0, 0.04, 0)) * CYLINDER_UP
	scorch.Parent = folder
	tween(scorch, 2, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 6)
	Debris:AddItem(scorch, 8.2)
	local ember = newPart(
		Enum.PartType.Cylinder,
		Vector3.new(0.07, radius * 0.9, radius * 0.9),
		Color3.fromRGB(255, 120, 40),
		Enum.Material.Neon,
		0.2
	)
	ember.Name = "Embers"
	ember.CFrame = CFrame.new(ground + Vector3.new(0, 0.06, 0)) * CYLINDER_UP
	ember.Parent = folder
	tween(ember, 2.5, { Transparency = 1, Size = Vector3.new(0.07, radius * 0.4, radius * 0.4) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(ember, 2.6)

	-- tremblement + flash d'écran selon la distance
	local root = localRoot()
	local listener = if root then root.Position else (cameraPosition() or ground)
	local distance = (listener - ground).Magnitude
	local intensity = math.clamp(1.15 - distance / (radius * 10), 0, 1)
	if intensity > 0.03 then
		ClientState.Emit("CameraShake", intensity)
		local flash = Instance.new("ColorCorrectionEffect")
		flash.Name = "OrbitalFlashCC"
		flash.Brightness = 0.35 * intensity
		flash.TintColor = Color3.fromRGB(215, 235, 255)
		flash.Parent = Lighting
		tween(flash, 0.6, { Brightness = 0, TintColor = WHITE })
		Debris:AddItem(flash, 0.7)
	end
end

local function orbitalStrike(target: Vector3, delayTime: number)
	local radius = if ORBITAL and type(ORBITAL.Radius) == "number" then ORBITAL.Radius else 22
	local duration = math.clamp(delayTime, 0, 10)

	-- recale sur le sol réel
	local ground = target
	local groundColor = Color3.fromRGB(70, 70, 75)
	local result = workspace:Raycast(target + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), getWorldParams())
	if result then
		ground = result.Position
		groundColor = surfaceColorOf(result)
	end
	local folder = getFolder()
	local red = Color3.fromRGB(255, 45, 60)
	local center = ground + Vector3.new(0, 0.12, 0)

	-- avertissement : anneau pulsant, anneau « compte à rebours » qui se resserre, disque qui se remplit,
	-- rayon de visée vertical, chevrons tournants, lumière rouge
	local outer = createRing(40, red, 0.5, 0.22, 0.2)
	setRing(outer, center, radius)
	local inner = createRing(40, Color3.fromRGB(255, 205, 205), 0.3, 0.2, 0.1)
	local disc = newPart(Enum.PartType.Cylinder, Vector3.new(0.1, 0.1, 0.1), red, Enum.Material.Neon, 0.82)
	disc.Name = "OrbitalFill"
	disc.CFrame = CFrame.new(center) * CYLINDER_UP
	disc.Parent = folder
	local beam = newPart(Enum.PartType.Cylinder, Vector3.new(500, 0.6, 0.6), red, Enum.Material.Neon, 0.25)
	beam.Name = "OrbitalBeam"
	beam.CFrame = CFrame.new(ground + Vector3.new(0, 250, 0)) * CYLINDER_UP
	beam.Parent = folder
	local marks = {}
	for index = 1, 4 do
		local mark = newPart(Enum.PartType.Block, Vector3.new(0.35, 0.22, radius * 0.25), WHITE, Enum.Material.Neon, 0.15)
		mark.Name = "OrbitalMark"
		mark.Parent = folder
		marks[index] = mark
	end
	local lightPart = newPart(Enum.PartType.Block, Vector3.one * 0.2, red, Enum.Material.SmoothPlastic, 1)
	lightPart.CFrame = CFrame.new(ground + Vector3.new(0, 3, 0))
	lightPart.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = red
	light.Range = radius * 1.4
	light.Brightness = 2
	light.Shadows = false
	light.Parent = lightPart
	Sfx.PlayAt(Config.Sounds.OrbitalCharge, ground, 1, 0, 700)

	local start = os.clock()
	local phase = 0
	while true do
		local dt = task.wait()
		local t = os.clock() - start
		if t >= duration then
			break
		end
		local k = t / math.max(duration, 0.01)
		phase += dt * (2.5 + k * 12) * math.pi * 2 -- le pouls accélère jusqu'à l'impact
		local pulse = 0.5 + 0.5 * math.sin(phase)
		setRingTransparency(outer, 0.05 + 0.45 * (1 - pulse))
		setRing(inner, center, math.max(0.3, radius * (1 - k)), 0.1)
		local fill = math.max(0.1, radius * 2 * k)
		disc.Size = Vector3.new(0.1, fill, fill)
		disc.Transparency = 0.86 - 0.1 * pulse
		local width = 0.4 + 0.6 * pulse + k * 0.8
		beam.Size = Vector3.new(500, width, width)
		light.Brightness = 1 + 4 * pulse * (0.5 + k)
		local spinAngle = t * (1.5 + k * 4)
		local markRadius = radius * (0.55 - 0.3 * k)
		for index, mark in marks do
			local angle = spinAngle + (index - 1) * math.pi / 2
			mark.CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * markRadius, 0.05, math.sin(angle) * markRadius))
				* CFrame.Angles(0, math.pi / 2 - angle, 0)
		end
	end

	destroyRing(outer)
	destroyRing(inner)
	disc:Destroy()
	beam:Destroy()
	for _, mark in marks do
		mark:Destroy()
	end
	lightPart:Destroy()
	orbitalImpact(ground, radius, groundColor)
end

local function onRewardFx(rewardId: any, owner: any, position: any, duration: any)
	local seconds = if isFiniteNumber(duration) then duration else 0
	if rewardId == "Radar" then
		if owner == nil or owner == LocalPlayer then
			local definition = findKillstreak("Radar")
			if seconds <= 0 and definition then
				seconds = definition.Duration or 10
			end
			startRadar(seconds)
		end
	elseif rewardId == "Orbital" then
		if isFiniteVector(position) then
			task.spawn(orbitalStrike, position, seconds)
		end
	end
end

--------------------------------------------------------------------------
-- Pose de visée (R15) : inclinaison buste / tête / bras + IK main gauche
--------------------------------------------------------------------------
type Pose = {
	Character: Model,
	Humanoid: Humanoid,
	IsLocal: boolean,
	Tool: Tool?,
	ReleaseAt: number,
	Waist: Motor6D,
	WaistC0: CFrame,
	Neck: Motor6D?,
	NeckC0: CFrame,
	Shoulder: Motor6D?,
	ShoulderC0: CFrame,
	Ik: IKControl?,
	IkWeight: number,
	Pole: Attachment?,
	Pitch: number,
	Applied: number,
}
local poses: { [Model]: Pose } = {}

local function removePose(character: Model)
	local pose = poses[character]
	if not pose then
		return
	end
	poses[character] = nil
	if pose.Ik then
		pose.Ik:Destroy()
	end
	if pose.Pole then
		pose.Pole:Destroy()
	end
	-- C0 d'origine restaurés
	if pose.Waist.Parent then
		pose.Waist.C0 = pose.WaistC0
	end
	if pose.Neck and pose.Neck.Parent then
		pose.Neck.C0 = pose.NeckC0
	end
	if pose.Shoulder and pose.Shoulder.Parent then
		pose.Shoulder.C0 = pose.ShoulderC0
	end
end

local function getMotor(parent: Instance?, name: string): Motor6D?
	local motor = parent and parent:FindFirstChild(name)
	if motor and motor:IsA("Motor6D") then
		return motor
	end
	return nil
end

local function onToolEquipped(player: Player, character: Model, humanoid: Humanoid, tool: Tool)
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return -- R6 : pas de Waist / IK
	end
	-- les pièces de l'arme peuvent arriver un peu après le Tool : on attend LeftGrip (max ~1,5 s)
	local leftGrip: Attachment? = nil
	for _ = 1, 15 do
		if tool.Parent ~= character or humanoid.Health <= 0 then
			return
		end
		leftGrip = getAttachment(tool, "LeftGrip")
		if leftGrip then
			break
		end
		task.wait(0.1)
	end
	if tool.Parent ~= character or humanoid.Health <= 0 then
		return
	end
	if not leftGrip and tool:GetAttribute("WeaponId") == nil then
		return -- pas une arme du jeu
	end

	local upperTorso = character:FindFirstChild("UpperTorso")
	local waist = getMotor(upperTorso, "Waist")
	if not upperTorso or not waist then
		return
	end

	local pose = poses[character]
	if not pose then
		local neck = getMotor(character:FindFirstChild("Head"), "Neck")
		local shoulder = getMotor(character:FindFirstChild("RightUpperArm"), "RightShoulder")
		pose = {
			Character = character,
			Humanoid = humanoid,
			IsLocal = player == LocalPlayer,
			Tool = nil,
			ReleaseAt = 0,
			Waist = waist,
			WaistC0 = waist.C0,
			Neck = neck,
			NeckC0 = if neck then neck.C0 else CFrame.new(),
			Shoulder = shoulder,
			ShoulderC0 = if shoulder then shoulder.C0 else CFrame.new(),
			Ik = nil,
			IkWeight = 1,
			Pole = nil,
			Pitch = 0,
			Applied = math.huge,
		}
		poses[character] = pose
	end
	local current = pose :: Pose
	current.Tool = tool

	if current.Ik then
		current.Ik:Destroy()
		current.Ik = nil
	end
	local leftUpperArm = character:FindFirstChild("LeftUpperArm")
	local leftHand = character:FindFirstChild("LeftHand")
	if leftGrip and leftUpperArm and leftHand and leftUpperArm:IsA("BasePart") and leftHand:IsA("BasePart") then
		if not current.Pole or not current.Pole.Parent then
			-- coude gauche orienté vers le bas / l'extérieur
			local pole = Instance.new("Attachment")
			pole.Name = "AimElbowPole"
			pole.Position = Vector3.new(-1.1, -2, -0.4)
			pole.Parent = upperTorso
			current.Pole = pole
		end
		local ik = Instance.new("IKControl")
		ik.Name = "AimLeftHandIK"
		ik.Type = Enum.IKControlType.Transform
		ik.ChainRoot = leftUpperArm
		ik.EndEffector = leftHand
		ik.Target = leftGrip
		ik.Pole = current.Pole
		ik.Weight = 1
		current.IkWeight = 1
		ik.Priority = 1
		trySet(ik, "SmoothTime", 0.04)
		ik.Enabled = true
		ik.Parent = humanoid
		current.Ik = ik
	end
end

local function onToolRemoved(character: Model, tool: Tool)
	local pose = poses[character]
	if not pose or pose.Tool ~= tool then
		return
	end
	-- changement d'arme : on garde les C0 un court instant pour éviter un « clignotement » du buste
	pose.Tool = nil
	pose.ReleaseAt = os.clock() + 0.25
	if pose.Ik then
		pose.Ik.Enabled = false
	end
end

local function stepPoses(dt: number)
	if next(poses) == nil then
		return
	end
	local camera = workspace.CurrentCamera
	local alpha = 1 - math.exp(-dt * 12)
	local now = os.clock()
	for character, pose in poses do
		local tool = pose.Tool
		if not tool then
			if now >= pose.ReleaseAt then
				removePose(character)
			end
			continue
		end
		if tool.Parent ~= character or pose.Humanoid.Health <= 0 or not pose.Waist.Parent or not character.Parent then
			removePose(character)
			continue
		end
		local target = 0
		if pose.IsLocal and camera then
			-- soi : inclinaison caméra directe (aucun retard)
			target = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
		else
			local attribute = character:GetAttribute("AimPitch")
			if isFiniteNumber(attribute) then
				target = attribute
			end
		end
		target = math.clamp(target, -AIM_PITCH_LIMIT, AIM_PITCH_LIMIT)
		local pitch = if pose.IsLocal then target else pose.Pitch + (target - pose.Pitch) * alpha
		pose.Pitch = pitch
		if math.abs(pitch - pose.Applied) > 0.002 then
			pose.Applied = pitch
			pose.Waist.C0 = pose.WaistC0 * CFrame.Angles(pitch * WAIST_SHARE, 0, 0)
			local neck = pose.Neck
			if neck and neck.Parent then
				neck.C0 = pose.NeckC0 * CFrame.Angles(pitch * NECK_SHARE, 0, 0)
			end
			local shoulder = pose.Shoulder
			if shoulder and shoulder.Parent then
				shoulder.C0 = pose.ShoulderC0 * CFrame.Angles(pitch * SHOULDER_SHARE, 0, 0)
			end
		end
		-- rechargement : la main gauche quitte l'arme (geste de recharge) puis revient
		local ik = pose.Ik
		if ik then
			local goal = if tool:GetAttribute("Reloading") == true then 0 else 1
			if pose.IkWeight ~= goal then
				local weight = pose.IkWeight + (goal - pose.IkWeight) * math.min(1, dt * 10)
				if math.abs(goal - weight) < 0.01 then
					weight = goal
				end
				pose.IkWeight = weight
				ik.Weight = weight
			end
		end
	end
end

--------------------------------------------------------------------------
-- Prime : couronne lumineuse au-dessus de la tête (visible à travers les murs)
--------------------------------------------------------------------------
type BountyMarker = { Gui: BillboardGui, Head: BasePart, Tweens: { Tween } }
local bounties: { [Player]: BountyMarker } = {}

local function removeBounty(player: Player)
	local entry = bounties[player]
	if not entry then
		return
	end
	bounties[player] = nil
	for _, running in entry.Tweens do
		running:Cancel()
	end
	if entry.Gui.Parent then
		entry.Gui:Destroy()
	end
end

local function createBounty(player: Player, head: BasePart)
	local gold = Config.Colors.Gold
	local gui = Ui.new("BillboardGui", {
		Name = "BountyMarker",
		Size = UDim2.fromOffset(84, 96),
		StudsOffset = Vector3.new(0, 2.9, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 2000,
		ResetOnSpawn = false,
		ClipsDescendants = false,
	})
	local glow = Ui.new("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 34),
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = gold,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Parent = gui,
	}, {
		Ui.new("UICorner", { CornerRadius = UDim.new(1, 0) }),
		Ui.new("UIStroke", { Color = gold, Thickness = 3, Transparency = 0.1 }),
	})
	Ui.label({
		Name = "Crown",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 33),
		Size = UDim2.fromOffset(44, 44),
		Text = "👑",
		Parent = gui,
	})
	Ui.label({
		Name = "Tag",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.fromOffset(84, 22),
		Text = "PRIME",
		FontFace = Ui.Fonts.Title,
		TextColor3 = gold,
		Parent = gui,
	}, {
		Ui.new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1.5, Transparency = 0.2 }),
	})
	local scale = Ui.new("UIScale", { Parent = glow })
	gui.Parent = head

	local pulse = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local bob = TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tweens = {
		TweenService:Create(glow, pulse, { BackgroundTransparency = 0.9 }),
		TweenService:Create(scale, pulse, { Scale = 1.25 }),
		TweenService:Create(gui, bob, { StudsOffset = Vector3.new(0, 3.3, 0) }),
	}
	for _, created in tweens do
		created:Play()
	end
	local entry = { Gui = gui, Head = head, Tweens = tweens }
	bounties[player] = entry
	gui.Destroying:Connect(function()
		if bounties[player] == entry then
			bounties[player] = nil
			for _, running in tweens do
				running:Cancel()
			end
		end
	end)
end

local function refreshBounty(player: Player)
	local wanted = player ~= LocalPlayer and player.Parent ~= nil and player:GetAttribute("Bounty") == true
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not head or not head:IsA("BasePart") or (humanoid and humanoid.Health <= 0) then
		wanted = false
	end
	local entry = bounties[player]
	if entry and (not wanted or entry.Head ~= head or not entry.Gui.Parent) then
		removeBounty(player)
		entry = nil
	end
	if wanted and not entry then
		createBounty(player, head :: BasePart)
	end
end

--------------------------------------------------------------------------
-- Dissolution néon à la mort
--------------------------------------------------------------------------
local dissolved = setmetatable({}, { __mode = "k" })
local DISSOLVE_SAMPLES = {
	"Head",
	"UpperTorso",
	"LowerTorso",
	"Torso",
	"LeftUpperArm",
	"RightUpperArm",
	"LeftUpperLeg",
	"RightUpperLeg",
	"Left Arm",
	"Right Arm",
	"Left Leg",
	"Right Leg",
}

local function dissolveCharacter(character: Model, player: Player?)
	if dissolved[character] then
		return
	end
	dissolved[character] = true
	removePose(character)
	if player then
		removeBounty(player)
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local anchor = if root and root:IsA("BasePart") then root else character:FindFirstChildWhichIsA("BasePart")
	if not anchor or distanceToCamera(anchor.Position) > 500 then
		return
	end
	ensureHost()
	local gold = player ~= nil and player:GetAttribute("Bounty") == true
	local accent = if gold then Config.Colors.Gold else Config.Colors.Accent
	local bits = emitters[if gold then "Bits:Gold" else "Bits:Accent"]

	local parts = {}
	local minY, maxY = math.huge, -math.huge
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			if descendant.Transparency < 1 and descendant.Name ~= "HumanoidRootPart" then
				table.insert(parts, descendant)
				local y = descendant.Position.Y
				minY = math.min(minY, y)
				maxY = math.max(maxY, y)
			end
		elseif descendant:IsA("Decal") then
			tween(descendant, 0.25, { Transparency = 1 })
		elseif descendant:IsA("SurfaceAppearance") or descendant:IsA("Clothing") or descendant:IsA("ShirtGraphic") then
			descendant:Destroy() -- local : laisse apparaître le néon pur
		end
	end
	local height = math.max(maxY - minY, 1)
	for _, part in parts do
		camoParts[part] = nil -- l'arme qui se dissout ne doit plus changer de teinte
		if part:IsA("MeshPart") then
			trySet(part, "TextureID", "")
		end
		local level = (part.Position.Y - minY) / height
		part.Material = Enum.Material.Neon
		part.Color = WHITE
		tween(part, 0.18, { Color = accent })
		-- dissolution de bas en haut
		tween(part, 0.65, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0.25 + level * 0.55)
	end

	local samples = {}
	for _, name in DISSOLVE_SAMPLES do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(samples, part)
		end
	end
	local function burst(count: number)
		for _, part in samples do
			if part.Parent then
				emit(CFrame.new(part.Position), bits, count)
			end
		end
	end
	burst(6)
	task.delay(0.35, burst, 5)
	task.delay(0.7, burst, 4)
	task.delay(0.75, function()
		if anchor.Parent then
			spawnPop(anchor.Position, accent, 1, 7, 0.45, 0.25)
		end
	end)
end

--------------------------------------------------------------------------
-- Camos animés : défilement de teinte (cyan -> violet -> rose), 20 fois / s
--------------------------------------------------------------------------
local function addCamoPart(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end
	-- décalage de phase selon la position le long de l'arme : la couleur « coule » vers le canon
	local phase = 0
	local container = instance.Parent
	local handle = container and container:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") and handle ~= instance then
		phase = handle.CFrame:PointToObjectSpace(instance.Position).Z * 1.6
	end
	camoParts[instance] = phase
end

local function removeCamoPart(instance: Instance)
	if instance:IsA("BasePart") then
		camoParts[instance] = nil
	end
end

local function stepCamos(now: number)
	for part, phase in camoParts do
		if part.Parent and CollectionService:HasTag(part, CAMO_TAG) then
			local hue = 0.72 + 0.2 * math.sin(now * 1.3 + phase)
			part.Color = Color3.fromHSV(hue, 0.7, 1)
		end
	end
end

--------------------------------------------------------------------------
-- Killcam
--------------------------------------------------------------------------
local killcam = {
	Active = false,
	Killer = nil :: Player?,
	Start = 0,
	Yaw = 0,
	DeathPos = Vector3.zero,
	Highlight = nil :: Highlight?,
	FovTween = nil :: Tween?,
	Params = nil :: RaycastParams?,
	Pending = nil :: { Killer: Player?, Time: number }?,
}
local lastDeathPos: Vector3? = nil

-- Évite que la caméra traverse un mur : recule jusqu'à l'obstacle.
local function killcamClear(origin: Vector3, target: Vector3): Vector3
	local params = killcam.Params
	local delta = target - origin
	if not params or delta.Magnitude < 0.1 then
		return target
	end
	local result = workspace:Raycast(origin, delta, params)
	if result then
		return result.Position - delta.Unit * 0.8
	end
	return target
end

local function killcamStep(dt: number)
	local camera = workspace.CurrentCamera
	if not camera or not killcam.Active then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local t = os.clock() - killcam.Start
	local deathPos = killcam.DeathPos
	local killer = killcam.Killer
	local killerCharacter = if killer then killer.Character else nil
	local focusPart = killerCharacter
		and (killerCharacter:FindFirstChild("Head") or killerCharacter:FindFirstChild("HumanoidRootPart"))
	if focusPart and not focusPart:IsA("BasePart") then
		focusPart = nil
	end
	local highlight = killcam.Highlight
	if highlight and killerCharacter and highlight.Adornee ~= killerCharacter then
		highlight.Adornee = killerCharacter
	end

	local desired: CFrame
	local lookAt: Vector3
	if t < KILLCAM_RISE_TIME or not focusPart then
		-- l'« âme » s'élève au-dessus du corps en tournant lentement
		local angle = killcam.Yaw + t * 0.35
		local radius = 6 + math.min(t, 4) * 1.2
		local height = 4 + math.min(t, 4) * 0.8
		local position = deathPos + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
		lookAt = deathPos
		desired = CFrame.lookAt(killcamClear(deathPos + Vector3.new(0, 1, 0), position), lookAt)
	else
		-- cadre le tueur depuis le côté de la victime, légèrement de trois quarts
		local focus = (focusPart :: BasePart).Position
		local flat = Vector3.new(focus.X - deathPos.X, 0, focus.Z - deathPos.Z)
		local direction: Vector3
		if flat.Magnitude > 0.5 then
			direction = flat.Unit
		else
			local look = camera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			direction = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.zAxis
		end
		local side = direction:Cross(Vector3.yAxis)
		local back = math.clamp(flat.Magnitude * 0.45, 4.5, 9)
		local position = focus - direction * back + Vector3.new(0, 1.4, 0) + side * 2.4
		lookAt = focus - Vector3.new(0, 0.4, 0)
		desired = CFrame.lookAt(killcamClear(focus, position), lookAt)
	end

	local speed = if t < 1.8 then 2.4 else 5
	local alpha = 1 - math.exp(-dt * speed)
	camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	camera.Focus = CFrame.new(lookAt)
end

local function stopKillcam(restoreCamera: boolean)
	killcam.Pending = nil
	if not killcam.Active then
		return
	end
	killcam.Active = false
	pcall(function()
		RunService:UnbindFromRenderStep(KILLCAM_BIND)
	end)
	if killcam.FovTween then
		killcam.FovTween:Cancel()
		killcam.FovTween = nil
	end
	local cc = Lighting:FindFirstChild("KillcamCC")
	if cc and cc:IsA("ColorCorrectionEffect") then
		cc.Name = "KillcamCC_Fade" -- une nouvelle killcam ne doit pas récupérer celui-ci
		tween(cc, 0.35, { Saturation = 0, Contrast = 0, TintColor = WHITE })
		Debris:AddItem(cc, 0.4)
	end
	if killcam.Highlight then
		fadeHighlight(killcam.Highlight)
		killcam.Highlight = nil
	end
	killcam.Killer = nil
	killcam.Params = nil

	local camera = workspace.CurrentCamera
	if restoreCamera and camera then
		-- GunController reprend ensuite la main (caméra épaule, FOV des paramètres)
		local settings = ClientState.Settings
		local fov = if type(settings) == "table" and isFiniteNumber(settings.Fov) then settings.Fov else Config.Camera.BaseFov
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = math.clamp(fov, 40, 110)
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

local function startKillcam(killer: Player?)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if killcam.Active then
		stopKillcam(false)
	end
	killcam.Pending = nil
	killcam.Active = true
	killcam.Killer = killer
	killcam.Start = os.clock()
	local deathPos = lastDeathPos or camera.Focus.Position
	killcam.DeathPos = deathPos
	local offset = camera.CFrame.Position - deathPos
	killcam.Yaw = math.atan2(offset.Z, offset.X)
	killcam.Params = Ballistics.GetRaycastParams(Ballistics.GetCharacters())
	camera.CameraType = Enum.CameraType.Scriptable

	-- léger désaturé, teinte froide-rouge
	local existing = Lighting:FindFirstChild("KillcamCC")
	local cc: ColorCorrectionEffect
	if existing and existing:IsA("ColorCorrectionEffect") then
		cc = existing
	else
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KillcamCC"
		cc.Parent = Lighting
	end
	cc.Enabled = true
	cc.Brightness = 0
	cc.Saturation = 0
	cc.Contrast = 0
	cc.TintColor = WHITE
	tween(cc, 0.8, { Saturation = -0.55, Contrast = 0.12, TintColor = Color3.fromRGB(255, 226, 226) })

	local killerCharacter = if killer then killer.Character else nil
	if killerCharacter then
		killcam.Highlight = makeHighlight("KillcamHighlight", killerCharacter, Config.Colors.Bad, Config.Colors.Bad, 0.82)
	end
	killcam.FovTween = tween(camera, 1.4, { FieldOfView = 52 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	RunService:BindToRenderStep(KILLCAM_BIND, Enum.RenderPriority.Camera.Value + 10, killcamStep)
end

local function onKillcam(killer: any)
	local validKiller: Player? = nil
	if typeof(killer) == "Instance" and killer:IsA("Player") and killer ~= LocalPlayer then
		validKiller = killer
	end
	if ClientState.Mode == "Dead" then
		startKillcam(validKiller)
	else
		-- le remote peut arriver juste avant Humanoid.Died côté client
		killcam.Pending = { Killer = validKiller, Time = os.clock() }
	end
end

local function onModeChanged(mode: any)
	if mode == "Dead" then
		local character = LocalPlayer.Character
		local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
		if root and root:IsA("BasePart") then
			lastDeathPos = root.Position
		end
		local pending = killcam.Pending
		if pending and os.clock() - pending.Time < 2 then
			startKillcam(pending.Killer)
		end
	else
		stopKillcam(mode == "Playing")
	end
end

--------------------------------------------------------------------------
-- Suivi des joueurs / personnages
--------------------------------------------------------------------------
local watched: { [Player]: { RBXScriptConnection } } = {}

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") or character.Parent == nil then
		return
	end
	if player.Character ~= character then
		return
	end

	-- mort -> dissolution (Died + filet de sécurité sur la santé répliquée)
	local function onDeath()
		dissolveCharacter(character, player)
	end
	humanoid.Died:Connect(onDeath)
	humanoid.HealthChanged:Connect(function(health)
		if health <= 0 then
			onDeath()
		end
	end)

	-- armes en main -> pose de visée
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			task.spawn(onToolEquipped, player, character, humanoid, child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			onToolRemoved(character, child)
		end
	end)
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(workspace) then
			removePose(character)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			task.spawn(onToolEquipped, player, character, humanoid, child)
		end
	end

	-- prime : attendre la tête puis afficher si besoin
	character:WaitForChild("Head", 5)
	if player.Character == character then
		refreshBounty(player)
	end
end

local function watchPlayer(player: Player)
	if watched[player] then
		return
	end
	local connections = {}
	watched[player] = connections
	table.insert(
		connections,
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
	)
	table.insert(
		connections,
		player:GetAttributeChangedSignal("Bounty"):Connect(function()
			refreshBounty(player)
		end)
	)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local function unwatchPlayer(player: Player)
	local connections = watched[player]
	if connections then
		for _, connection in connections do
			connection:Disconnect()
		end
		watched[player] = nil
	end
	removeBounty(player)
	local highlight = radar.Highlights[player]
	if highlight then
		radar.Highlights[player] = nil
		highlight:Destroy()
	end
	if player.Character then
		removePose(player.Character)
	end
	if killcam.Killer == player then
		killcam.Killer = nil
	end
end

--------------------------------------------------------------------------
-- Boucle principale (une seule connexion RenderStepped)
--------------------------------------------------------------------------
local holeClock = 0
local camoClock = 0

local function stepEffects(dt: number)
	particleBudget = PARTICLE_BUDGET
	if #activeTracers > 0 then
		stepTracers(dt)
	end
	if #activeFlashes > 0 then
		stepFlashes()
	end
	if #bodies > 0 then
		stepBodies(dt)
	end
	if #activePops > 0 then
		stepPops(dt)
	end
	holeClock += dt
	if holeClock >= 0.1 then
		holeClock = 0
		stepHoles(os.clock())
	end
	camoClock += dt
	if camoClock >= CAMO_INTERVAL then
		camoClock = 0
		if next(camoParts) ~= nil then
			stepCamos(os.clock())
		end
	end
end

--------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------
local initialized = false

function Effects.Init()
	if initialized then
		return
	end
	initialized = true
	ensureHost()

	Remotes.ShotFx.OnClientEvent:Connect(onShotFx)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.Killcam.OnClientEvent:Connect(onKillcam)
	Remotes.RewardFx.OnClientEvent:Connect(onRewardFx)
	ClientState.On("Changed:Mode", onModeChanged)

	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(unwatchPlayer)

	for _, instance in CollectionService:GetTagged(CAMO_TAG) do
		addCamoPart(instance)
	end
	CollectionService:GetInstanceAddedSignal(CAMO_TAG):Connect(addCamoPart)
	CollectionService:GetInstanceRemovedSignal(CAMO_TAG):Connect(removeCamoPart)

	RunService.RenderStepped:Connect(stepEffects)
	-- après la caméra (+1 = recul de GunController) : le buste suit l'inclinaison finale de la frame
	RunService:BindToRenderStep(POSE_BIND, Enum.RenderPriority.Camera.Value + 2, stepPoses)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">GunController</string>
              <string name="Source"><![CDATA[-- Contrôleur d'armes (client) : le cœur des sensations de jeu d'Arena Clash.
--
-- Responsabilités (voir ARCHITECTURE.md, « Propriétaires de la caméra », « Entrées », événements ClientState) :
--   • caméra « épaule » en mode Playing : Humanoid.CameraOffset (avec anti-collision côté épaule),
--     souris verrouillée au centre à chaque frame, personnage tourné vers la caméra (AutoRotate = false),
--     zoom fixe. Tout est restauré quand on quitte Playing ;
--   • champ de vision : paramètre Fov, bonus de sprint, mise en joue progressive, « punch » de tir et de dash ;
--   • sensibilité souris : paramètres joueur, visée, lunette ;
--   • armes : changement principale / secondaire, tir semi / auto, munitions prédites localement,
--     rechargement synchronisé avec les attributs du Tool (le serveur fait autorité) ;
--   • dispersion (visée, bloom, déplacement, saut), recul caméra à ressort, tremblements (« CameraShake ») ;
--   • sprint, dash, récompenses de série (radar, ciblage de la frappe orbitale) ;
--   • PC, manette et tactile (ContextActionService + boutons à l'écran).
--
-- API publique : GunController.Init()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Ballistics = require(Shared:WaitForChild("Ballistics"))

local Controllers = script.Parent
local ClientState = require(Controllers:WaitForChild("ClientState"))
local Sfx = require(Controllers:WaitForChild("Sfx"))

-- Effets locaux (traceurs, flash, impacts…). Chargement protégé : si le module manque ou plante,
-- le tir fonctionne quand même (chaque appel est gardé par « if Effects.X »).
local Effects = {}
do
	local module = Controllers:FindFirstChild("EffectsController") or Controllers:WaitForChild("EffectsController", 2)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			Effects = result
		else
			warn("[GunController] EffectsController indisponible : " .. tostring(result))
		end
	end
end

local GunController = {}

local LocalPlayer = Players.LocalPlayer
local CameraConfig = Config.Camera
local Movement = Config.Movement

--------------------------------------------------------------------------
-- Réglages internes (ressenti) : regroupés dans une table (limite de 200 variables locales)
--------------------------------------------------------------------------
local Tune = {}

Tune.ACTION_PREFIX = "ArenaGun_"
Tune.ACTION_PRIORITY = Enum.ContextActionPriority.High.Value
Tune.RENDER_STEP_NAME = "ArenaGunCamera"

Tune.CAMERA_DISTANCE = 7.5 -- distance caméra / épaule (zoom verrouillé pendant la partie)
Tune.EQUIP_TIME = { Primary = 0.38, Secondary = 0.26 } -- délai avant de pouvoir tirer après un changement d'arme
Tune.SWITCH_COOLDOWN = 0.15
Tune.SPRINT_OUT_TIME = 0.14 -- délai entre la fin du sprint et le premier tir
Tune.SEMI_BUFFER = 0.2 -- un clic un peu trop tôt est mémorisé pendant ce délai
Tune.SPREAD_RECOVERY_DELAY = 0.08 -- le bloom ne redescend qu'après une courte pause de tir
Tune.MOVE_FAST_SPEED = Movement.WalkSpeed * 0.7 -- au-delà : dispersion x1,5
Tune.AIM_EXTRA_RANGE = 60

Tune.RELOAD_GRACE_UNSEEN = 0.5 -- le serveur n'a jamais confirmé : on termine quand même
Tune.RELOAD_GRACE_SEEN = 2.5 -- attente max de la fin côté serveur
Tune.AUTO_RELOAD_DELAY = 0.18
Tune.AMMO_SYNC_IDLE = 1 -- sans tir depuis X s : les munitions locales s'alignent sur le serveur
Tune.AMMO_SYNC_INTERVAL = 0.25
Tune.EMPTY_CLICK_COOLDOWN = 0.25

-- Recul
Tune.KICK_SPEED = 30 -- vitesse à laquelle la caméra rejoint le recul visé
Tune.FIRING_RECOVERY_SCALE = 0.35 -- retour plus lent pendant une rafale (le recul « grimpe »)
Tune.ADS_RECOIL_SCALE = 0.8
Tune.MAX_CAMERA_PITCH = math.rad(80)
Tune.FOV_PUNCH_DECAY = 14
Tune.FOV_PUNCH_MAX = 4
Tune.ROLL_PUNCH_DECAY = 16
Tune.HEAVY_RECOIL_SHAKE = 0.18 -- tremblement des armes lourdes (pompe, sniper, magnum)

-- Tremblements de caméra (« trauma » au carré)
Tune.SHAKE_DECAY = 1.4
Tune.SHAKE_FREQUENCY = 22
Tune.SHAKE_MAX_ANGLE = math.rad(2.6)
Tune.SHAKE_MAX_ROLL = math.rad(3.5)

-- Épaule : on rapproche la caméra si un mur est collé à droite
Tune.SHOULDER_MARGIN = 0.7

-- Dash
Tune.DASH_FOV_KICK = 7
Tune.DASH_FOV_DECAY = 5
Tune.DASH_FORCE_PER_MASS = 8000

-- Inclinaison de visée envoyée au serveur
Tune.PITCH_INTERVAL = 1 / math.max(1, CameraConfig.AimPitchSendRate or 10)
Tune.PITCH_LIMIT = 1.3

-- Récompenses de série
Tune.KILLSTREAKS = {}
for _, streak in Config.Killstreaks do
	Tune.KILLSTREAKS[streak.Id] = streak
end
Tune.ORBITAL = Tune.KILLSTREAKS.Orbital or {}
Tune.ORBITAL_RADIUS = Tune.ORBITAL.Radius or 22
Tune.ORBITAL_MAX_DISTANCE = (Tune.ORBITAL.MaxDistance or 600) - 2 -- petite marge sous la limite serveur
Tune.ORBITAL_BEAM_HEIGHT = 70
Tune.RADAR_KEY = (Tune.KILLSTREAKS.Radar and Tune.KILLSTREAKS.Radar.Key) or Enum.KeyCode.Three
Tune.ORBITAL_KEY = Tune.ORBITAL.Key or Enum.KeyCode.Four
Tune.MARKER_VALID_COLOR = Config.Colors.Bad
Tune.MARKER_INVALID_COLOR = Color3.fromRGB(150, 152, 165)
Tune.DOWN_RAY = Vector3.new(0, -1000, 0)

-- Teintes des boutons tactiles
Tune.TINT_DEFAULT = Color3.new(1, 1, 1)
Tune.TINT_FIRE = Color3.fromRGB(255, 140, 140)
Tune.TINT_ACTIVE = Config.Colors.Accent
Tune.TINT_SPRINT = Config.Colors.Good
Tune.TINT_REWARD = Config.Colors.Gold

-- États du Humanoid où le personnage ne doit pas être tourné vers la caméra
local NO_FACE_STATES = {
	[Enum.HumanoidStateType.Climbing] = true,
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
	[Enum.HumanoidStateType.Dead] = true,
}

local SINK = Enum.ContextActionResult.Sink
local PASS = Enum.ContextActionResult.Pass

--------------------------------------------------------------------------
-- État
--------------------------------------------------------------------------
local camera: Camera? = workspace.CurrentCamera
local rng = Random.new()

-- personnage
local character: Model? = nil
local humanoid: Humanoid? = nil
local rootPart: BasePart? = nil
local head: BasePart? = nil
local characterConnections = {}
local dashAttachment: Attachment? = nil
local hiddenParts = nil -- pièces masquées pendant la visée à la lunette
local scopeHidden = false

-- arme en main
local currentTool: Tool? = nil
local currentWeapon = nil
local handle: BasePart? = nil
local muzzle: Attachment? = nil
local eject: Attachment? = nil
local toolConnections = {}

-- munitions / cadence (prédiction locale)
local ammo = 0
local reloading = false
local reloadSeenOnServer = false
local reloadEndsAt = 0
local equipReadyAt = 0
local nextFireAt = 0
local lastShotAt = -math.huge
local autoReloadAt: number? = nil
local lastEmptyClickAt = -math.huge
local lastAmmoSyncAt = 0
local lastSwitchAt = -math.huge

-- entrées
local triggerHeld = false
local fireQueuedAt: number? = nil
local wantAds = false
local sprintHeld = false -- Maj maintenu
local sprintToggled = false -- L3 / bouton tactile
local stillTime = 0

-- états dérivés
local adsActive = false
local sprinting = false
local sprintEndedAt = -math.huge
local adsAlpha = 0
local sprintAlpha = 0
local bloom = 0
local moveMult = 1
local currentSpread = 0
local lastSpreadSent = -1
local shoulderScale = 1

-- caméra
local playingApplied = false
local appliedHumanoid: Humanoid? = nil
local mouseLocked = false
local savedMinZoom: number? = nil
local savedMaxZoom: number? = nil
local fovPunch = 0
local dashFovKick = 0
local rollPunch = 0
local recoilTargetPitch, recoilTargetYaw = 0, 0
local recoilPitch, recoilYaw = 0, 0
local shakeTrauma = 0
local shakeTime = 0
local shakePitch, shakeYaw = 0, 0
local lastPitchSentAt = -math.huge
local lastPitchSent = math.huge

-- dash
local lastDashAt = -math.huge

-- ciblage orbital
local marker = nil -- { Model, Disc, Gui, Beam, Frames, Strokes, Tweens, Valid, Point }
local lastRewardUseAt = -math.huge

-- liaisons ContextActionService
local bound = false
local rewardTouch = {} -- [rewardId] = bouton tactile affiché ?
local touchButtons = {} -- [actionName] = ImageButton (cache rempli par la mise en page)
local touchTint = {} -- [actionName] = dernière teinte appliquée
local layoutToken = 0
local viewportConnection: RBXScriptConnection? = nil

-- paramètres de raycast (mis en cache, reconstruits régulièrement)
local shotParams: RaycastParams? = nil
local shotParamsAt = -math.huge
local worldParams: RaycastParams? = nil
local worldParamsAt = -math.huge

--------------------------------------------------------------------------
-- Utilitaires
--------------------------------------------------------------------------
local function smoothstep(t: number): number
	return t * t * (3 - 2 * t)
end

local function setting(name: string): any
	local settings = ClientState.Settings
	local value = if type(settings) == "table" then settings[name] else nil
	if value == nil then
		value = Config.DefaultSettings[name]
	end
	return value
end

local function getBaseFov(): number
	local fov = tonumber(setting("Fov")) or CameraConfig.BaseFov
	return math.clamp(fov, 40, 110)
end

-- FOV de visée : relatif au FOV de base (AdsFov est pensé pour 70) ; exact pour une lunette.
local function getAdsFov(weapon, baseFov: number): number
	local adsFov = weapon.AdsFov or baseFov
	if not weapon.Scope then
		adsFov = adsFov * baseFov / CameraConfig.BaseFov
	end
	return math.clamp(adsFov, 5, baseFov)
end

local function weaponOf(tool: Instance?)
	if not tool or not tool:IsA("Tool") then
		return nil
	end
	local weaponId = tool:GetAttribute("WeaponId")
	if type(weaponId) ~= "string" then
		return nil
	end
	return Weapons.ById[weaponId]
end

local function readAmmo(tool: Instance?): number
	if not tool then
		return 0
	end
	local value = tool:GetAttribute("Ammo")
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.floor(value))
end

local function findAttachment(container: Instance, name: string): Attachment?
	local found = container:FindFirstChild(name, true)
	if found and found:IsA("Attachment") then
		return found
	end
	return nil
end

local function clearConnections(list)
	for _, connection in list do
		connection:Disconnect()
	end
	table.clear(list)
end

-- Appel protégé d'une fonction d'EffectsController (une erreur d'effet ne doit jamais casser le tir).
local fxWarned = {}
local function fx(fn, ...)
	if not fn then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok and not fxWarned[fn] then
		fxWarned[fn] = true
		warn("[GunController] effet en erreur : " .. tostring(err))
	end
end

local function isAlive(): boolean
	local hum = humanoid
	local root = rootPart
	return hum ~= nil and hum.Parent ~= nil and hum.Health > 0 and root ~= nil and root.Parent ~= nil
end

-- Le joueur peut-il agir (tirer, viser, recharger…) ?
local function canAct(): boolean
	return ClientState.Mode == "Playing" and not ClientState.UiOpen and not GuiService.MenuIsOpen and isAlive()
end

-- Balles : décor + autres joueurs (on s'exclut soi-même).
local function getShotParams(): RaycastParams
	local now = os.clock()
	if not shotParams or now - shotParamsAt > 1 then
		shotParams = Ballistics.GetRaycastParams(if character then { character } else nil)
		shotParamsAt = now
	end
	return shotParams :: RaycastParams
end

-- Décor seulement (ciblage au sol de la frappe orbitale).
local function getWorldParams(): RaycastParams
	local now = os.clock()
	if not worldParams or now - worldParamsAt > 0.5 then
		worldParams = Ballistics.GetRaycastParams(Ballistics.GetCharacters())
		worldParamsAt = now
	end
	return worldParams :: RaycastParams
end

local function getClientFxFolder(): Instance
	local folder = workspace:FindFirstChild("ClientFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ClientFX"
		folder.Parent = workspace
	end
	return folder
end

--------------------------------------------------------------------------
-- États partagés (ClientState)
--------------------------------------------------------------------------
local function resetInputs()
	triggerHeld = false
	fireQueuedAt = nil
	wantAds = false
	sprintHeld = false
	sprintToggled = false
	stillTime = 0
end

local function setAds(value: boolean)
	if adsActive ~= value then
		adsActive = value
		ClientState.Set("Ads", value)
	end
end

local function setSprinting(value: boolean, now: number)
	if sprinting ~= value then
		sprinting = value
		if not value then
			sprintEndedAt = now
		end
		ClientState.Set("Sprinting", value)
	end
end

local function publishSpread(value: number)
	local rounded = math.floor(value * 20 + 0.5) / 20
	if rounded ~= lastSpreadSent then
		lastSpreadSent = rounded
		ClientState.Set("Spread", rounded)
	end
end

--------------------------------------------------------------------------
-- Rechargement (le serveur fait autorité : attributs Reloading / Ammo du Tool)
--------------------------------------------------------------------------
local function startReload(fromServer: boolean): boolean
	local weapon, tool = currentWeapon, currentTool
	if not weapon or not tool or reloading then
		return false
	end
	if not fromServer then
		if not canAct() or ammo >= weapon.MagSize then
			return false
		end
		Remotes.Reload:FireServer()
	end
	reloading = true
	reloadSeenOnServer = fromServer
	reloadEndsAt = os.clock() + weapon.ReloadTime
	autoReloadAt = nil
	fireQueuedAt = nil
	ClientState.Set("Reloading", true)
	ClientState.Emit("ReloadStarted", weapon.ReloadTime)
	if handle and handle.Parent then
		Sfx.PlayAt(Config.Sounds.Reload, handle, 0.7, 0.03)
	end
	return true
end

local function finishReload()
	if not reloading then
		return
	end
	reloading = false
	reloadSeenOnServer = false
	if currentTool then
		ammo = readAmmo(currentTool)
	end
	bloom = 0
	ClientState.Set("Reloading", false)
	ClientState.Set("Ammo", ammo)
	ClientState.Emit("ReloadFinished")
end

-- Annulation locale (changement d'arme, mort…) : le serveur annule de son côté quand l'arme quitte la main.
local function cancelReload()
	if not reloading then
		return
	end
	reloading = false
	reloadSeenOnServer = false
	ClientState.Set("Reloading", false)
	ClientState.Emit("ReloadFinished")
end

local function emptyClick()
	local now = os.clock()
	if now - lastEmptyClickAt < Tune.EMPTY_CLICK_COOLDOWN then
		return
	end
	lastEmptyClickAt = now
	Sfx.Play2D(Config.Sounds.Empty, 0.6)
end

--------------------------------------------------------------------------
-- Lunette : on masque son propre personnage (il boucherait la vue zoomée)
--------------------------------------------------------------------------
local function updateScopeHide(hide: boolean)
	if hide then
		if not scopeHidden then
			scopeHidden = true
			hiddenParts = {}
			if character then
				for _, descendant in character:GetDescendants() do
					if descendant:IsA("BasePart") then
						table.insert(hiddenParts, descendant)
					end
				end
			end
		end
		-- réappliqué à chaque frame : le TransparencyController par défaut peut le remettre à 0
		for _, part in hiddenParts do
			if part.LocalTransparencyModifier ~= 1 then
				part.LocalTransparencyModifier = 1
			end
		end
	elseif scopeHidden then
		scopeHidden = false
		if hiddenParts then
			for _, part in hiddenParts do
				if part.Parent then
					part.LocalTransparencyModifier = 0
				end
			end
		end
		hiddenParts = nil
	end
end

--------------------------------------------------------------------------
-- Récompenses : radar et ciblage de la frappe orbitale
--------------------------------------------------------------------------
local function newEffectPart(name: string, size: Vector3, color: Color3, transparency: number, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = size
	part.Color = color
	part.Transparency = transparency
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Marqueur rouge au sol (rayon = rayon de l'explosion) + colonne lumineuse, dans workspace.ClientFX.
local function createMarker()
	local diameter = Tune.ORBITAL_RADIUS * 2
	local model = Instance.new("Model")
	model.Name = "OrbitalTargetMarker"

	local disc = newEffectPart("Ring", Vector3.new(diameter, 0.1, diameter), Tune.MARKER_VALID_COLOR, 1)
	disc.Parent = model

	local gui = Instance.new("SurfaceGui")
	gui.Name = "RingGui"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 12
	gui.LightInfluence = 0
	gui.Brightness = 2.5
	gui.AlwaysOnTop = false
	gui.Parent = disc

	local frames, strokes, tweens = {}, {}, {}

	local function ring(scale: number, thickness: number, fillTransparency: number, strokeTransparency: number)
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(scale, scale)
		frame.BackgroundColor3 = Tune.MARKER_VALID_COLOR
		frame.BackgroundTransparency = fillTransparency
		frame.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = thickness
		stroke.Color = Tune.MARKER_VALID_COLOR
		stroke.Transparency = strokeTransparency
		stroke.Parent = frame
		frame.Parent = gui
		table.insert(frames, frame)
		table.insert(strokes, stroke)
		return frame, stroke
	end

	ring(1, 10, 0.84, 0) -- bord = zone de l'explosion
	ring(0.55, 4, 1, 0.35)
	ring(0.07, 0, 0.05, 1) -- point central

	-- croix de visée
	for index = 1, 2 do
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position = UDim2.fromScale(0.5, 0.5)
		line.Size = if index == 1 then UDim2.new(0.9, 0, 0, 4) else UDim2.new(0, 4, 0.9, 0)
		line.BackgroundColor3 = Tune.MARKER_VALID_COLOR
		line.BackgroundTransparency = 0.35
		line.BorderSizePixel = 0
		line.Parent = gui
		table.insert(frames, line)
	end

	-- onde qui pulse du centre vers le bord
	local pulse, pulseStroke = ring(0.05, 6, 1, 0)
	local pulseInfo = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1)
	local sizeTween = TweenService:Create(pulse, pulseInfo, { Size = UDim2.fromScale(1, 1) })
	local fadeTween = TweenService:Create(pulseStroke, pulseInfo, { Transparency = 1 })
	sizeTween:Play()
	fadeTween:Play()
	table.insert(tweens, sizeTween)
	table.insert(tweens, fadeTween)

	-- colonne verticale visible de loin
	local beam = newEffectPart(
		"Beam",
		Vector3.new(Tune.ORBITAL_BEAM_HEIGHT, 1.2, 1.2),
		Tune.MARKER_VALID_COLOR,
		0.55,
		Enum.Material.Neon
	)
	beam.Shape = Enum.PartType.Cylinder
	beam.Parent = model

	model.Parent = getClientFxFolder()

	return {
		Model = model,
		Disc = disc,
		Gui = gui,
		Beam = beam,
		Frames = frames,
		Strokes = strokes,
		Tweens = tweens,
		Valid = true,
		Point = nil,
	}
end

local function destroyMarker()
	if not marker then
		return
	end
	for _, tween in marker.Tweens do
		tween:Cancel()
	end
	marker.Model:Destroy()
	marker = nil
end

local function setMarkerValid(valid: boolean)
	if not marker or marker.Valid == valid then
		return
	end
	marker.Valid = valid
	local color = if valid then Tune.MARKER_VALID_COLOR else Tune.MARKER_INVALID_COLOR
	for _, frame in marker.Frames do
		frame.BackgroundColor3 = color
	end
	for _, stroke in marker.Strokes do
		stroke.Color = color
	end
	marker.Beam.Color = color
end

-- Point visé au sol (rayon depuis le centre de l'écran ; un mur renvoie au sol devant lui).
local function computeOrbitalTarget(cam: Camera): (Vector3?, Vector3?)
	local params = getWorldParams()
	local frame = cam.CFrame
	local origin, direction = frame.Position, frame.LookVector
	local result = workspace:Raycast(origin, direction * (Tune.ORBITAL_MAX_DISTANCE + 200), params)
	if result then
		if result.Normal.Y >= 0.55 then
			return result.Position, result.Normal
		end
		local down = workspace:Raycast(result.Position + result.Normal * 1.5, Tune.DOWN_RAY, params)
		if down then
			return down.Position, down.Normal
		end
		return result.Position, Vector3.yAxis
	end
	-- ciel : on projette au bout de la portée puis on cherche le sol en dessous
	local down = workspace:Raycast(origin + direction * Tune.ORBITAL_MAX_DISTANCE + Vector3.new(0, 300, 0), Tune.DOWN_RAY, params)
	if down then
		return down.Position, down.Normal
	end
	return nil, nil
end

local function updateMarker(cam: Camera, now: number)
	if not marker then
		marker = createMarker()
	end
	local point, normal = computeOrbitalTarget(cam)
	local visible = point ~= nil and normal ~= nil
	if marker.Gui.Enabled ~= visible then
		marker.Gui.Enabled = visible
		marker.Beam.Transparency = if visible then 0.55 else 1
	end
	if not point or not normal then
		marker.Point = nil
		return
	end
	local root = rootPart
	setMarkerValid(root ~= nil and (point - root.Position).Magnitude <= Tune.ORBITAL_MAX_DISTANCE)
	marker.Point = point

	-- repère aligné sur la pente du sol, qui tourne doucement
	local up = normal.Unit
	local right = Vector3.xAxis - up * up:Dot(Vector3.xAxis)
	if right.Magnitude < 1e-3 then
		right = Vector3.zAxis - up * up:Dot(Vector3.zAxis)
	end
	marker.Disc.CFrame = CFrame.fromMatrix(point + up * 0.15, right.Unit, up) * CFrame.Angles(0, now * 0.8, 0)
	marker.Beam.CFrame = CFrame.new(point + Vector3.new(0, Tune.ORBITAL_BEAM_HEIGHT / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
end

local function cancelTargeting()
	destroyMarker()
	if ClientState.Targeting ~= nil then
		ClientState.Set("Targeting", nil)
	end
end

local function rewardAvailable(rewardId: string): boolean
	local rewards = ClientState.Rewards
	return type(rewards) == "table" and rewards[rewardId] == true
end

local function startTargeting()
	if not canAct() or not rewardAvailable("Orbital") then
		return
	end
	triggerHeld = false
	fireQueuedAt = nil
	wantAds = false
	sprintToggled = false
	if not marker then
		marker = createMarker()
	end
	ClientState.Set("Targeting", "Orbital")
end

local function confirmTargeting()
	if ClientState.Targeting ~= "Orbital" then
		return
	end
	local point = marker and marker.Point
	if not point or not marker.Valid or not rewardAvailable("Orbital") or not canAct() then
		emptyClick()
		return
	end
	Remotes.UseReward:FireServer("Orbital", point)
	cancelTargeting()
end

local function useRadar()
	if not canAct() or not rewardAvailable("Radar") then
		return
	end
	local now = os.clock()
	if now - lastRewardUseAt < 0.5 then
		return
	end
	lastRewardUseAt = now
	Remotes.UseReward:FireServer("Radar")
end

--------------------------------------------------------------------------
-- Changement d'arme (Tools du Backpack, slot Primary / Secondary)
--------------------------------------------------------------------------
local function findToolForSlot(slot: string): Tool?
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local containers = { backpack, character }
	for index = 1, 2 do
		local container = containers[index]
		if container then
			for _, child in container:GetChildren() do
				local weapon = weaponOf(child)
				if weapon and weapon.Slot == slot then
					return child :: Tool
				end
			end
		end
	end
	return nil
end

local function switchTo(slot: string)
	local hum = humanoid
	if not hum or not canAct() or ClientState.Targeting ~= nil then
		return
	end
	if currentWeapon and currentWeapon.Slot == slot and currentTool and currentTool.Parent == character then
		return
	end
	local now = os.clock()
	if now - lastSwitchAt < Tune.SWITCH_COOLDOWN then
		return
	end
	local tool = findToolForSlot(slot)
	if not tool or tool.Parent == character then
		return
	end
	lastSwitchAt = now
	fireQueuedAt = nil
	hum:EquipTool(tool)
end

local function toggleWeapon()
	local target = if currentWeapon and currentWeapon.Slot == "Primary" then "Secondary" else "Primary"
	if findToolForSlot(target) then
		switchTo(target)
	end
end

--------------------------------------------------------------------------
-- Dash (LinearVelocity horizontale de courte durée)
--------------------------------------------------------------------------
local function getDashAttachment(root: BasePart): Attachment
	if dashAttachment and dashAttachment.Parent == root then
		return dashAttachment
	end
	local existing = root:FindFirstChild("ArenaDashAttachment")
	local attachment: Attachment
	if existing and existing:IsA("Attachment") then
		attachment = existing
	else
		attachment = Instance.new("Attachment")
		attachment.Name = "ArenaDashAttachment"
		attachment.Parent = root
	end
	dashAttachment = attachment
	return attachment
end

local function tryDash()
	local hum, root, cam = humanoid, rootPart, camera
	if not hum or not root or not cam or not canAct() then
		return
	end
	local now = os.clock()
	if now - lastDashAt < Movement.DashCooldown then
		return
	end
	if hum.Sit or hum.PlatformStand or NO_FACE_STATES[hum:GetState()] then
		return
	end
	-- direction : celle du déplacement, sinon vers l'avant de la caméra
	local move = hum.MoveDirection
	local direction = Vector3.new(move.X, 0, move.Z)
	if direction.Magnitude < 0.1 then
		local look = cam.CFrame.LookVector
		direction = Vector3.new(look.X, 0, look.Z)
	end
	if direction.Magnitude < 1e-3 then
		return
	end
	direction = direction.Unit
	lastDashAt = now

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "ArenaDash"
	velocity.Attachment0 = getDashAttachment(root)
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * Movement.DashPower
	velocity.MaxForce = math.max(root.AssemblyMass, 1) * Tune.DASH_FORCE_PER_MASS
	velocity.Parent = root
	Debris:AddItem(velocity, Movement.DashDuration)

	dashFovKick = Tune.DASH_FOV_KICK
	ClientState.Emit("DashUsed", Movement.DashCooldown)
end

--------------------------------------------------------------------------
-- Tir
--------------------------------------------------------------------------
local function kickRecoil(weapon)
	local recoil = weapon.Recoil
	if type(recoil) ~= "table" then
		return
	end
	local adsEase = smoothstep(adsAlpha)
	local scale = 1 + (Tune.ADS_RECOIL_SCALE - 1) * adsEase
	local vertical = recoil.Vertical or 0
	local horizontal = recoil.Horizontal or 0

	recoilTargetPitch += math.rad(vertical) * scale * rng:NextNumber(0.85, 1.15)
	recoilTargetYaw += math.rad(horizontal) * scale * rng:NextNumber(-1, 1)

	-- « punch » : léger élargissement du champ de vision + roulis (moins marqué en visée)
	local fovNow = if camera then camera.FieldOfView else CameraConfig.BaseFov
	fovPunch = math.min(Tune.FOV_PUNCH_MAX, fovPunch + math.clamp(vertical * 0.45, 0.25, 2.8) * (fovNow / getBaseFov()))
	local rollSign = if rng:NextNumber() < 0.5 then -1 else 1
	rollPunch += math.rad(math.clamp(vertical * 0.35, 0.15, 2)) * rollSign * (1 - 0.6 * adsEase)

	if vertical >= 4 and setting("CameraShake") ~= false then
		shakeTrauma = math.min(1, shakeTrauma + Tune.HEAVY_RECOIL_SHAKE)
	end
end

local function fireShot(now: number, weapon): boolean
	local cam = camera
	local tool = currentTool
	local originPart = head
	if not originPart or not originPart.Parent then
		originPart = rootPart
	end
	if not cam or not tool or not originPart then
		return false
	end

	-- 1. point visé : rayon depuis le centre de l'écran, démarré au niveau de la tête
	--    (pour ne pas toucher ce qui se trouve entre la caméra et le personnage)
	local params = getShotParams()
	local origin = originPart.Position
	local viewport = cam.ViewportSize
	local ray = cam:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
	local cameraDirection = ray.Direction.Unit
	local start = ray.Origin
	local along = (origin - start):Dot(cameraDirection)
	if along > 0 then
		start += cameraDirection * along
	end
	local aimRange = weapon.Range + Tune.AIM_EXTRA_RANGE
	local aimResult = workspace:Raycast(start, cameraDirection * aimRange, params)
	local aimPoint = if aimResult then aimResult.Position else start + cameraDirection * aimRange

	-- 2. direction depuis la tête vers le point visé
	local toAim = aimPoint - origin
	local baseDirection = cameraDirection
	if toAim.Magnitude > 2 and toAim.Unit:Dot(cameraDirection) > 0.2 then
		baseDirection = toAim.Unit
	end

	-- 3. plombs : dispersion + raycast client jusqu'à la portée
	local count = math.max(1, weapon.Pellets or 1)
	local spread = currentSpread
	local pellets = table.create(count)
	for index = 1, count do
		local direction = Ballistics.ApplySpread(baseDirection, spread, rng)
		local result = workspace:Raycast(origin, direction * weapon.Range, params)
		if result then
			pellets[index] = {
				Direction = direction,
				Hit = result.Instance,
				Position = result.Position,
				Normal = result.Normal,
			}
		else
			pellets[index] = {
				Direction = direction,
				Position = origin + direction * weapon.Range,
				Normal = Vector3.zero,
			}
		end
	end

	-- 4. serveur (validation, dégâts, effets chez les autres)
	Remotes.Fire:FireServer(origin, pellets)

	-- 5. munitions / cadence / bloom
	ammo = math.max(0, ammo - 1)
	lastShotAt = now
	if weapon.Automatic then
		-- cadence exacte en rafale, sans jamais descendre sous 85 % du délai (validation serveur)
		if now - nextFireAt > weapon.FireDelay then
			nextFireAt = now
		end
		nextFireAt = math.max(nextFireAt + weapon.FireDelay, now + weapon.FireDelay * 0.85)
	else
		nextFireAt = now + weapon.FireDelay
	end
	bloom = math.min(bloom + (weapon.SpreadPerShot or 0), weapon.MaxSpread or 5)
	if ammo <= 0 then
		autoReloadAt = now + Tune.AUTO_RELOAD_DELAY
	end
	ClientState.Set("Ammo", ammo)

	-- 6. effets locaux instantanés
	local color = weapon.TracerColor or Color3.fromRGB(255, 220, 150)
	local muzzleAttachment = if muzzle and muzzle.Parent then muzzle else nil
	local muzzlePosition = if muzzleAttachment then muzzleAttachment.WorldPosition else origin + cameraDirection * 1.5
	if muzzleAttachment then
		fx(Effects.MuzzleFlash, muzzleAttachment, color)
	end
	if eject and eject.Parent then
		fx(Effects.Shell, eject, weapon.Id)
	end
	fx(Effects.PlayWeaponSound, weapon.Id, muzzleAttachment or originPart)
	for index = 1, count do
		local pellet = pellets[index]
		fx(Effects.Tracer, muzzlePosition, pellet.Position, color)
		local hit = pellet.Hit
		if hit then
			fx(Effects.Impact, pellet.Position, pellet.Normal, hit, Ballistics.GetHumanoid(hit) ~= nil)
		end
	end

	-- 7. recul + notification (HUD : recul du réticule)
	kickRecoil(weapon)
	ClientState.Emit("Shot", weapon)
	return true
end

local function tryFire(now: number, weapon): boolean
	if reloading or now < equipReadyAt or now < nextFireAt then
		return false
	end
	if sprinting or now - sprintEndedAt < Tune.SPRINT_OUT_TIME then
		return false
	end
	if ammo <= 0 then
		fireQueuedAt = nil
		startReload(false)
		return false
	end
	return fireShot(now, weapon)
end

--------------------------------------------------------------------------
-- Suivi de l'arme en main
--------------------------------------------------------------------------
local function unbindTool()
	clearConnections(toolConnections)
	currentTool = nil
	currentWeapon = nil
	handle = nil
	muzzle = nil
	eject = nil
	fireQueuedAt = nil
	autoReloadAt = nil
end

local function onToolAttributeChanged(tool: Tool, name: string)
	if tool ~= currentTool then
		return
	end
	if name == "Reloading" then
		if tool:GetAttribute("Reloading") == true then
			reloadSeenOnServer = true
			if not reloading then
				-- rechargement lancé côté serveur sans nous : on suit
				startReload(true)
			end
		end
		-- la fin du rechargement est gérée dans la boucle (attente de la confirmation serveur)
	elseif name == "Ammo" then
		if reloading then
			return
		end
		local serverAmmo = readAmmo(tool)
		-- pendant une rafale, des tirs sont encore en vol : on ne remonte jamais le compteur
		local value = if os.clock() - lastShotAt > Tune.AMMO_SYNC_IDLE then serverAmmo else math.min(ammo, serverAmmo)
		if value ~= ammo then
			ammo = value
			ClientState.Set("Ammo", ammo)
		end
	end
end

local function onToolEquipped(tool: Instance)
	if tool == currentTool or not tool:IsA("Tool") then
		return
	end
	local weapon = weaponOf(tool)
	if not weapon then
		return
	end
	cancelReload()
	unbindTool()

	currentTool = tool
	currentWeapon = weapon
	local handlePart = tool:FindFirstChild("Handle")
	handle = if handlePart and handlePart:IsA("BasePart") then handlePart else nil
	muzzle = findAttachment(tool, "Muzzle")
	eject = findAttachment(tool, "Eject")
	ammo = readAmmo(tool)

	local now = os.clock()
	equipReadyAt = now + (Tune.EQUIP_TIME[weapon.Slot] or 0.3)
	nextFireAt = 0
	bloom = 0
	lastAmmoSyncAt = now

	table.insert(
		toolConnections,
		tool.AttributeChanged:Connect(function(name)
			onToolAttributeChanged(tool, name)
		end)
	)

	ClientState.Set("Tool", tool)
	ClientState.Set("Weapon", weapon)
	ClientState.Set("Ammo", ammo)

	if tool:GetAttribute("Reloading") == true then
		startReload(true)
	elseif ammo <= 0 then
		autoReloadAt = equipReadyAt
	end
	if handle then
		Sfx.PlayAt(Config.Sounds.Equip, handle, 0.45, 0.05)
	end
end

local function onCharacterChildRemoved(child: Instance)
	if child ~= currentTool then
		return
	end
	cancelReload()
	unbindTool()
	-- différé : lors d'un changement d'arme, la nouvelle arme arrive dans la même frame (pas de clignotement du HUD)
	task.defer(function()
		if currentTool == nil then
			ClientState.Set("Tool", nil)
			ClientState.Set("Weapon", nil)
		end
	end)
end

--------------------------------------------------------------------------
-- Personnage (réassocié à chaque apparition)
--------------------------------------------------------------------------
local function unbindCharacter()
	clearConnections(characterConnections)
	if reloading then
		cancelReload()
	end
	local hadTool = currentTool ~= nil
	unbindTool()
	if hadTool then
		ClientState.Set("Tool", nil)
		ClientState.Set("Weapon", nil)
	end
	updateScopeHide(false)
	character = nil
	humanoid = nil
	rootPart = nil
	head = nil
	dashAttachment = nil
	shotParams = nil
end

local function bindCharacter(newCharacter: Model)
	unbindCharacter()
	character = newCharacter
	resetInputs()
	cancelTargeting()
	bloom = 0

	task.spawn(function()
		local hum = newCharacter:WaitForChild("Humanoid", 10)
		if character ~= newCharacter or not hum or not hum:IsA("Humanoid") then
			return
		end
		local root = newCharacter:WaitForChild("HumanoidRootPart", 10)
		if character ~= newCharacter or not root or not root:IsA("BasePart") then
			return
		end
		local headPart = newCharacter:WaitForChild("Head", 5)
		if character ~= newCharacter then
			return
		end

		humanoid = hum
		rootPart = root
		head = if headPart and headPart:IsA("BasePart") then headPart else nil
		shotParams = nil

		table.insert(characterConnections, newCharacter.ChildAdded:Connect(onToolEquipped))
		table.insert(characterConnections, newCharacter.ChildRemoved:Connect(onCharacterChildRemoved))
		table.insert(
			characterConnections,
			hum.Died:Connect(function()
				if humanoid ~= hum then
					return
				end
				resetInputs()
				cancelTargeting()
				cancelReload()
				setAds(false)
				setSprinting(false, os.clock())
				updateScopeHide(false)
			end)
		)

		-- arme déjà en main (équipée par le serveur avant que l'on soit prêt)
		local equipped = newCharacter:FindFirstChildOfClass("Tool")
		if equipped then
			onToolEquipped(equipped)
		end
	end)
end

--------------------------------------------------------------------------
-- Entrées (ContextActionService : clavier/souris, manette, boutons tactiles)
--------------------------------------------------------------------------
-- Gestionnaires d'actions (dans une table : limite de 200 variables locales)
local InputHandlers = {}

local function isPress(state: Enum.UserInputState): boolean
	return state == Enum.UserInputState.Begin
end

local function isRelease(state: Enum.UserInputState): boolean
	return state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
end

local function isTouch(input: InputObject?): boolean
	return input ~= nil and input.UserInputType == Enum.UserInputType.Touch
end

function InputHandlers.Fire(_, state: Enum.UserInputState, _input: InputObject)
	if isRelease(state) then
		triggerHeld = false
		return PASS
	end
	if not isPress(state) or not canAct() then
		return PASS
	end
	if ClientState.Targeting == "Orbital" then
		confirmTargeting()
		return SINK
	end
	triggerHeld = true
	fireQueuedAt = os.clock()
	sprintToggled = false
	if currentWeapon and ammo <= 0 and not reloading then
		emptyClick()
		startReload(false)
	end
	return SINK
end

function InputHandlers.Aim(_, state: Enum.UserInputState, input: InputObject)
	local touch = isTouch(input)
	if isRelease(state) then
		if not touch then
			wantAds = false
		end
		return PASS
	end
	if not isPress(state) or not canAct() then
		return PASS
	end
	if ClientState.Targeting ~= nil then
		cancelTargeting()
		return SINK
	end
	if touch then
		wantAds = not wantAds -- bascule sur tactile
	else
		wantAds = true -- maintien souris / manette
	end
	if wantAds then
		sprintToggled = false
	end
	return SINK
end

function InputHandlers.Reload(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	if ClientState.Targeting == nil then
		startReload(false)
	end
	return SINK
end

function InputHandlers.Primary(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	switchTo("Primary")
	return SINK
end

function InputHandlers.Secondary(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	switchTo("Secondary")
	return SINK
end

function InputHandlers.Switch(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	toggleWeapon()
	return SINK
end

function InputHandlers.Sprint(_, state: Enum.UserInputState, input: InputObject)
	if input and input.KeyCode == Enum.KeyCode.LeftShift then
		-- Maj : maintien. On absorbe la touche pour que le « verrouillage Maj » de Roblox
		-- (priorité plus basse) ne s'active pas en plus de notre caméra épaule.
		if isPress(state) then
			sprintHeld = true
		elseif isRelease(state) then
			sprintHeld = false
		end
		return SINK
	end
	-- L3 / bouton tactile : bascule
	if not isPress(state) or not canAct() then
		return PASS
	end
	sprintToggled = not sprintToggled
	stillTime = 0
	if sprintToggled and isTouch(input) then
		wantAds = false
	end
	return SINK
end

function InputHandlers.Dash(_, state: Enum.UserInputState, input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	if ClientState.Targeting ~= nil and input and input.KeyCode == Enum.KeyCode.ButtonB then
		cancelTargeting() -- B annule le ciblage à la manette
		return SINK
	end
	tryDash()
	return SINK
end

function InputHandlers.Radar(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	useRadar()
	return SINK
end

function InputHandlers.Orbital(_, state: Enum.UserInputState, _input: InputObject)
	if not isPress(state) or not canAct() then
		return PASS
	end
	if ClientState.Targeting == "Orbital" then
		cancelTargeting()
	else
		startTargeting()
	end
	return SINK
end

local ACTIONS = {
	{
		Name = "Fire",
		Title = "🔫",
		Touch = true,
		Handler = InputHandlers.Fire,
		Inputs = { Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2 },
	},
	{
		Name = "Aim",
		Title = "🎯",
		Touch = true,
		Handler = InputHandlers.Aim,
		Inputs = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2 },
	},
	{ Name = "Reload", Title = "↻", Touch = true, Handler = InputHandlers.Reload, Inputs = { Enum.KeyCode.R, Enum.KeyCode.ButtonX } },
	{ Name = "Primary", Handler = InputHandlers.Primary, Inputs = { Enum.KeyCode.One } },
	{ Name = "Secondary", Handler = InputHandlers.Secondary, Inputs = { Enum.KeyCode.Two } },
	{ Name = "Switch", Title = "⇄", Touch = true, Handler = InputHandlers.Switch, Inputs = { Enum.KeyCode.ButtonY } },
	{
		Name = "Sprint",
		Title = "🏃",
		Touch = true,
		Handler = InputHandlers.Sprint,
		Inputs = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 },
	},
	{ Name = "Dash", Title = "💨", Touch = true, Handler = InputHandlers.Dash, Inputs = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB } },
}

-- Récompenses : touches toujours actives, bouton tactile seulement si la récompense est disponible.
local REWARD_ACTIONS = {
	{ Name = "Radar", RewardId = "Radar", Title = "📡", Handler = InputHandlers.Radar, Inputs = { Tune.RADAR_KEY, Enum.KeyCode.DPadLeft } },
	{
		Name = "Orbital",
		RewardId = "Orbital",
		Title = "🛰️",
		Handler = InputHandlers.Orbital,
		Inputs = { Tune.ORBITAL_KEY, Enum.KeyCode.DPadRight },
	},
}

-- Disposition tactile : décalage (px, petit écran) depuis le centre du bouton de saut par défaut,
-- en éventail au-dessus / à gauche de celui-ci (le bas droit est laissé libre par le HUD).
local TOUCH_LAYOUT = {
	Fire = { X = -100, Y = -10, Size = 80, Tint = Tune.TINT_FIRE },
	Aim = { X = -95, Y = -100, Size = 56 },
	Reload = { X = 0, Y = -92, Size = 52 },
	Switch = { X = 0, Y = -162, Size = 52 },
	Dash = { X = -182, Y = -78, Size = 56 },
	Sprint = { X = -190, Y = 6, Size = 52 },
	Radar = { X = -95, Y = -176, Size = 52, Tint = Tune.TINT_REWARD },
	Orbital = { X = -172, Y = -160, Size = 52, Tint = Tune.TINT_REWARD },
}

local AIM_ACTION = Tune.ACTION_PREFIX .. "Aim"
local SPRINT_ACTION = Tune.ACTION_PREFIX .. "Sprint"

-- Centre du bouton de saut (et facteur d'échelle) dans l'espace des AbsolutePosition.
local function getJumpAnchor(): (Vector2?, number)
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local touchGui = playerGui and playerGui:FindFirstChild("TouchGui")
	local jump = touchGui and touchGui:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") and jump.AbsoluteSize.X > 1 then
		local size = jump.AbsoluteSize
		return jump.AbsolutePosition + size / 2, math.clamp(size.X / 70, 1, 1.5)
	end
	-- repli : formule du module de contrôle tactile par défaut
	local cam = camera
	if not cam then
		return nil, 1
	end
	local inset = GuiService:GetGuiInset()
	local screen = cam.ViewportSize - Vector2.new(0, inset.Y)
	if math.min(screen.X, screen.Y) <= 500 then
		return Vector2.new(screen.X - 60, screen.Y - 55), 1
	end
	return Vector2.new(screen.X - 110, screen.Y - 150), 1.5
end

local function isTouchBound(spec): boolean
	if not bound then
		return false
	end
	if spec.RewardId then
		return rewardTouch[spec.RewardId] == true
	end
	return spec.Touch == true and UserInputService.TouchEnabled
end

local function styleTouchButton(button: GuiObject, spec, layout)
	local title = button:FindFirstChild("ActionTitle")
	if title and title:IsA("TextLabel") then
		title.TextScaled = true
		title.AnchorPoint = Vector2.zero
		title.Size = UDim2.fromScale(0.62, 0.62)
		title.Position = UDim2.fromScale(0.19, 0.19)
	end
	local name = Tune.ACTION_PREFIX .. spec.Name
	touchButtons[name] = button
	touchTint[name] = nil
	if button:IsA("ImageButton") then
		button.ImageColor3 = layout.Tint or Tune.TINT_DEFAULT
		touchTint[name] = layout.Tint or Tune.TINT_DEFAULT
	end
end

local function layoutPass()
	local anchor, unit = getJumpAnchor()
	if not anchor then
		return
	end
	local function place(spec)
		local layout = TOUCH_LAYOUT[spec.Name]
		if not layout or not isTouchBound(spec) then
			return
		end
		local name = Tune.ACTION_PREFIX .. spec.Name
		local ok, button = pcall(function()
			return ContextActionService:GetButton(name)
		end)
		if not ok or typeof(button) ~= "Instance" or not button:IsA("GuiObject") then
			return
		end
		local parent = button.Parent
		if not parent or not parent:IsA("GuiBase2d") then
			return
		end
		local size = math.floor(layout.Size * unit + 0.5)
		local center = anchor + Vector2.new(layout.X, layout.Y) * unit
		local topLeft = center - Vector2.new(size, size) / 2 - parent.AbsolutePosition
		button.AnchorPoint = Vector2.zero
		button.Size = UDim2.fromOffset(size, size)
		ContextActionService:SetPosition(name, UDim2.fromOffset(math.floor(topLeft.X), math.floor(topLeft.Y)))
		styleTouchButton(button, spec, layout)
	end
	for _, spec in ACTIONS do
		place(spec)
	end
	for _, spec in REWARD_ACTIONS do
		place(spec)
	end
end

-- Placement des boutons tactiles (différé : les boutons sont créés par les scripts du cœur Roblox).
local function layoutTouchButtons()
	if not UserInputService.TouchEnabled or not bound then
		return
	end
	layoutToken += 1
	local token = layoutToken
	task.spawn(function()
		task.wait()
		if token ~= layoutToken or not bound then
			return
		end
		layoutPass()
		-- seconde passe : le bouton de saut peut apparaître un peu après le personnage
		task.wait(1)
		if token ~= layoutToken or not bound then
			return
		end
		layoutPass()
	end)
end

local function setTouchTint(name: string, color: Color3)
	if touchTint[name] == color then
		return
	end
	local button = touchButtons[name]
	if not button or not button.Parent or not button:IsA("ImageButton") then
		return
	end
	touchTint[name] = color
	button.ImageColor3 = color
end

local function bindAction(spec, withTouch: boolean)
	local name = Tune.ACTION_PREFIX .. spec.Name
	ContextActionService:UnbindAction(name)
	touchButtons[name] = nil
	touchTint[name] = nil
	ContextActionService:BindActionAtPriority(name, spec.Handler, withTouch, Tune.ACTION_PRIORITY, table.unpack(spec.Inputs))
	if withTouch and spec.Title then
		ContextActionService:SetTitle(name, spec.Title)
	end
end

-- Lie les actions en partie (et sans panneau ouvert), les délie sinon (les boutons tactiles disparaissent).
local function refreshBindings()
	local shouldBind = playingApplied and ClientState.Mode == "Playing" and not ClientState.UiOpen
	if shouldBind then
		local changed = false
		if not bound then
			bound = true
			changed = true
			table.clear(rewardTouch)
			for _, spec in ACTIONS do
				bindAction(spec, spec.Touch == true and UserInputService.TouchEnabled)
			end
		end
		for _, spec in REWARD_ACTIONS do
			local showTouch = UserInputService.TouchEnabled and rewardAvailable(spec.RewardId)
			if rewardTouch[spec.RewardId] ~= showTouch then
				rewardTouch[spec.RewardId] = showTouch
				bindAction(spec, showTouch)
				changed = true
			end
		end
		if changed then
			layoutTouchButtons()
		end
	elseif bound then
		bound = false
		layoutToken += 1
		for _, spec in ACTIONS do
			ContextActionService:UnbindAction(Tune.ACTION_PREFIX .. spec.Name)
		end
		for _, spec in REWARD_ACTIONS do
			ContextActionService:UnbindAction(Tune.ACTION_PREFIX .. spec.Name)
		end
		table.clear(rewardTouch)
		table.clear(touchButtons)
		table.clear(touchTint)
		resetInputs()
	end
end

--------------------------------------------------------------------------
-- Caméra : entrée / sortie du mode Playing
--------------------------------------------------------------------------
local function updateMouse(lock: boolean)
	if lock then
		-- les scripts caméra par défaut réinitialisent MouseBehavior : on le réimpose à chaque frame
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = false -- le HUD dessine le réticule
		end
		mouseLocked = true
	elseif mouseLocked then
		mouseLocked = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

local function setZoom(minZoom: number, maxZoom: number)
	-- l'ordre évite que le moteur ne corrige Min > Max entre les deux affectations
	if maxZoom >= LocalPlayer.CameraMinZoomDistance then
		LocalPlayer.CameraMaxZoomDistance = maxZoom
		LocalPlayer.CameraMinZoomDistance = minZoom
	else
		LocalPlayer.CameraMinZoomDistance = minZoom
		LocalPlayer.CameraMaxZoomDistance = maxZoom
	end
end

local function resetCameraEffects()
	recoilTargetPitch, recoilTargetYaw = 0, 0
	recoilPitch, recoilYaw = 0, 0
	shakeTrauma, shakeTime = 0, 0
	shakePitch, shakeYaw = 0, 0
	fovPunch, dashFovKick, rollPunch = 0, 0, 0
	adsAlpha, sprintAlpha = 0, 0
	bloom, moveMult, shoulderScale = 0, 1, 1
end

local function enterPlaying()
	local newHumanoid = humanoid
	local isNewLife = newHumanoid ~= nil and newHumanoid ~= appliedHumanoid
	playingApplied = true
	appliedHumanoid = newHumanoid
	resetCameraEffects()
	lastPitchSent = math.huge

	local cam = camera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		if newHumanoid and cam.CameraSubject ~= newHumanoid then
			cam.CameraSubject = newHumanoid
		end
		-- nouvelle vie : caméra replacée derrière le personnage (orientation du point d'apparition)
		local root = rootPart
		if isNewLife and root then
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 1e-3 then
				flat = flat.Unit
				local focus = root.Position + Vector3.new(0, 1.5, 0)
				cam.CFrame = CFrame.lookAt(focus - flat * Tune.CAMERA_DISTANCE + Vector3.new(0, 1.5, 0), focus + flat * 20)
			end
		end
		cam.FieldOfView = getBaseFov()
	end
	setZoom(Tune.CAMERA_DISTANCE, Tune.CAMERA_DISTANCE)
	if newHumanoid then
		newHumanoid.AutoRotate = false
	end
	refreshBindings()
end

local function leavePlaying()
	playingApplied = false
	appliedHumanoid = nil
	resetInputs()
	cancelTargeting()
	cancelReload()
	setAds(false)
	setSprinting(false, os.clock())
	updateScopeHide(false)

	local hum = humanoid
	if hum and hum.Parent then
		hum.CameraOffset = Vector3.zero
		hum.AutoRotate = true
	end
	updateMouse(false)
	UserInputService.MouseDeltaSensitivity = 1
	if savedMinZoom and savedMaxZoom then
		setZoom(savedMinZoom, savedMaxZoom)
	end
	-- on ne touche au FOV que si personne n'a déjà pris la caméra (killcam, menu)
	local cam = camera
	if cam and cam.CameraType == Enum.CameraType.Custom then
		cam.FieldOfView = getBaseFov()
	end
	resetCameraEffects()
	lastPitchSent = math.huge
	refreshBindings()
end

--------------------------------------------------------------------------
-- Boucle de rendu (RenderPriority.Camera + 1 : juste après la caméra par défaut)
--------------------------------------------------------------------------

-- Recul + tremblements appliqués en rotations incrémentales (la caméra Classic repart de camera.CFrame).
local function applyCameraMotion(cam: Camera, dt: number, now: number, weapon)
	-- recul : la cible revient vers 0 (plus lentement pendant une rafale), la caméra la suit vite
	local recovery = 6
	if weapon and type(weapon.Recoil) == "table" then
		recovery = weapon.Recoil.Recovery or recovery
	end
	if weapon and now - lastShotAt < weapon.FireDelay + Tune.SPREAD_RECOVERY_DELAY then
		recovery *= Tune.FIRING_RECOVERY_SCALE
	end
	local decay = math.exp(-recovery * dt)
	recoilTargetPitch *= decay
	recoilTargetYaw *= decay
	local follow = 1 - math.exp(-Tune.KICK_SPEED * dt)
	local newPitch = recoilPitch + (recoilTargetPitch - recoilPitch) * follow
	local newYaw = recoilYaw + (recoilTargetYaw - recoilYaw) * follow
	local deltaPitch = newPitch - recoilPitch
	local deltaYaw = newYaw - recoilYaw
	recoilPitch, recoilYaw = newPitch, newYaw

	-- tremblements : bruit de Perlin pondéré par trauma²
	local roll = 0
	if shakeTrauma > 0 or shakePitch ~= 0 or shakeYaw ~= 0 then
		shakeTrauma = math.max(0, shakeTrauma - Tune.SHAKE_DECAY * dt)
		shakeTime += dt
		local amount = shakeTrauma * shakeTrauma
		local n = shakeTime * Tune.SHAKE_FREQUENCY
		local pitchShake = Tune.SHAKE_MAX_ANGLE * amount * math.clamp(math.noise(n, 3.7) * 2, -1, 1)
		local yawShake = Tune.SHAKE_MAX_ANGLE * amount * math.clamp(math.noise(n, 11.3) * 2, -1, 1)
		roll = Tune.SHAKE_MAX_ROLL * amount * math.clamp(math.noise(n, 19.9) * 2, -1, 1)
		deltaPitch += pitchShake - shakePitch
		deltaYaw += yawShake - shakeYaw
		shakePitch, shakeYaw = pitchShake, yawShake
	end
	rollPunch *= math.exp(-Tune.ROLL_PUNCH_DECAY * dt)
	roll += rollPunch

	if math.abs(deltaPitch) < 1e-6 and math.abs(deltaYaw) < 1e-6 and math.abs(roll) < 1e-5 then
		return
	end
	if cam.CameraType ~= Enum.CameraType.Custom then
		return
	end
	local frame = cam.CFrame
	local pitchNow = math.asin(math.clamp(frame.LookVector.Y, -1, 1))
	local pitchTarget = math.clamp(pitchNow + deltaPitch, -Tune.MAX_CAMERA_PITCH, Tune.MAX_CAMERA_PITCH)
	deltaPitch = pitchTarget - pitchNow
	-- lacet autour de l'axe vertical du monde, tangage et roulis en local (le roulis n'est pas conservé
	-- par la caméra par défaut, qui reconstruit un CFrame sans roulis à chaque frame)
	cam.CFrame = CFrame.new(frame.Position)
		* CFrame.Angles(0, deltaYaw, 0)
		* frame.Rotation
		* CFrame.Angles(deltaPitch, 0, roll)
end

-- Le personnage regarde dans la direction de la caméra.
local function faceCamera(cam: Camera, hum: Humanoid, root: BasePart)
	local skip = hum.Sit or hum.PlatformStand or NO_FACE_STATES[hum:GetState()] == true
	if hum.AutoRotate ~= skip then
		hum.AutoRotate = skip -- rendu au moteur pendant l'escalade / assis
	end
	if skip then
		return
	end
	local look = cam.CFrame.LookVector
	if math.abs(look.Y) > 0.995 then
		return
	end
	local yaw = math.atan2(-look.X, -look.Z)
	local rootLook = root.CFrame.LookVector
	local currentYaw = math.atan2(-rootLook.X, -rootLook.Z)
	local diff = (yaw - currentYaw + math.pi) % (2 * math.pi) - math.pi
	if math.abs(diff) < 1e-3 and math.abs(rootLook.Y) < 1e-3 then
		return
	end
	root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
end

local function onRenderStep(dt: number)
	if dt > 0.1 then
		dt = 0.1
	end
	if ClientState.Mode ~= "Playing" then
		if playingApplied then
			leavePlaying()
		end
		return
	end
	if not playingApplied or appliedHumanoid ~= humanoid then
		enterPlaying()
	end

	local now = os.clock()
	local uiOpen = ClientState.UiOpen == true or GuiService.MenuIsOpen
	updateMouse(not uiOpen and UserInputService.MouseEnabled)

	local cam, hum, root = camera, humanoid, rootPart
	if not cam or not hum or not root or not isAlive() then
		return
	end
	-- en partie, la caméra nous appartient (ARCHITECTURE.md) : on la reprend si un autre module l'a laissée
	if not uiOpen then
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		if cam.CameraSubject ~= hum then
			cam.CameraSubject = hum
		end
	end
	local weapon = currentWeapon
	if weapon and (not currentTool or currentTool.Parent ~= character) then
		weapon = nil
	end
	local targeting = ClientState.Targeting ~= nil

	------------------------------------------------------------------
	-- 1. Visée / sprint
	------------------------------------------------------------------
	local canAim = not uiOpen and weapon ~= nil and not targeting and not (reloading and weapon.Scope == true)
	local ads = wantAds and canAim

	local moveDirection = hum.MoveDirection
	local moving = moveDirection.Magnitude > 0.1
	local cameraLook = cam.CFrame.LookVector
	local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
	local forward = moving and flatLook.Magnitude > 1e-3 and moveDirection.Unit:Dot(flatLook.Unit) > 0.35
	if sprintToggled then
		if moving then
			stillTime = 0
		else
			stillTime += dt
			if stillTime > 0.4 then
				sprintToggled = false -- le sprint en bascule s'arrête quand on s'immobilise
			end
		end
	end
	local sprint = (sprintHeld or sprintToggled)
		and not uiOpen
		and forward
		and not ads
		and not triggerHeld
		and fireQueuedAt == nil
		and not targeting
	setAds(ads)
	setSprinting(sprint, now)

	local adsTime = if weapon then math.max(weapon.AdsTime or 0.15, 0.01) else 0.15
	if ads then
		adsAlpha = math.min(1, adsAlpha + dt / adsTime)
	else
		adsAlpha = math.max(0, adsAlpha - dt / (adsTime * 0.8))
	end
	local adsEase = smoothstep(adsAlpha)
	if sprint then
		sprintAlpha = math.min(1, sprintAlpha + dt / 0.22)
	else
		sprintAlpha = math.max(0, sprintAlpha - dt / 0.18)
	end
	local sprintEase = smoothstep(sprintAlpha)

	------------------------------------------------------------------
	-- 2. Vitesse de déplacement
	------------------------------------------------------------------
	local speedScale = if weapon then weapon.SpeedScale or 1 else 1
	local speed = (Movement.WalkSpeed + (Movement.SprintSpeed - Movement.WalkSpeed) * sprintEase) * speedScale
	speed *= 1 + (Movement.AdsSpeedScale - 1) * adsEase
	if math.abs(hum.WalkSpeed - speed) > 0.05 then
		hum.WalkSpeed = speed
	end

	------------------------------------------------------------------
	-- 3. Recul + tremblements, puis personnage tourné vers la caméra
	------------------------------------------------------------------
	applyCameraMotion(cam, dt, now, weapon)
	faceCamera(cam, hum, root)

	------------------------------------------------------------------
	-- 4. Épaule (CameraOffset) avec anti-collision à droite
	------------------------------------------------------------------
	local offset = CameraConfig.ShoulderOffset:Lerp(CameraConfig.AdsShoulderOffset, adsEase)
	local allowed = 1
	if offset.X > 0.05 then
		local probeFrom = if head and head.Parent then head.Position else root.Position
		local hit = workspace:Raycast(probeFrom, cam.CFrame.RightVector * (offset.X + Tune.SHOULDER_MARGIN), getShotParams())
		if hit then
			allowed = math.clamp((hit.Distance - Tune.SHOULDER_MARGIN) / offset.X, 0, 1)
		end
	end
	local shoulderRate = if allowed < shoulderScale then 25 else 7
	shoulderScale += (allowed - shoulderScale) * (1 - math.exp(-shoulderRate * dt))
	local cameraOffset = Vector3.new(offset.X * shoulderScale, offset.Y, offset.Z)
	if (hum.CameraOffset - cameraOffset).Magnitude > 1e-3 then
		hum.CameraOffset = cameraOffset
	end

	------------------------------------------------------------------
	-- 5. Champ de vision + sensibilité
	------------------------------------------------------------------
	local baseFov = getBaseFov()
	local adsFov = if weapon then getAdsFov(weapon, baseFov) else baseFov
	local hipFov = baseFov + (CameraConfig.SprintFovBonus or 0) * sprintEase
	fovPunch *= math.exp(-Tune.FOV_PUNCH_DECAY * dt)
	dashFovKick *= math.exp(-Tune.DASH_FOV_DECAY * dt)
	local fov = math.clamp(hipFov + (adsFov - hipFov) * adsEase + fovPunch + dashFovKick, 5, 120)
	if math.abs(cam.FieldOfView - fov) > 1e-3 then
		cam.FieldOfView = fov
	end

	local sensitivity = math.clamp(tonumber(setting("Sensitivity")) or 1, 0.05, 5)
	local adsSensitivity = math.clamp(tonumber(setting("AdsSensitivity")) or 0.6, 0.05, 3)
	local multiplier = 1 + (adsSensitivity - 1) * adsEase
	if weapon and weapon.Scope then
		multiplier *= 1 + (adsFov / baseFov - 1) * adsEase -- lunette : vitesse proportionnelle au zoom
	end
	local mouseSensitivity = sensitivity * multiplier
	if math.abs(UserInputService.MouseDeltaSensitivity - mouseSensitivity) > 1e-4 then
		UserInputService.MouseDeltaSensitivity = mouseSensitivity
	end

	updateScopeHide(weapon ~= nil and weapon.Scope == true and adsEase > 0.65)

	------------------------------------------------------------------
	-- 6. Dispersion (degrés) : visée, bloom, déplacement rapide x1,5, en l'air x2
	------------------------------------------------------------------
	if weapon then
		if now - lastShotAt > weapon.FireDelay + Tune.SPREAD_RECOVERY_DELAY then
			bloom = math.max(0, bloom - (weapon.SpreadRecovery or 10) * dt)
		end
		local velocity = root.AssemblyLinearVelocity
		local horizontalSpeed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
		local targetMult = 1
		if hum.FloorMaterial == Enum.Material.Air then
			targetMult = 2
		elseif horizontalSpeed > Tune.MOVE_FAST_SPEED then
			targetMult = 1.5
		end
		moveMult += (targetMult - moveMult) * (1 - math.exp(-12 * dt))
		local base = weapon.HipSpread + (weapon.AdsSpread - weapon.HipSpread) * adsEase
		local total = math.min(base + bloom, math.max(weapon.MaxSpread or base, base))
		currentSpread = total * moveMult
	else
		bloom = 0
		currentSpread = 0
	end
	publishSpread(currentSpread)

	------------------------------------------------------------------
	-- 7. Tir
	------------------------------------------------------------------
	if weapon and not uiOpen and not targeting then
		local wantsShot = fireQueuedAt ~= nil and now - fireQueuedAt <= Tune.SEMI_BUFFER
		if fireQueuedAt and not wantsShot then
			fireQueuedAt = nil
		end
		if weapon.Automatic and triggerHeld then
			wantsShot = true
		end
		if wantsShot and tryFire(now, weapon) then
			fireQueuedAt = nil
		end
	end

	------------------------------------------------------------------
	-- 8. Rechargement : fin (confirmée par le serveur), rechargement auto, resynchronisation
	------------------------------------------------------------------
	if reloading then
		local serverReloading = currentTool ~= nil and currentTool:GetAttribute("Reloading") == true
		if serverReloading then
			reloadSeenOnServer = true
		end
		if now >= reloadEndsAt then
			if not serverReloading and (reloadSeenOnServer or now >= reloadEndsAt + Tune.RELOAD_GRACE_UNSEEN) then
				finishReload()
			elseif now >= reloadEndsAt + Tune.RELOAD_GRACE_SEEN then
				finishReload()
			end
		end
	end
	if autoReloadAt and now >= autoReloadAt then
		autoReloadAt = nil
		if weapon and ammo <= 0 and not reloading then
			startReload(false)
		end
	end
	if not reloading and currentTool and now - lastAmmoSyncAt > Tune.AMMO_SYNC_INTERVAL then
		lastAmmoSyncAt = now
		if now - lastShotAt > Tune.AMMO_SYNC_IDLE then
			local serverAmmo = readAmmo(currentTool)
			if serverAmmo ~= ammo then
				ammo = serverAmmo
				ClientState.Set("Ammo", ammo)
			end
		end
	end

	------------------------------------------------------------------
	-- 9. Inclinaison de visée (pour le buste des autres joueurs)
	------------------------------------------------------------------
	if now - lastPitchSentAt >= Tune.PITCH_INTERVAL then
		local pitch = math.clamp(math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1)), -Tune.PITCH_LIMIT, Tune.PITCH_LIMIT)
		pitch = math.floor(pitch * 100 + 0.5) / 100
		if pitch ~= lastPitchSent then
			lastPitchSent = pitch
			lastPitchSentAt = now
			Remotes.AimPitch:FireServer(pitch)
		end
	end

	------------------------------------------------------------------
	-- 10. Ciblage orbital + teinte des boutons tactiles en bascule
	------------------------------------------------------------------
	if ClientState.Targeting == "Orbital" then
		updateMarker(cam, now)
	elseif marker then
		destroyMarker()
	end
	if bound then
		setTouchTint(AIM_ACTION, if wantAds then Tune.TINT_ACTIVE else Tune.TINT_DEFAULT)
		setTouchTint(SPRINT_ACTION, if sprintToggled then Tune.TINT_SPRINT else Tune.TINT_DEFAULT)
	end
end

--------------------------------------------------------------------------
-- Initialisation
--------------------------------------------------------------------------
local function watchViewport()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
	local cam = camera
	if cam then
		viewportConnection = cam:GetPropertyChangedSignal("ViewportSize"):Connect(layoutTouchButtons)
	end
end

local function onCameraShake(intensity: any)
	if type(intensity) ~= "number" or intensity ~= intensity or setting("CameraShake") == false then
		return
	end
	shakeTrauma = math.min(1, shakeTrauma + math.clamp(intensity, 0, 1))
end

local initialized = false

function GunController.Init()
	if initialized then
		return
	end
	initialized = true

	savedMinZoom = LocalPlayer.CameraMinZoomDistance
	savedMaxZoom = LocalPlayer.CameraMaxZoomDistance

	-- Caméra « Classic » imposée et verrouillage Maj de Roblox désactivé : la caméra épaule est gérée ici.
	-- (protégé : si une de ces propriétés n'est pas modifiable côté client, on continue sans)
	pcall(function()
		LocalPlayer.DevEnableMouseLock = false
	end)
	pcall(function()
		LocalPlayer.DevComputerCameraMode = Enum.DevComputerCameraMovementMode.Classic
	end)
	pcall(function()
		LocalPlayer.DevTouchCameraMode = Enum.DevTouchCameraMovementMode.Classic
	end)

	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = workspace.CurrentCamera
		watchViewport()
	end)
	watchViewport()

	LocalPlayer.CharacterAdded:Connect(bindCharacter)
	LocalPlayer.CharacterRemoving:Connect(function(oldCharacter)
		if oldCharacter == character then
			unbindCharacter()
		end
	end)
	if LocalPlayer.Character then
		bindCharacter(LocalPlayer.Character)
	end

	ClientState.On("Changed:Mode", function(mode)
		if mode ~= "Playing" and playingApplied then
			leavePlaying()
		end
	end)
	ClientState.On("Changed:UiOpen", function(open)
		if open then
			resetInputs()
			cancelTargeting()
		end
		refreshBindings()
	end)
	ClientState.On("Changed:Rewards", function(rewards)
		local targeting = ClientState.Targeting
		if targeting and (type(rewards) ~= "table" or rewards[targeting] ~= true) then
			cancelTargeting()
		end
		refreshBindings()
	end)
	ClientState.On("CameraShake", onCameraShake)

	-- molette : arme suivante / précédente (2 armes => bascule)
	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end
		if bound and canAct() and ClientState.Targeting == nil then
			toggleWeapon()
		end
	end)
	-- Échap annule le ciblage (le menu Roblox peut aussi l'intercepter : voir MenuOpened)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and ClientState.Targeting ~= nil then
			cancelTargeting()
		end
	end)
	UserInputService.WindowFocusReleased:Connect(resetInputs)
	GuiService.MenuOpened:Connect(function()
		resetInputs()
		cancelTargeting()
	end)

	RunService:BindToRenderStep(Tune.RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)
end

return GunController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[-- Lecture de sons côté client. Ignore silencieusement les ids vides (Config.Sounds non rempli).
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Sfx = {}

local function valid(id: string?): boolean
	return type(id) == "string" and id ~= ""
end

-- Son « interface » (non spatialisé).
function Sfx.Play2D(id: string?, volume: number?, pitch: number?)
	if not valid(id) then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 6)
	return sound
end

-- Son 3D : at = BasePart, Attachment ou position Vector3.
-- variation = écart aléatoire de hauteur (ex. 0.05 => pitch entre 0.95 et 1.05).
function Sfx.PlayAt(id: string?, at: Instance | Vector3, volume: number?, variation: number?, maxDistance: number?)
	if not valid(id) then
		return nil
	end
	local parent: Instance
	if typeof(at) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = at
		attachment.Parent = workspace.Terrain
		Debris:AddItem(attachment, 6)
		parent = attachment
	else
		parent = at
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.6
	local spread = variation or 0
	sound.PlaybackSpeed = 1 + (math.random() * 2 - 1) * spread
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = maxDistance or 400
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, 6)
	return sound
end

return Sfx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[-- Helpers pour construire une interface propre et homogène en code.
-- Style : panneaux sombres translucides (« verre »), accents cyan / magenta, titres Oswald, texte Gotham.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Ui = {}

Ui.Colors = {
	Background = Color3.fromRGB(10, 12, 18),
	Panel = Color3.fromRGB(20, 23, 32),
	PanelLight = Color3.fromRGB(34, 38, 52),
	Text = Color3.fromRGB(245, 246, 250),
	Muted = Color3.fromRGB(150, 156, 176),
	Accent = Config.Colors.Accent,
	Accent2 = Config.Colors.Accent2,
	Gold = Config.Colors.Gold,
	Good = Config.Colors.Good,
	Bad = Config.Colors.Bad,
}

local GOTHAM = "rbxasset://fonts/families/GothamSSm.json"
local OSWALD = "rbxasset://fonts/families/Oswald.json"

Ui.Fonts = {
	Title = Font.new(OSWALD, Enum.FontWeight.Bold), -- gros titres, chiffres de munitions
	Heading = Font.new(OSWALD, Enum.FontWeight.Medium),
	Body = Font.new(GOTHAM, Enum.FontWeight.Medium),
	Bold = Font.new(GOTHAM, Enum.FontWeight.Bold),
	Heavy = Font.new(GOTHAM, Enum.FontWeight.Heavy),
}

-- Crée une instance : Ui.new("Frame", { Size = ..., Parent = ... }, { enfants })
function Ui.new(className: string, props, children)
	local instance = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number?)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Ui.stroke(color: Color3?, thickness: number?, transparency: number?)
	return Ui.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.padding(px: number, horizontal: number?)
	local v = UDim.new(0, px)
	local h = UDim.new(0, horizontal or px)
	return Ui.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h })
end

function Ui.gradient(a: Color3, b: Color3, rotation: number?)
	return Ui.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 0 })
end

function Ui.list(direction: Enum.FillDirection?, padding: number?, props)
	local layout = Ui.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	for key, value in props or {} do
		layout[key] = value
	end
	return layout
end

-- Panneau « verre » standard.
function Ui.panel(props, children)
	local defaults = {
		BackgroundColor3 = Ui.Colors.Background,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local frame = Ui.new("Frame", defaults, children)
	if not frame:FindFirstChildOfClass("UICorner") then
		Ui.corner(12).Parent = frame
	end
	if not frame:FindFirstChildOfClass("UIStroke") then
		Ui.stroke(Color3.new(1, 1, 1), 1, 0.88).Parent = frame
	end
	return frame
end

function Ui.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Ui.Fonts.Bold,
		TextColor3 = Ui.Colors.Text,
		TextScaled = true,
		BorderSizePixel = 0,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return Ui.new("TextLabel", defaults, children)
end

function Ui.tween(instance: Instance, time: number, goal, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

-- Bouton avec effet de survol / clic. color = couleur de fond.
function Ui.button(props, color: Color3?)
	local button = Ui.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color or Ui.Colors.PanelLight,
		FontFace = Ui.Fonts.Title,
		TextColor3 = Ui.Colors.Text,
		TextScaled = true,
		BorderSizePixel = 0,
	}, { Ui.corner(10), Ui.padding(6, 10) })
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			button[key] = value
		end
	end
	local scale = Ui.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		Ui.tween(scale, 0.15, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		Ui.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Ui.tween(scale, 0.08, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		Ui.tween(scale, 0.12, { Scale = 1.04 })
	end)
	if parent then
		button.Parent = parent
	end
	return button
end

function Ui.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (formatted:gsub("^ ", ""))
end

function Ui.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="33">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- APERÇU : point d'entrée client temporaire (sans menu). Apparition automatique.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local Controllers = script.Parent:WaitForChild("Controllers")
local ClientState = require(Controllers.ClientState)

local player = Players.LocalPlayer

task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local function safeInit(name: string, ...)
	local module = Controllers:FindFirstChild(name)
	if not module then
		return false
	end
	local ok, err = pcall(function(...)
		require(module).Init(...)
	end, ...)
	if not ok then
		warn("[Aperçu] " .. name .. " : " .. tostring(err))
	end
	return ok
end

safeInit("EffectsController")
safeInit("GunController")
local hudOk = safeInit("HudController")

-- Viseur de secours si le HUD n'est pas encore prêt
if not hudOk then
	local gui = Instance.new("ScreenGui")
	gui.Name = "FallbackCrosshair"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(6, 6)
	dot.BackgroundColor3 = Color3.new(1, 1, 1)
	dot.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot
	gui.Parent = player:WaitForChild("PlayerGui")
end

local function onData(data)
	if data then
		ClientState.Set("Data", data)
		if data.Settings then
			ClientState.Set("Settings", data.Settings)
		end
	end
end
Remotes.DataChanged.OnClientEvent:Connect(onData)
Remotes.RewardsChanged.OnClientEvent:Connect(function(available, streak)
	ClientState.Set("Rewards", available or {})
	ClientState.Set("Streak", streak or 0)
end)

local function onCharacter(character: Model)
	ClientState.Set("Mode", "Playing")
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.Died:Connect(function()
		ClientState.Set("Mode", "Dead")
	end)
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

task.spawn(function()
	onData(Remotes.GetData:InvokeServer())
	task.wait(1)
	Remotes.Deploy:FireServer()
	-- Réessaie si les données n'étaient pas encore chargées
	for _ = 1, 10 do
		task.wait(2)
		if player.Character then
			break
		end
		Remotes.Deploy:FireServer()
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
